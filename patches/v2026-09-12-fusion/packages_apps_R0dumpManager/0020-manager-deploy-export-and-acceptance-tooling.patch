     return archive, checksum_path
 
 
+def pull_run(client: AdbClient, candidate: RunCandidate, destination: Path) -> None:
+    package_directory = destination.parent
+    temporary = Path(
+        tempfile.mkdtemp(prefix=f".{candidate.run_id}.partial-", dir=package_directory)
+    )
+    try:
+        pulled = temporary / candidate.run_id
+        pulled.mkdir()
+        # Pull directory contents into a local name we control. Windows adb invoked from WSL may
+        # truncate the remote basename when it creates the destination directory itself.
+        client.pull(f"{candidate.remote_path}/.", pulled)
+        if not any(pulled.glob("process-*/session.json")):
+            raise ExportError("导出的 run 缺少 process session.json")
+        if not any(pulled.glob("process-*/artifacts/*")):
+            raise ExportError("导出的 run 不包含产物")
+        pulled.rename(destination)
+    finally:
+        shutil.rmtree(temporary, ignore_errors=True)
+
+
 def export_latest(args: argparse.Namespace) -> Path:
     package = validate_package_name(args.package)
     client = AdbClient(args.adb, args.serial, args.verbose)
