+        Column(Modifier.weight(1f)) {
+            Text("${point.bit.toString().padStart(2, '0')}  ${point.name}", maxLines = 2, overflow = TextOverflow.Ellipsis)
+            Text(captureKind(point.kind), style = MaterialTheme.typography.bodySmall)
+            if (highCost) {
