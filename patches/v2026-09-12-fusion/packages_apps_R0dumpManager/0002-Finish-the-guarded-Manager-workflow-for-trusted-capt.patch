+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun ConfirmationSheet(title: String, detail: String, onConfirm: () -> Unit, onDismiss: () -> Unit) {
+    val sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true)
+    ModalBottomSheet(
