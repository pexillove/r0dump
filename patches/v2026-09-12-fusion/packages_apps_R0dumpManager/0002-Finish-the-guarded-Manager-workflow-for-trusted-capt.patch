@@ -0,0 +1,18 @@
+package com.android.r0dumpmanager.security
+
+import android.os.SystemClock
+
+sealed interface AuthenticationState {
+    data object Required : AuthenticationState
+    data class ValidUntil(val elapsedRealtime: Long) : AuthenticationState
+}
+
+/** In-memory only device-credential grant; it is lost on process death by design. */
+class MutationAuthenticator(private val clock: () -> Long = SystemClock::elapsedRealtime) {
+    private var expiry = 0L
+    fun grant() { expiry = clock() + AUTH_WINDOW_MS }
+    fun clear() { expiry = 0L }
+    fun isAuthenticated() = clock() < expiry
+    fun state(): AuthenticationState = if (isAuthenticated()) AuthenticationState.ValidUntil(expiry) else AuthenticationState.Required
+    companion object { const val AUTH_WINDOW_MS = 5 * 60 * 1000L }
+}
