+package com.android.r0dumpmanager.domain
+
+data class CapturePoint(val bit: Int, val name: String, val kind: String)
+
+object CapturePointRegistry {
+    const val pointCount = 42
+    val definedMask: ULong = (1uL shl pointCount) - 1uL
+    val undefinedMask: ULong = definedMask.inv()
+    val forceNoExecuteMask: ULong = 1uL shl 41
+    val points = listOf(
+        CapturePoint(0, "Cookie.result.dex", "DEX snapshot"), CapturePoint(1, "InMemory.buffer.copied", "raw buffer"),
+        CapturePoint(2, "InMemory.dex.parsed", "DEX snapshot"), CapturePoint(3, "OpenCommon.return", "DEX snapshot"),
+        CapturePoint(4, "DefineClassNative.match", "DEX snapshot"), CapturePoint(5, "RegisterDexFile.return", "DEX snapshot"),
+        CapturePoint(6, "DefineClass.entry", "class/Dex evidence"), CapturePoint(7, "DefineClass.success", "metadata"),
+        CapturePoint(8, "LoadMethod.ready", "CodeItem"), CapturePoint(9, "LoadClass.entry", "metadata"),
+        CapturePoint(10, "LoadClass.success", "metadata"), CapturePoint(11, "ResolveMethod.cache_hit", "method evidence"),
+        CapturePoint(12, "ResolveMethod.lookup_success", "method evidence"), CapturePoint(13, "VerifyClass.complete", "metadata"),
+        CapturePoint(14, "ClassInit.before_clinit", "CodeItem/metadata"), CapturePoint(15, "ClassInit.success", "metadata"),
+        CapturePoint(16, "OatDexFile.open.success", "DEX snapshot"), CapturePoint(17, "Vdex.load.complete", "DEX snapshot"),
+        CapturePoint(18, "OatManager.file.complete", "DEX snapshot"), CapturePoint(19, "OatManager.memory.complete", "DEX/reference"),
+        CapturePoint(20, "OatManager.register.before_lock", "metadata"), CapturePoint(21, "ImageSpace.dex.tracked", "DEX/reference"),
+        CapturePoint(22, "ArtMethod.invoke.dispatch", "method evidence"), CapturePoint(23, "Interpreter.execute.entry", "method evidence"),
+        CapturePoint(24, "Jit.method_entered", "method evidence"), CapturePoint(25, "Jit.compile.begin", "CodeItem/metadata"),
+        CapturePoint(26, "Jit.compile.end", "metadata"), CapturePoint(27, "ReflectMethod.before_invoke", "method evidence"),
+        CapturePoint(28, "ReflectCtor.before_invoke", "method evidence"), CapturePoint(29, "Instrumentation.enter", "method evidence"),
+        CapturePoint(30, "Instrumentation.exit.value", "method evidence"), CapturePoint(31, "Instrumentation.exit.object", "method evidence"),
+        CapturePoint(32, "BDCL.path.constructor", "DEX route"), CapturePoint(33, "BDCL.memory.constructor", "buffer route"),
+        CapturePoint(34, "BDCL.findClass.success", "DEX route"), CapturePoint(35, "BDCL.addDexPath.return", "DEX route"),
+        CapturePoint(36, "DexFile.open.file.return", "DEX route"), CapturePoint(37, "DexFile.open.memory.return", "buffer route"),
+        CapturePoint(38, "DexFile.before_define", "DEX route"), CapturePoint(39, "Walk.cookie.dex", "active DEX snapshot"),
+        CapturePoint(40, "Walk.executable.method", "active method evidence"), CapturePoint(41, "ForceInvoke.no_execute", "active CodeItem"),
+    )
+    init { check(points.map { it.bit } == (0 until pointCount).toList()) }
+    fun contains(mask: ULong, bit: Int) = bit in 0 until pointCount && (mask and (1uL shl bit)) != 0uL
+    fun toggle(mask: ULong, bit: Int): ULong = if (bit !in 0 until pointCount) mask else mask xor (1uL shl bit)
+}
