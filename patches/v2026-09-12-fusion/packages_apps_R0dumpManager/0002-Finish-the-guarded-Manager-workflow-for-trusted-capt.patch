+@Composable
+fun SettingsGroupHeader(
+    title: String,
+    summary: String,
+    expanded: Boolean,
+    onToggle: () -> Unit,
+) {
+    val description = stringResource(
+        if (expanded) R.string.collapse_settings_group else R.string.expand_settings_group,
+        title,
+    )
+    Surface(color = MaterialTheme.colorScheme.background) {
+        Row(
+            Modifier
+                .fillMaxWidth()
+                .heightIn(min = 56.dp)
