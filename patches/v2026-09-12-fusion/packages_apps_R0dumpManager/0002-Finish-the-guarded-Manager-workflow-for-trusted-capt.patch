+    domain/FusionConfigValidator.kt
+    domain/CapturePointRegistry.kt
+    domain/ProfileRegistry.kt
+    notification/ActiveSessionNotifier.kt
+    receiver/BootCompletedReceiver.kt
+    security/MutationAuthenticator.kt
