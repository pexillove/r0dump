@@ -0,0 +1,25 @@
+package com.android.r0dumpmanager.security
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class MutationAuthenticatorTest {
+    @Test
+    fun grantExpiresOnMonotonicDeadlineAndClearIsImmediate() {
+        var now = 1_000L
+        val authenticator = MutationAuthenticator { now }
+        assertFalse(authenticator.isAuthenticated())
+
+        authenticator.grant()
+        assertTrue(authenticator.isAuthenticated())
+        now += MutationAuthenticator.AUTH_WINDOW_MS - 1L
+        assertTrue(authenticator.isAuthenticated())
+        now += 1L
+        assertFalse(authenticator.isAuthenticated())
+
+        authenticator.grant()
+        authenticator.clear()
+        assertFalse(authenticator.isAuthenticated())
+    }
+}
