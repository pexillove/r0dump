+package com.android.r0dumpmanager.domain.config
+
+data class DumpPoint(
+    val bit: Int,
+    val shortName: String,
+    val displayName: String,
+    val important: Boolean = false,
+)
+
+object DumpPointRegistry {
+    val points = listOf(
+        DumpPoint(0, "activitywalk", "ActivityThread class walk"),
+        DumpPoint(1, "methodinvoke", "ArtMethod Invoke", important = true),
+        DumpPoint(2, "loaderroute", "BaseDexClassLoader route"),
+        DumpPoint(3, "defineclass", "ClassLinker DefineClass", important = true),
+        DumpPoint(4, "classinit", "Class init before"),
+        DumpPoint(5, "classinitafter", "Class init after"),
+        DumpPoint(6, "loadclass", "ClassLinker LoadClass"),
+        DumpPoint(7, "fillmethods", "LoadClass helper fill methods"),
+        DumpPoint(8, "registerdex", "ClassLinker RegisterDexFile", important = true),
+        DumpPoint(9, "resolvemethod", "ClassLinker ResolveMethodId"),
+        DumpPoint(10, "verifyclass", "VerifyClass"),
+        DumpPoint(11, "reflectinvoke", "Reflect Invoke"),
+        DumpPoint(12, "oatcookie", "Create cookie from OatFileManager result"),
+        DumpPoint(13, "dexjavaroute", "DexFile Java route"),
+        DumpPoint(14, "dexnativeclass", "DexFile defineClassNative"),
+        DumpPoint(15, "dexmemory", "DexFile open in memory"),
+        DumpPoint(16, "opencommon", "DexFileLoader OpenCommon", important = true),
+        DumpPoint(17, "dexfileopen", "DexFile open file"),
+        DumpPoint(18, "imagedex", "ImageSpace Dex"),
+        DumpPoint(19, "instrumententer", "Instrumentation method enter"),
+        DumpPoint(20, "instrumentexit", "Instrumentation method exit"),
+        DumpPoint(21, "interpreter", "Interpreter execute"),
+        DumpPoint(22, "jitcompile", "JIT compile method"),
+        DumpPoint(23, "jitenter", "JIT method entered"),
+        DumpPoint(24, "oatdexopen", "OatDexFile open DexFile"),
+        DumpPoint(25, "oatload", "OatFileAssistant load DexFiles"),
+        DumpPoint(26, "oatmanageropen", "OatFileManager open DexFilesFromOat"),
+        DumpPoint(27, "oatregister", "OatFileManager register OatFile"),
+    )
+
+    val keyPoints = setOf("opencommon", "registerdex", "defineclass")
+
+    fun maskFor(bits: Set<Int>): Int {
+        var mask = 0
+        bits.forEach { bit ->
+            if (bit in 0..27) mask = mask or (1 shl bit)
+        }
+        return mask
+    }
+
+    fun bitsForMask(mask: Int): Set<Int> = points
+        .filter { (mask and (1 shl it.bit)) != 0 }
+        .map { it.bit }
+        .toSet()
+}
