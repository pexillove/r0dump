--- /dev/null
+++ b/src/com/android/r0dumpmanager/data/control/R0dumpControlRepository.kt
@@ -0,0 +1,136 @@
+package com.android.r0dumpmanager.data.control
+
+import android.os.ServiceManager
+import android.r0dump.IR0dumpControlService
+import android.r0dump.R0dumpConfigParcel
+import android.r0dump.R0dumpOperationResult
+import android.r0dump.R0dumpStatus
+import java.util.UUID
+
+data class BrokerStatus(
+    val runId: Long,
+    val generation: Long,
+    val packageName: String?,
+    val active: Boolean,
+    val ready: Boolean,
+    val publishAllowed: Boolean,
+    val recoveryState: RecoveryState,
+    val indexGeneration: Long,
+)
+
+enum class RecoveryState {
+    NOT_STARTED,
+    INDEXING,
+    READY,
+    FAILED,
+    UNKNOWN,
+}
+
+class R0dumpControlRepository {
+    fun status(): Result<BrokerStatus> = runCatching {
+        val status = service().status
+        BrokerStatus(
+            runId = status.runId,
+            generation = status.generation,
+            packageName = status.packageName?.takeIf { it.isNotBlank() },
+            active = status.active,
+            ready = status.ready,
+            publishAllowed = status.publishAllowed,
+            recoveryState = status.recoveryState.toRecoveryState(),
+            indexGeneration = status.indexGeneration,
+        )
+    }
+
+    fun capabilityMask(): Result<Long> = runCatching { service().capabilities.capabilityMask }
+
+    fun publish(watchPackage: String, dumpPointMask: Int, expectedGeneration: Long): Result<BrokerStatus> =
+        runCatching {
+            val result = service().publish(
+                R0dumpConfigParcel(CONTROL_SCHEMA_VERSION, watchPackage, dumpPointMask.toLong() and 0xffffffffL, 0L),
+                expectedGeneration,
+                UUID.randomUUID().toString(),
+            )
+            result.requireOk("publish")
+            BrokerStatus(
+                result.runId,
+                result.generation,
+                watchPackage,
+                active = true,
+                ready = true,
+                publishAllowed = true,
+                recoveryState = RecoveryState.READY,
+                indexGeneration = -1L,
+            )
+        }
+
+    fun stop(expectedRunId: Long, expectedGeneration: Long): Result<BrokerStatus> = runCatching {
+        val result = service().stop(expectedRunId, expectedGeneration, UUID.randomUUID().toString())
+        result.requireOk("stop")
+        BrokerStatus(
+            result.runId,
+            result.generation,
+            null,
+            active = false,
+            ready = true,
+            publishAllowed = true,
+            recoveryState = RecoveryState.READY,
+            indexGeneration = -1L,
+        )
+    }
+
+    /**
+     * An operation result is only an acknowledgement. The broker's second status read is the
+     * authoritative committed state, and must agree with the complete public status vector.
+     */
+    fun verifyStatus(expected: BrokerStatus): Result<BrokerStatus> = status().mapCatching { actual ->
+        check(actual.runId == expected.runId) {
+            "r0dump broker status run mismatch: expected=${expected.runId} actual=${actual.runId}"
+        }
+        check(actual.generation == expected.generation) {
+            "r0dump broker status generation mismatch: expected=${expected.generation} actual=${actual.generation}"
+        }
+        check(actual.active == expected.active) {
+            "r0dump broker status active mismatch: expected=${expected.active} actual=${actual.active}"
+        }
+        check(actual.packageName == expected.packageName) {
+            "r0dump broker status package mismatch: expected=${expected.packageName} actual=${actual.packageName}"
+        }
+        check(actual.ready == expected.ready) {
+            "r0dump broker status ready mismatch: expected=${expected.ready} actual=${actual.ready}"
+        }
+        check(actual.publishAllowed == expected.publishAllowed) {
+            "r0dump broker status publishAllowed mismatch: expected=${expected.publishAllowed} actual=${actual.publishAllowed}"
+        }
+        actual
+    }
+
+    private fun service(): IR0dumpControlService = IR0dumpControlService.Stub.asInterface(
+        requireNotNull(ServiceManager.getService(CONTROL_SERVICE)) { "r0dump control service is unavailable" },
+    )
+
+    private fun R0dumpOperationResult.requireOk(operation: String) {
+        check(error == R0dumpOperationResult.OK) {
+            "$operation rejected by r0dump broker: ${errorName(error)} (run=$runId generation=$generation)"
+        }
+    }
+
+    private fun errorName(error: Int): String = when (error) {
+        R0dumpOperationResult.STALE -> "stale"
+        R0dumpOperationResult.INVALID -> "invalid"
+        R0dumpOperationResult.DENIED -> "denied"
+        else -> "unknown($error)"
+    }
+
+    private fun Int.toRecoveryState(): RecoveryState = when (this) {
+        R0dumpStatus.RECOVERY_NOT_STARTED -> RecoveryState.NOT_STARTED
+        R0dumpStatus.RECOVERY_INDEXING -> RecoveryState.INDEXING
+        R0dumpStatus.RECOVERY_READY -> RecoveryState.READY
+        R0dumpStatus.RECOVERY_FAILED -> RecoveryState.FAILED
+        else -> RecoveryState.UNKNOWN
+    }
+
+    private companion object {
+        const val CONTROL_SERVICE = "r0dump"
+        const val CONTROL_SCHEMA_VERSION = 1
+    }
+}
diff --git a/src/com/android/r0dumpmanager/data/log/ConfigAuditStore.kt b/src/com/android/r0dumpmanager/data/log/ConfigAuditStore.kt
new file mode 100644
index 0000000..f6f9af3
--- /dev/null
+++ b/src/com/android/r0dumpmanager/data/log/ConfigAuditStore.kt
@@ -0,0 +1,142 @@
+package com.android.r0dumpmanager.data.log
+
+import android.content.Context
+import com.android.r0dumpmanager.domain.log.ConfigLog
+import com.android.r0dumpmanager.domain.log.LogType
+import java.io.File
+import java.util.ArrayDeque
+
+private const val MAX_AUDIT_LOG_LINES = 2000
+
+class ConfigAuditStore(
+    context: Context,
+) {
+    private val file = File(context.filesDir, "r0dump_config_audit.tsv")
+    private val lock = Any()
+
+    fun append(log: ConfigLog) {
+        appendAll(listOf(log))
+    }
+
+    fun appendAll(logs: List<ConfigLog>) {
+        if (logs.isEmpty()) return
+        val text = logs.joinToString(separator = "\n", postfix = "\n") { encodeLine(it) }
+        synchronized(lock) {
+            file.parentFile?.mkdirs()
+            file.appendText(text, Charsets.UTF_8)
+            trimToRecentLinesLocked()
+        }
+    }
+
+    fun readRecent(packageName: String? = null, limit: Int = 100): List<ConfigLog> {
+        if (limit <= 0) return emptyList()
+        val recentLogs = synchronized(lock) {
+            if (!file.isFile) return@synchronized emptyList<ConfigLog>()
+            val logs = ArrayDeque<ConfigLog>(limit)
+            file.useLines(Charsets.UTF_8) { sequence ->
+                sequence.forEach { line ->
+                    val log = parse(line) ?: return@forEach
+                    if (packageName != null && log.packageName != packageName) return@forEach
+                    if (logs.size == limit) logs.removeFirst()
+                    logs.addLast(log)
+                }
+            }
+            logs.toList()
+        }
+        return recentLogs.asReversed()
+    }
+
+    private fun encodeLine(log: ConfigLog): String = listOf(
+        log.timestamp.toString(),
+        log.applicationId,
+        log.packageName,
+        log.type.name,
+        log.key.orEmpty(),
+        log.oldValue.orEmpty(),
+        log.newValue.orEmpty(),
+        log.result.toString(),
+        log.message.orEmpty(),
+    ).joinToString("\t") { escapeCell(it) }
+
+    private fun parse(line: String): ConfigLog? {
+        val parts = splitTsvLine(line).map { unescapeCell(it) }
+        if (parts.size < 9) return null
+        return ConfigLog(
+            timestamp = parts[0].toLongOrNull() ?: return null,
+            applicationId = parts[1],
+            packageName = parts[2],
+            type = runCatching { LogType.valueOf(parts[3]) }.getOrDefault(LogType.ERROR),
+            key = parts[4].ifEmpty { null },
+            oldValue = parts[5].ifEmpty { null },
+            newValue = parts[6].ifEmpty { null },
+            result = parts[7].toBoolean(),
+            message = parts[8].ifEmpty { null },
+        )
+    }
+
+    private fun trimToRecentLinesLocked() {
+        if (!file.isFile) return
+        val recentLines = ArrayDeque<String>(MAX_AUDIT_LOG_LINES)
+        var overflow = false
+        file.useLines(Charsets.UTF_8) { sequence ->
+            sequence.forEach { line ->
+                if (recentLines.size == MAX_AUDIT_LOG_LINES) {
+                    recentLines.removeFirst()
+                    overflow = true
+                }
+                recentLines.addLast(line)
+            }
+        }
+        if (overflow) {
+            file.writeText(recentLines.joinToString(separator = "\n", postfix = "\n"), Charsets.UTF_8)
+        }
+    }
+
+    private fun splitTsvLine(line: String): List<String> {
+        val parts = ArrayList<String>(9)
+        var start = 0
+        while (parts.size < 8) {
+            val tab = line.indexOf('\t', start)
+            if (tab < 0) return emptyList()
+            parts += line.substring(start, tab)
+            start = tab + 1
+        }
+        parts += line.substring(start)
+        return parts
+    }
+
+    private fun escapeCell(value: String): String = buildString(value.length) {
+        value.forEach { ch ->
+            when (ch) {
+                '\\' -> append("\\\\")
+                '\t' -> append("\\t")
+                '\n' -> append("\\n")
+                '\r' -> append("\\r")
+                else -> append(ch)
+            }
+        }
+    }
+
+    private fun unescapeCell(value: String): String = buildString(value.length) {
+        var index = 0
+        while (index < value.length) {
+            val ch = value[index]
+            if (ch == '\\' && index + 1 < value.length) {
+                when (value[index + 1]) {
+                    '\\' -> append('\\')
+                    't' -> append('\t')
+                    'n' -> append('\n')
+                    'r' -> append('\r')
+                    else -> {
+                        append(ch)
+                        append(value[index + 1])
+                    }
+                }
+                index += 2
+            } else {
+                append(ch)
+                index += 1
+            }
+        }
+    }
+}
diff --git a/src/com/android/r0dumpmanager/data/logcat/R0dumpLogcatRepository.kt b/src/com/android/r0dumpmanager/data/logcat/R0dumpLogcatRepository.kt
