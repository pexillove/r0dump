+package com.android.r0dumpmanager.domain.config
+
+data class FusionConfig(
+    val watchPackage: String = "",
+    val dumpPointMask: Int = 0,
+)
+
+data class ValidationResult(
+    val ok: Boolean,
+    val message: String = "",
+)
+
+/** Validation for the subset of configuration the current Broker AIDL accepts. */
+object FusionConfigValidator {
+    fun validateForStart(config: FusionConfig): ValidationResult {
+        if (config.watchPackage.isBlank()) return ValidationResult(false, "Select a target application first")
+        if (!isPackageName(config.watchPackage)) return ValidationResult(false, "Invalid package name")
+        if (config.dumpPointMask == 0) return ValidationResult(false, "Select at least one dump point")
+        if ((config.dumpPointMask and 0xf0000000.toInt()) != 0) {
+            return ValidationResult(false, "Reserved mask bits must be zero")
+        }
+        return ValidationResult(true)
+    }
+
+    private fun isPackageName(value: String): Boolean {
+        if (value.length !in 3..255) return false
+        val parts = value.split('.')
+        if (parts.size < 2 || parts.any { it.isEmpty() }) return false
+        return parts.all { part ->
+            (part.first().isLetter() || part.first() == '_') &&
+                part.all { it.isLetterOrDigit() || it == '_' }
+        }
+    }
+}
