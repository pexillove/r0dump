+package com.android.r0dumpmanager.domain.operation
+
+sealed class SystemOperation(
+    val id: String,
+    val title: String,
+    val description: String,
+    val destructive: Boolean = false,
+) {
+    object PublishDisabledConfig : SystemOperation("publish_disabled", "Stop Dump", "Stop the active broker session")
+    object RestoreDefaults : SystemOperation("restore_defaults", "Restore Defaults", "Stop the active broker session", destructive = true)
+    object ReloadCurrentProperties : SystemOperation("reload_properties", "Reload Configuration", "Re-read broker status")
+    object LaunchTarget : SystemOperation("launch_target", "Launch Target", "Start selected application")
+    object ForceStopTarget : SystemOperation("force_stop_target", "Force-stop Target", "Stop selected application", destructive = true)
+    object CopyAdbCommands : SystemOperation("copy_adb", "Copy adb Commands", "Copy read-only diagnostics")
+}
