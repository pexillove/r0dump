@@ -0,0 +1,21 @@
+package com.android.r0dumpmanager.data.logcat
+
+import java.util.concurrent.TimeUnit
+
+class R0dumpLogcatRepository {
+    fun readRecent(limit: Int = 80): Result<List<String>> = runCatching {
+        val process = ProcessBuilder("logcat", "-d", "-s", "r0dump", "-t", limit.toString())
+            .redirectErrorStream(true)
+            .start()
+        val output = process.inputStream.bufferedReader().readLines()
+        if (!process.waitFor(2, TimeUnit.SECONDS)) {
+            process.destroyForcibly()
+            error("logcat timed out")
+        }
+        val exitCode = process.exitValue()
+        if (exitCode != 0) {
+            error(output.takeLast(3).joinToString("; ").ifBlank { "logcat exited with $exitCode" })
+        }
+        output.takeLast(limit)
+    }
+}
