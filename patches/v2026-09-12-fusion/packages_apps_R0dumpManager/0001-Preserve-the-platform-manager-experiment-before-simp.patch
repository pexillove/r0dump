+#!/usr/bin/env bash
+# Static source-contract checks for the D-110 r0dump Manager broker boundary.
+set -euo pipefail
+
+ROOT_DIR="$(cd "$(dirname "$0")/../../../.." && pwd)"
+APP_DIR="$ROOT_DIR/packages/apps/R0dumpManager"
+
+python3 - "$APP_DIR" <<'PY'
+from pathlib import Path
+import sys
+import xml.etree.ElementTree as ET
+
+app = Path(sys.argv[1])
+errors = []
+
+def read(relative):
+    return (app / relative).read_text()
+
+sources = "\n".join(path.read_text(errors="ignore") for path in (app / "src").rglob("*.kt"))
+control = read("src/com/android/r0dumpmanager/data/control/R0dumpControlRepository.kt")
+view_model = read("src/com/android/r0dumpmanager/app/R0dumpManagerViewModel.kt")
+screen = read("src/com/android/r0dumpmanager/ui/MainScreen.kt")
+reader_models = read("src/com/android/r0dumpmanager/data/reader/PrivateStoreModels.kt")
+reader_repository = read("src/com/android/r0dumpmanager/data/reader/R0dumpPrivateStoreRepository.kt")
+reader_tests = read("tests/src/com/android/r0dumpmanager/data/reader/PrivateStoreReaderContractTest.kt")
+post_flash = read("tools/validate_post_flash.sh")
+final_acceptance = read("tools/final_acceptance.sh")
+
+for forbidden in ("SystemProperties", "AndroidPropertyManager", "R0dumpPropertyStore", "PropertyManager"):
+    if forbidden in sources:
+        errors.append(f"Manager production source must not contain {forbidden}")
+for forbidden in ("schema3", "Schema3", "setprop"):
+    if forbidden in sources:
+        errors.append(f"Manager must not contain legacy external {forbidden} production path")
+
+manager_source = view_model + screen + reader_models
+for required in (
+    "IR0dumpControlService",
+    "ServiceManager.getService(CONTROL_SERVICE)",
+    "R0dumpConfigParcel(CONTROL_SCHEMA_VERSION",
+    "fun status(): Result<BrokerStatus>",
+    "fun publish(",
+    "fun stop(",
+    "fun capabilityMask(): Result<Long>",
+    "R0dumpStatus.RECOVERY_NOT_STARTED",
+    "R0dumpStatus.RECOVERY_INDEXING",
+    "R0dumpStatus.RECOVERY_READY",
+    "R0dumpStatus.RECOVERY_FAILED",
+    "R0dumpOperationResult.STALE",
+):
+    if required not in control:
+        errors.append(f"Broker repository missing: {required}")
+for required in (
+    "private val controlRepository = R0dumpControlRepository()",
+    "controlRepository.status()",
+    "controlRepository.publish(app.packageName, state.mask, beforeStatus.generation)",
+    "controlRepository.stop(beforeStatus.runId, beforeStatus.generation)",
+    "controlRepository.verifyStatus(result.getOrThrow()).getOrThrow()",
+):
+    if required not in view_model:
+        errors.append(f"ViewModel must use broker control API: {required}")
+if "adb shell setprop" in screen:
+    errors.append("UI must not offer property-write commands")
+if "adb shell cmd r0dump status" not in screen:
+    errors.append("Read-only adb diagnostics must query Broker status through cmd r0dump")
+if (app / "src/com/android/r0dumpmanager/data/dump/DumpDirectoryRepository.kt").exists():
+    errors.append("Private reader is not available; Manager must not scan Legacy external output")
+for forbidden in (
+    "ActiveInvokeCard",
+    "EvidenceCard",
+    "OutputCard",
+    "OpenDumpDirectory",
+    "openDumpDirectory",
+    "/sdcard/download/r0dump",
+):
+    if forbidden in sources:
+        errors.append(f"Unsupported capability/private-reader UI remains exposed: {forbidden}")
+if "private fun LegacyExternalCard(state: R0dumpUiState)" not in screen or "never used as a private-reader fallback" not in screen:
+    errors.append("Legacy external state must remain explicit and read-only until Broker reader rollout")
+for required in (
+    "val capabilityMask: Long? = null",
+    "val canPublish: Boolean = brokerStatus?.ready == true && brokerStatus.publishAllowed",
+    "brokerStatus?.ready == true && brokerStatus.publishAllowed",
+    "val canStop: Boolean = brokerStatus?.ready == true && brokerStatus.active",
+    "RecoveryState.NOT_STARTED",
+    "RecoveryState.INDEXING",
+    "RecoveryState.READY",
+    "RecoveryState.FAILED",
+    "val capabilityMask = controlRepository.capabilityMask().getOrNull()",
+    "if (!state.canPublish) return showError",
+    "enabled = canPublish",
+    "enabled = state.canStop && !updating",
+    "if (!state.canStop) return showError",
+    "if (isOperationBusy() || !_uiState.value.canPublish) return",
+):
+    if required not in manager_source:
+        errors.append(f"Capability fail-closed contract missing: {required}")
+if "capabilityMask != null && capabilityMask != 0L" in view_model:
+    errors.append("Optional capability mask must not gate basic passive publishing")
+for required in (
+    "R0dumpCapabilities.CAP_PRIVATE_STORE_CONTROL_V1",
+    "(capabilityMask and CAP_PRIVATE_STORE_CONTROL_V1) != 0L",
+    "RecoveryState.READY",
+):
+    if required not in reader_models:
+        errors.append(f"Private reader exact-capability gate missing: {required}")
+if "capabilityMask != 0L" in reader_models:
+    errors.append("Private reader must not enable from a nonzero capability mask")
+for required in (
+    "IR0dumpControlService",
+    "fun listRuns(",
+    "fun listSessions(",
+    "fun listObservations(",
+    "fun beginExportRun(",
+    "fun deleteRun(",
+    "PrivateStoreUnavailableException",
+    "DeadObjectException",
+):
+    if required not in reader_repository:
+        errors.append(f"Typed private-store Repository contract missing: {required}")
+for required in (
+    "class PrivateExportCompletion",
+    "IBinder.DeathRecipient",
+    "PENDING_ACCEPT",
+    "LINKING",
+    "ARMED",
+    "ABANDONED",
+    "class PrivateExportStarter",
+    "val acceptedTicket = ticket.toPrivateTicketValidated(",
+    "completion.arm(deathMonitor)",
+    "completion.abandon()",
+    "acceptTerminal(Result.failure(PrivateStoreUnavailableException()))",
+    "acceptTerminal(runCatching",
+    "dispatcher {",
+):
+    if required not in reader_repository:
+        errors.append(f"Export exactly-once terminal contract missing: {required}")
+ticket_model = reader_repository.find("val acceptedTicket = ticket.toPrivateTicketValidated(")
+ticket_arm = reader_repository.find("completion.arm(deathMonitor)")
+if ticket_model < 0 or ticket_arm < 0 or ticket_model > ticket_arm:
+    errors.append("Validated private export ticket must be fully constructed before completion arm")
+for required in (
+    "fun unavailableServiceMapsToPrivateStoreUnavailable()",
+    "R0dumpPrivateStoreRepository { null }",
+    "fun nonOkExportCallbackCompletesExactlyOnce()",
+    "fun exportBinderDeathCompletesExactlyOnce()",
+    "fun earlyCallbackIsDeliveredOnlyAfterAcceptedTicket()",
+    "fun earlyCallbackIsAbandonedWhenTicketIsRejected()",
+    "fun malformedAcceptedTicketAbandonsEarlyCallback()",
+    "fun deathLinkFailureCompletesAsUnavailable()",
+    "fun exportCallbackAndDeathRaceCompletesExactlyOnce()",
+    "fun exportConsumerFailureDoesNotEscapeCompletionDispatcher()",
+    "fun exportDispatcherFailureDoesNotEscapeBinderCallback()",
+    "assertEquals(1, results.size)",
+):
+    if required not in reader_tests:
+        errors.append(f"Private-store instrumentation regression missing: {required}")
+if "PrivateReaderGate.state(" not in view_model or "indexGeneration" not in reader_models:
+    errors.append("ViewModel must clear private reader state through the exact capability gate")
+if "getOrElse { result.getOrThrow() }" in view_model:
+    errors.append("ViewModel must not use operation results as a getStatus fallback")
+for required in (
+    "fun verifyStatus(expected: BrokerStatus): Result<BrokerStatus>",
+    "actual.runId == expected.runId",
+    "actual.generation == expected.generation",
+    "actual.active == expected.active",
+    "actual.packageName == expected.packageName",
+    "actual.ready == expected.ready",
+    "actual.publishAllowed == expected.publishAllowed",
+):
+    if required not in control:
+        errors.append(f"Broker status confirmation missing: {required}")
+for tool_name, tool in (("validate_post_flash.sh", post_flash), ("final_acceptance.sh", final_acceptance)):
+    for forbidden in ("getprop", "setprop", "adb shell setprop"):
+        if forbidden in tool:
+            errors.append(f"{tool_name} retains obsolete property assumption: {forbidden}")
+for required in (
+    '-H "$ADB_HOST" -P "$ADB_PORT"',
+    "service check r0dump",
+    "cmd r0dump status",
+    "broker_status_before.txt",
+    "broker_status_after.txt",
+    "ready publish_allowed recovery_state",
+):
+    if required not in post_flash:
+        errors.append(f"post-flash Binder/5038 contract missing: {required}")
+
+manifest = ET.parse(app / "AndroidManifest.xml").getroot()
+uses = {node.attrib.get("{http://schemas.android.com/apk/res/android}name", "") for node in manifest.findall("uses-permission")}
+if "android.permission.MANAGE_R0DUMP" not in uses:
+    errors.append("MANAGE_R0DUMP missing from manifest")
+if "android.permission.MANAGE_R0DUMP" not in read("privapp-permissions-com.android.r0dumpmanager.xml"):
+    errors.append("MANAGE_R0DUMP missing from privapp permissions")
+if "android.permission.MANAGE_EXTERNAL_STORAGE" in uses:
+    errors.append("Manager must not retain external storage access before Broker reader rollout")
+if "platform_apis: true" not in read("Android.bp"):
+    errors.append("Manager must retain platform APIs for hidden broker AIDL")
+
+test_manifest = ET.parse(app / "tests/AndroidManifest.xml").getroot()
+test_application = test_manifest.find("application")
+if test_application is not None and (
+    "{http://schemas.android.com/apk/res/android}label" in test_application.attrib
+):
+    errors.append("R0dumpManagerTests must not override the production application label")
+instrumentation = test_manifest.find("instrumentation")
+if instrumentation is None:
+    errors.append("R0dumpManagerTests manifest must register instrumentation")
+else:
+    android_name = instrumentation.attrib.get("{http://schemas.android.com/apk/res/android}name", "")
+    target_package = instrumentation.attrib.get(
+        "{http://schemas.android.com/apk/res/android}targetPackage", ""
+    )
+    if android_name != "androidx.test.runner.AndroidJUnitRunner":
+        errors.append("R0dumpManagerTests must use AndroidJUnitRunner")
+    if target_package != "com.android.r0dumpmanager":
+        errors.append("R0dumpManagerTests must target the production Manager package")
+
+if errors:
+    print("FAIL: R0dumpManager source contract validation failed", file=sys.stderr)
+    for error in errors:
+        print(f" - {error}", file=sys.stderr)
+    raise SystemExit(1)
+print("PASS: R0dumpManager broker source contracts validated")
+PY
