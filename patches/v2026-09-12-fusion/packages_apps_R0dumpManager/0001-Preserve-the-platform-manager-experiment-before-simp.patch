+/**
+ * Typed private-store reader surface. The Binder adapter is intentionally the only implementation
+ * allowed to supply this API: no Manager caller receives private paths, FDs, or raw artifacts.
+ */
+interface PrivateStoreServiceAdapter {
+    fun listRuns(packageName: String, expectedIndexGeneration: Long, cursor: String?, pageSize: Int): PrivateRunPage
+
+    fun listSessions(
+        packageName: String,
+        runId: Long,
+        expectedIndexGeneration: Long,
+        cursor: String?,
+        pageSize: Int,
+    ): PrivateSessionPage
+
+    fun listObservations(
+        packageName: String,
+        runId: Long,
+        opaqueSessionId: String,
+        expectedIndexGeneration: Long,
+        cursor: String?,
+        pageSize: Int,
+    ): PrivateObservationPage
+
+    fun beginExportRun(
+        packageName: String,
+        runId: Long,
+        expectedIndexGeneration: Long,
+        destination: ParcelFileDescriptor,
+        requestId: String,
+        onFinished: (Result<PrivateExportResult>) -> Unit,
+    ): PrivateExportTicket
+
+    fun deleteRun(
+        packageName: String,
+        runId: Long,
+        expectedIndexGeneration: Long,
+        requestId: String,
+    ): PrivateDeleteResult
+}
+
+class R0dumpPrivateStoreRepository(
+    private val adapterProvider: () -> PrivateStoreServiceAdapter? = {
+        BinderPrivateStoreServiceAdapter.connect()
+    },
+) {
+    fun listRuns(
+        packageName: String,
+        expectedIndexGeneration: Long,
+        cursor: String?,
+        pageSize: Int,
+    ): Result<PrivateRunPage> = call { it.listRuns(packageName, expectedIndexGeneration, cursor, pageSize) }
+
+    fun listSessions(
+        packageName: String,
+        runId: Long,
+        expectedIndexGeneration: Long,
+        cursor: String?,
+        pageSize: Int,
+    ): Result<PrivateSessionPage> = call {
+        it.listSessions(packageName, runId, expectedIndexGeneration, cursor, pageSize)
+    }
+
+    fun listObservations(
+        packageName: String,
+        runId: Long,
+        opaqueSessionId: String,
+        expectedIndexGeneration: Long,
+        cursor: String?,
+        pageSize: Int,
+    ): Result<PrivateObservationPage> = call {
+        it.listObservations(packageName, runId, opaqueSessionId, expectedIndexGeneration, cursor, pageSize)
+    }
+
+    fun beginExportRun(
+        packageName: String,
+        runId: Long,
+        expectedIndexGeneration: Long,
+        destination: ParcelFileDescriptor,
+        requestId: String,
+        onFinished: (Result<PrivateExportResult>) -> Unit,
+    ): Result<PrivateExportTicket> = call {
+        it.beginExportRun(
+            packageName,
+            runId,
+            expectedIndexGeneration,
+            destination,
+            requestId,
+            onFinished,
+        )
+    }
+
+    fun deleteRun(
+        packageName: String,
+        runId: Long,
+        expectedIndexGeneration: Long,
+        requestId: String,
+    ): Result<PrivateDeleteResult> = call {
+        it.deleteRun(packageName, runId, expectedIndexGeneration, requestId)
+    }
+
+    private inline fun <T> call(operation: (PrivateStoreServiceAdapter) -> T): Result<T> = runCatching {
+        operation(adapterProvider() ?: throw PrivateStoreUnavailableException())
+    }.recoverCatching { failure ->
+        if (failure is DeadObjectException || failure is RemoteException) {
+            throw PrivateStoreUnavailableException()
+        }
+        throw failure
+    }
+}
+
+private class BinderPrivateStoreServiceAdapter(
+    private val service: IR0dumpControlService,
+) : PrivateStoreServiceAdapter {
+    override fun listRuns(
+        packageName: String,
+        expectedIndexGeneration: Long,
+        cursor: String?,
+        pageSize: Int,
+    ): PrivateRunPage = service.listRuns(packageName, expectedIndexGeneration, cursor, pageSize).toPrivatePage()
+
+    override fun listSessions(
+        packageName: String,
+        runId: Long,
+        expectedIndexGeneration: Long,
+        cursor: String?,
+        pageSize: Int,
+    ): PrivateSessionPage = service.listSessions(
+        packageName,
+        runId,
+        expectedIndexGeneration,
+        cursor,
+        pageSize,
+    ).toPrivatePage()
+
+    override fun listObservations(
+        packageName: String,
+        runId: Long,
+        opaqueSessionId: String,
+        expectedIndexGeneration: Long,
+        cursor: String?,
+        pageSize: Int,
+    ): PrivateObservationPage = service.listObservations(
+        packageName,
+        runId,
+        opaqueSessionId,
+        expectedIndexGeneration,
+        cursor,
+        pageSize,
+    ).toPrivatePage()
+
+    override fun beginExportRun(
+        packageName: String,
+        runId: Long,
+        expectedIndexGeneration: Long,
+        destination: ParcelFileDescriptor,
+        requestId: String,
+        onFinished: (Result<PrivateExportResult>) -> Unit,
+    ): PrivateExportTicket = PrivateExportStarter(
+        BinderPrivateExportDeathMonitor(service.asBinder()),
+    ).begin(
+        expectedPackageName = packageName,
+        expectedRunId = runId,
+        expectedIndexGeneration = expectedIndexGeneration,
+        onFinished = onFinished,
+    ) { callback ->
+        service.beginExportRun(
+            packageName,
+            runId,
+            expectedIndexGeneration,
+            destination,
+            requestId,
+            callback,
+        )
+    }
+
+    override fun deleteRun(
+        packageName: String,
+        runId: Long,
+        expectedIndexGeneration: Long,
+        requestId: String,
+    ): PrivateDeleteResult = service.deleteRun(
+        packageName,
+        runId,
+        expectedIndexGeneration,
+        requestId,
+    ).let { result ->
+        result.requireOk()
+        result.toPrivateResult()
+    }
+
+    companion object {
+        fun connect(): PrivateStoreServiceAdapter? = ServiceManager.getService(CONTROL_SERVICE)?.let {
+            BinderPrivateStoreServiceAdapter(IR0dumpControlService.Stub.asInterface(it))
+        }
+
+        private const val CONTROL_SERVICE = "r0dump"
+    }
+}
+
+interface PrivateExportDeathMonitor {
+    @Throws(RemoteException::class)
+    fun link(recipient: IBinder.DeathRecipient)
+
+    fun unlink(recipient: IBinder.DeathRecipient)
+}
+
+private class BinderPrivateExportDeathMonitor(
+    private val binder: IBinder,
+) : PrivateExportDeathMonitor {
+    override fun link(recipient: IBinder.DeathRecipient) {
+        binder.linkToDeath(recipient, 0)
+    }
+
+    override fun unlink(recipient: IBinder.DeathRecipient) {
+        try {
+            binder.unlinkToDeath(recipient, 0)
+        } catch (_: NoSuchElementException) {
+            // Binder may remove the recipient while delivering death.
+        }
+    }
+}
+
+private val privateExportMainHandler by lazy { Handler(Looper.getMainLooper()) }
+
+private fun dispatchPrivateExportOnMain(task: () -> Unit) {
+    privateExportMainHandler.post(task)
+}
+
+/** Owns the synchronous begin/validate/arm ordering used by the Binder adapter. */
+class PrivateExportStarter(
+    private val deathMonitor: PrivateExportDeathMonitor,
+    private val dispatcher: ((() -> Unit) -> Unit) = ::dispatchPrivateExportOnMain,
+) {
+    fun begin(
+        expectedPackageName: String,
+        expectedRunId: Long,
+        expectedIndexGeneration: Long,
+        onFinished: (Result<PrivateExportResult>) -> Unit,
+        request: (IR0dumpExportCallback) -> BinderExportTicket,
+    ): PrivateExportTicket {
+        val completion = PrivateExportCompletion(onFinished, dispatcher)
+        try {
+            val ticket = request(object : IR0dumpExportCallback.Stub() {
+                override fun onFinished(result: R0dumpExportResult) {
+                    completion.onBinderResult(result)
+                }
+            })
+            val acceptedTicket = ticket.toPrivateTicketValidated(
+                expectedPackageName,
+                expectedRunId,
+                expectedIndexGeneration,
+            )
+            completion.arm(deathMonitor)
+            return acceptedTicket
+        } catch (failure: Throwable) {
+            completion.abandon()
+            throw failure
+        }
+    }
+}
+
+/** Orders synchronous ticket acceptance before the first asynchronous export terminal. */
+class PrivateExportCompletion(
+    private val onFinished: (Result<PrivateExportResult>) -> Unit,
+    private val dispatcher: ((() -> Unit) -> Unit) = ::dispatchPrivateExportOnMain,
+) : IBinder.DeathRecipient {
+    private enum class State {
+        PENDING_ACCEPT,
+        LINKING,
+        ARMED,
+        FINISHED,
+        ABANDONED,
+    }
+
+    private val lock = Any()
+    private var state = State.PENDING_ACCEPT
+    private var pendingResult: Result<PrivateExportResult>? = null
+    private var linkedMonitor: PrivateExportDeathMonitor? = null
+
+    fun arm(deathMonitor: PrivateExportDeathMonitor) {
+        val buffered = synchronized(lock) {
+            if (state != State.PENDING_ACCEPT) return
+            pendingResult.also { result ->
+                pendingResult = null
+                state = if (result == null) State.LINKING else State.FINISHED
+            }
+        }
+        if (buffered != null) {
+            dispatch(buffered)
+            return
+        }
+
+        try {
+            deathMonitor.link(this)
+        } catch (_: RemoteException) {
+            acceptTerminal(Result.failure(PrivateStoreUnavailableException()))
+            return
+        }
+
+        val unlink = synchronized(lock) {
+            when (state) {
+                State.LINKING -> {
+                    linkedMonitor = deathMonitor
+                    state = State.ARMED
+                    false
+                }
+                State.FINISHED, State.ABANDONED -> true
+                else -> true
+            }
+        }
+        if (unlink) deathMonitor.unlink(this)
+    }
+
+    fun abandon() {
+        val monitor = synchronized(lock) {
+            pendingResult = null
+            when (state) {
+                State.PENDING_ACCEPT, State.LINKING -> {
+                    state = State.ABANDONED
+                    null
+                }
+                State.ARMED -> {
+                    state = State.ABANDONED
+                    linkedMonitor.also { linkedMonitor = null }
+                }
+                State.FINISHED, State.ABANDONED -> null
+            }
+        }
+        monitor?.unlink(this)
+    }
+
+    fun onBinderResult(result: R0dumpExportResult) {
+        acceptTerminal(runCatching {
+            result.requireOk()
+            PrivateExportResult(
+                exportId = result.exportId,
+                packageName = result.packageName,
+                runId = result.runId,
+                indexGeneration = result.indexGeneration,
+                bytesWritten = result.bytesWritten,
+                archiveSha256 = result.archiveSha256,
+                partialOutput = result.partialOutput,
+            )
+        })
+    }
+
+    override fun binderDied() {
+        acceptTerminal(Result.failure(PrivateStoreUnavailableException()))
+    }
+
+    private fun acceptTerminal(result: Result<PrivateExportResult>) {
+        var deliver: Result<PrivateExportResult>? = null
+        val monitor = synchronized(lock) {
+            when (state) {
+                State.PENDING_ACCEPT -> {
+                    if (pendingResult == null) pendingResult = result
+                    null
+                }
+                State.LINKING -> {
+                    state = State.FINISHED
+                    deliver = result
+                    null
+                }
+                State.ARMED -> {
+                    state = State.FINISHED
+                    deliver = result
+                    linkedMonitor.also { linkedMonitor = null }
+                }
+                State.FINISHED, State.ABANDONED -> return
+            }
+        }
+        monitor?.unlink(this)
+        deliver?.let(::dispatch)
+    }
+
+    private fun dispatch(result: Result<PrivateExportResult>) {
+        try {
+            dispatcher {
+                try {
+                    onFinished(result)
+                } catch (failure: RuntimeException) {
+                    Log.e(TAG, "Private export completion consumer failed", failure)
+                }
+            }
+        } catch (failure: RuntimeException) {
+            Log.e(TAG, "Private export completion dispatch failed", failure)
+        }
+    }
+
+    companion object {
+        private const val TAG = "R0dumpPrivateStore"
+    }
+}
+
+private fun R0dumpRunPage.toPrivatePage(): PrivateRunPage {
+    requireOk()
+    return PrivateRunPage(indexGeneration, items.map(R0dumpRunSummary::toPrivateSummary), nextCursor)
+}
+
+private fun R0dumpSessionPage.toPrivatePage(): PrivateSessionPage {
+    requireOk()
+    return PrivateSessionPage(indexGeneration, items.map(R0dumpSessionSummary::toPrivateSummary), nextCursor)
+}
+
+private fun R0dumpObservationPage.toPrivatePage(): PrivateObservationPage {
+    requireOk()
+    return PrivateObservationPage(
+        indexGeneration,
+        items.map(R0dumpObservationSummary::toPrivateSummary),
+        nextCursor,
+    )
+}
+
+private fun R0dumpRunSummary.toPrivateSummary() = PrivateRunSummary(
+    packageName = packageName,
+    runId = runId,
+    state = aggregateState,
+    active = active,
+    observationCount = observationCount,
+    verifiedBytes = verifiedBytes,
+    exportable = exportable,
+    deletable = deletable,
+)
+
+private fun R0dumpSessionSummary.toPrivateSummary() = PrivateSessionSummary(
+    opaqueSessionId = opaqueSessionId,
+    processName = processName,
+    state = state,
+    acceptedWatermark = acceptedWatermark,
+    resolvedWatermark = resolvedWatermark,
+    committedWatermark = committedWatermark,
+)
+
+private fun R0dumpObservationSummary.toPrivateSummary() = PrivateObservationSummary(
+    sequence = sequence,
+    point = point,
+    phase = phase,
+    payload = payload,
+    terminalState = terminalState,
+    terminalReason = reason,
+)
+
+private fun R0dumpDeleteResult.toPrivateResult() = PrivateDeleteResult(
+    packageName = packageName,
+    runId = runId,
+    oldIndexGeneration = oldIndexGeneration,
+    newIndexGeneration = newIndexGeneration,
+    reclaimPending = reclaimPending,
+)
+
+private fun R0dumpRunPage.requireOk() = throwIfError(error)
+
+private fun R0dumpSessionPage.requireOk() = throwIfError(error)
+
+private fun R0dumpObservationPage.requireOk() = throwIfError(error)
+
+private fun R0dumpDeleteResult.requireOk() = throwIfError(error)
+
+private fun android.r0dump.R0dumpExportTicket.requireOk() = throwIfError(error)
+
+private fun BinderExportTicket.toPrivateTicketValidated(
+    expectedPackageName: String,
+    expectedRunId: Long,
+    expectedIndexGeneration: Long,
+): PrivateExportTicket {
+    requireOk()
+    val validatedExportId = exportId
+    val validatedPackageName = packageName
+    if (validatedExportId.isNullOrEmpty() || validatedExportId.length > 128
+        || validatedExportId.any { !it.isLetterOrDigit() && it != '-' && it != '_' }
+        || validatedPackageName == null || validatedPackageName != expectedPackageName
+        || runId <= 0 || runId != expectedRunId
+        || indexGeneration <= 0 || indexGeneration != expectedIndexGeneration
+    ) {
+        throw PrivateStoreServiceException(R0dumpOperationResult.CORRUPT)
+    }
+    return PrivateExportTicket(
+        validatedExportId,
+        validatedPackageName,
+        runId,
+        indexGeneration,
+    )
+}
+
+private fun R0dumpExportResult.requireOk() = throwIfError(error)
+
+private fun throwIfError(error: Int) {
+    if (error != R0dumpOperationResult.OK) throw PrivateStoreServiceException(error)
+}
