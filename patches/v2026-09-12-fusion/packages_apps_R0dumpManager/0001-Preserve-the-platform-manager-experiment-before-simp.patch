diff --git a/tests/src/com/android/r0dumpmanager/data/reader/PrivateStoreReaderContractTest.kt b/tests/src/com/android/r0dumpmanager/data/reader/PrivateStoreReaderContractTest.kt
new file mode 100644
index 0000000..40548d9
--- /dev/null
+++ b/tests/src/com/android/r0dumpmanager/data/reader/PrivateStoreReaderContractTest.kt
@@ -0,0 +1,381 @@
+package com.android.r0dumpmanager.data.reader
+
+import android.os.DeadObjectException
+import android.os.IBinder
+import android.os.ParcelFileDescriptor
+import android.os.RemoteException
+import android.r0dump.R0dumpExportResult
+import android.r0dump.R0dumpExportTicket
+import android.r0dump.R0dumpOperationResult
+import com.android.r0dumpmanager.data.control.RecoveryState
+import java.util.Collections
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.atomic.AtomicInteger
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PrivateStoreReaderContractTest {
+    @Test
+    fun exactPrivateStoreBitEnablesReader() {
+        assertTrue(
+            PrivateStoreCapabilities.hasPrivateStoreControl(
+                PrivateStoreCapabilities.CAP_PRIVATE_STORE_CONTROL_V1,
+            ),
+        )
+        assertFalse(PrivateStoreCapabilities.hasPrivateStoreControl(0L))
+        assertFalse(PrivateStoreCapabilities.hasPrivateStoreControl(null))
+    }
+
+    @Test
+    fun unrelatedCapabilityDoesNotEnableReader() {
+        val unrelatedCapability = 1L shl 9
+        assertFalse(PrivateStoreCapabilities.hasPrivateStoreControl(unrelatedCapability))
+        assertEquals(
+            PrivateReaderAvailability.UNAVAILABLE,
+            PrivateReaderGate.state(RecoveryState.READY, unrelatedCapability, 1L).availability,
+        )
+    }
+
+    @Test
+    fun readyWithoutPositiveIndexGenerationDoesNotEnableReader() {
+        val capability = PrivateStoreCapabilities.CAP_PRIVATE_STORE_CONTROL_V1
+        assertFalse(PrivateReaderGate.state(RecoveryState.READY, capability, 0L).canRead)
+        assertFalse(PrivateReaderGate.state(RecoveryState.READY, capability, -1L).canRead)
+        assertTrue(PrivateReaderGate.state(RecoveryState.READY, capability, 1L).canRead)
+    }
+
+    @Test
+    fun unavailableServiceMapsToPrivateStoreUnavailable() {
+        val result = R0dumpPrivateStoreRepository { null }.listRuns(
+            packageName = "com.example.target",
+            expectedIndexGeneration = 0L,
+            cursor = null,
+            pageSize = 20,
+        )
+
+        assertTrue(result.isFailure)
+        assertTrue(result.exceptionOrNull() is PrivateStoreUnavailableException)
+    }
+
+    @Test
+    fun binderDeathClearsToPrivateStoreUnavailable() {
+        val deadAdapter = object : PrivateStoreServiceAdapter {
+            override fun listRuns(
+                packageName: String,
+                expectedIndexGeneration: Long,
+                cursor: String?,
+                pageSize: Int,
+            ): PrivateRunPage = throw DeadObjectException()
+
+            override fun listSessions(
+                packageName: String,
+                runId: Long,
+                expectedIndexGeneration: Long,
+                cursor: String?,
+                pageSize: Int,
+            ): PrivateSessionPage = error("unexpected listSessions")
+
+            override fun listObservations(
+                packageName: String,
+                runId: Long,
+                opaqueSessionId: String,
+                expectedIndexGeneration: Long,
+                cursor: String?,
+                pageSize: Int,
+            ): PrivateObservationPage = error("unexpected listObservations")
+
+            override fun beginExportRun(
+                packageName: String,
+                runId: Long,
+                expectedIndexGeneration: Long,
+                destination: ParcelFileDescriptor,
+                requestId: String,
+                onFinished: (Result<PrivateExportResult>) -> Unit,
+            ): PrivateExportTicket = error("unexpected beginExportRun")
+
+            override fun deleteRun(
+                packageName: String,
+                runId: Long,
+                expectedIndexGeneration: Long,
+                requestId: String,
+            ): PrivateDeleteResult = error("unexpected deleteRun")
+        }
+
+        val result = R0dumpPrivateStoreRepository { deadAdapter }.listRuns(
+            packageName = "com.example.target",
+            expectedIndexGeneration = 1L,
+            cursor = null,
+            pageSize = 20,
+        )
+
+        assertTrue(result.isFailure)
+        assertTrue(result.exceptionOrNull() is PrivateStoreUnavailableException)
+    }
+
+    @Test
+    fun nonOkExportCallbackCompletesExactlyOnce() {
+        val results = mutableListOf<Result<PrivateExportResult>>()
+        val completion = PrivateExportCompletion(
+            onFinished = { results.add(it) },
+            dispatcher = { it() },
+        )
+        val failure = R0dumpExportResult(
+            R0dumpOperationResult.DESTINATION_ERROR,
+            "export-1",
+            "com.example.target",
+            7L,
+            3L,
+            0L,
+            null,
+            true,
+        )
+
+        completion.onBinderResult(failure)
+        completion.onBinderResult(failure)
+        completion.binderDied()
+        assertTrue(results.isEmpty())
+
+        completion.arm(FakePrivateExportDeathMonitor())
+
+        assertEquals(1, results.size)
+        assertTrue(results.single().isFailure)
+        assertEquals(
+            R0dumpOperationResult.DESTINATION_ERROR,
+            (results.single().exceptionOrNull() as PrivateStoreServiceException).error,
+        )
+    }
+
+    @Test
+    fun exportBinderDeathCompletesExactlyOnce() {
+        val results = mutableListOf<Result<PrivateExportResult>>()
+        val completion = PrivateExportCompletion(
+            onFinished = { results.add(it) },
+            dispatcher = { it() },
+        )
+        val monitor = FakePrivateExportDeathMonitor(
+            onLink = { it.binderDied() },
+        )
+
+        completion.arm(monitor)
+        completion.binderDied()
+        completion.onBinderResult(successExportResult())
+
+        assertEquals(1, results.size)
+        assertTrue(results.single().isFailure)
+        assertTrue(results.single().exceptionOrNull() is PrivateStoreUnavailableException)
+        assertEquals(1, monitor.linkCount.get())
+        assertEquals(1, monitor.unlinkCount.get())
+    }
+
+    @Test
+    fun earlyCallbackIsDeliveredOnlyAfterAcceptedTicket() {
+        val results = mutableListOf<Result<PrivateExportResult>>()
+        val monitor = FakePrivateExportDeathMonitor()
+        val starter = PrivateExportStarter(
+            deathMonitor = monitor,
+            dispatcher = { it() },
+        )
+        var deliveredInsideRequest = false
+
+        val ticket = starter.begin(
+            expectedPackageName = "com.example.target",
+            expectedRunId = 7L,
+            expectedIndexGeneration = 3L,
+            onFinished = { results.add(it) },
+        ) { callback ->
+            callback.onFinished(successExportResult())
+            deliveredInsideRequest = results.isNotEmpty()
+            R0dumpExportTicket(
+                R0dumpOperationResult.OK,
+                "export-1",
+                "com.example.target",
+                7L,
+                3L,
+            )
+        }
+
+        assertFalse(deliveredInsideRequest)
+        assertEquals("export-1", ticket.exportId)
+        assertEquals(1, results.size)
+        assertEquals(0, monitor.linkCount.get())
+    }
+
+    @Test
+    fun earlyCallbackIsAbandonedWhenTicketIsRejected() {
+        val results = mutableListOf<Result<PrivateExportResult>>()
+        val monitor = FakePrivateExportDeathMonitor()
+        val starter = PrivateExportStarter(
+            deathMonitor = monitor,
+            dispatcher = { it() },
+        )
+
+        val begin = runCatching {
+            starter.begin(
+                expectedPackageName = "com.example.target",
+                expectedRunId = 7L,
+                expectedIndexGeneration = 3L,
+                onFinished = { results.add(it) },
+            ) { callback ->
+                callback.onFinished(successExportResult())
+                R0dumpExportTicket(
+                    R0dumpOperationResult.UNSUPPORTED,
+                    null,
+                    "com.example.target",
+                    7L,
+                    -1L,
+                )
+            }
+        }
+
+        assertTrue(begin.isFailure)
+        assertTrue(results.isEmpty())
+        assertEquals(0, monitor.linkCount.get())
+    }
+
+    @Test
+    fun malformedAcceptedTicketAbandonsEarlyCallback() {
+        val results = mutableListOf<Result<PrivateExportResult>>()
+        val monitor = FakePrivateExportDeathMonitor()
+        val starter = PrivateExportStarter(
+            deathMonitor = monitor,
+            dispatcher = { it() },
+        )
+
+        val begin = runCatching {
+            starter.begin(
+                expectedPackageName = "com.example.target",
+                expectedRunId = 7L,
+                expectedIndexGeneration = 3L,
+                onFinished = { results.add(it) },
+            ) { callback ->
+                callback.onFinished(successExportResult())
+                R0dumpExportTicket(
+                    R0dumpOperationResult.OK,
+                    null,
+                    "com.example.target",
+                    7L,
+                    3L,
+                )
+            }
+        }
+
+        assertTrue(begin.isFailure)
+        assertEquals(
+            R0dumpOperationResult.CORRUPT,
+            (begin.exceptionOrNull() as PrivateStoreServiceException).error,
+        )
+        assertTrue(results.isEmpty())
+        assertEquals(0, monitor.linkCount.get())
+    }
+
+    @Test
+    fun deathLinkFailureCompletesAsUnavailable() {
+        val results = mutableListOf<Result<PrivateExportResult>>()
+        val completion = PrivateExportCompletion(
+            onFinished = { results.add(it) },
+            dispatcher = { it() },
+        )
+        val monitor = FakePrivateExportDeathMonitor(failLink = true)
+
+        completion.arm(monitor)
+
+        assertEquals(1, results.size)
+        assertTrue(results.single().exceptionOrNull() is PrivateStoreUnavailableException)
+        assertEquals(1, monitor.linkCount.get())
+        assertEquals(0, monitor.unlinkCount.get())
+    }
+
+    @Test
+    fun exportCallbackAndDeathRaceCompletesExactlyOnce() {
+        repeat(100) {
+            val results = Collections.synchronizedList(mutableListOf<Result<PrivateExportResult>>())
+            val completion = PrivateExportCompletion(
+                onFinished = { results.add(it) },
+                dispatcher = { it() },
+            )
+            val monitor = FakePrivateExportDeathMonitor()
+            completion.arm(monitor)
+            val start = CountDownLatch(1)
+            val callbackThread = Thread {
+                start.await()
+                completion.onBinderResult(successExportResult())
+            }
+            val deathThread = Thread {
+                start.await()
+                completion.binderDied()
+            }
+
+            callbackThread.start()
+            deathThread.start()
+            start.countDown()
+            callbackThread.join()
+            deathThread.join()
+
+            assertEquals(1, results.size)
+            assertEquals(1, monitor.unlinkCount.get())
+        }
+    }
+
+    @Test
+    fun exportConsumerFailureDoesNotEscapeCompletionDispatcher() {
+        var callbackCount = 0
+        val completion = PrivateExportCompletion(
+            onFinished = {
+                callbackCount++
+                throw IllegalStateException("consumer failure")
+            },
+            dispatcher = { it() },
+        )
+
+        completion.onBinderResult(successExportResult())
+        completion.arm(FakePrivateExportDeathMonitor())
+
+        assertEquals(1, callbackCount)
+    }
+
+    @Test
+    fun exportDispatcherFailureDoesNotEscapeBinderCallback() {
+        var callbackCount = 0
+        val completion = PrivateExportCompletion(
+            onFinished = { callbackCount++ },
+            dispatcher = { throw IllegalStateException("dispatcher failure") },
+        )
+
+        completion.onBinderResult(successExportResult())
+        completion.arm(FakePrivateExportDeathMonitor())
+        completion.binderDied()
+
+        assertEquals(0, callbackCount)
+    }
+}
+
+private fun successExportResult() = R0dumpExportResult(
+    R0dumpOperationResult.OK,
+    "export-1",
+    "com.example.target",
+    7L,
+    3L,
+    128L,
+    "a".repeat(64),
+    false,
+)
+
+private class FakePrivateExportDeathMonitor(
+    private val failLink: Boolean = false,
+    private val onLink: ((IBinder.DeathRecipient) -> Unit)? = null,
+) : PrivateExportDeathMonitor {
+    val linkCount = AtomicInteger()
+    val unlinkCount = AtomicInteger()
+
+    override fun link(recipient: IBinder.DeathRecipient) {
+        linkCount.incrementAndGet()
+        if (failLink) throw RemoteException("dead binder")
+        onLink?.invoke(recipient)
+    }
+
+    override fun unlink(recipient: IBinder.DeathRecipient) {
+        unlinkCount.incrementAndGet()
+    }
+}
diff --git a/tools/final_acceptance.sh b/tools/final_acceptance.sh
new file mode 100755
index 0000000..0373a15
--- /dev/null
+++ b/tools/final_acceptance.sh
@@ -0,0 +1,128 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# R0dump Manager final acceptance wrapper.
+#
+# This script intentionally does NOT flash partitions. It is the reproducible
+# post-flash gate to run after the latest system.img has already been installed.
+# By default it is non-destructive: source checks + device/system identity + UI
+# smoke only. Broker mutations are deliberately not driven by this script. Use
+# --preflight-only before flashing to collect
+# current hashes without running the post-flash gate.
+#
+# Examples:
+#   ADB=adb ADB_HOST=127.0.0.1 ADB_PORT=5038 ADB_SERIAL=f5e3adbc \
+#     packages/apps/R0dumpManager/tools/final_acceptance.sh
+
+ADB="${ADB:-adb}"
+ADB_HOST="${ADB_HOST:-127.0.0.1}"
+ADB_PORT="${ADB_PORT:-5038}"
+ADB_SERIAL="${ADB_SERIAL:-f5e3adbc}"
+OUT_DIR="${OUT_DIR:-out/target/product/lemonade}"
+ROOT_DIR="${ROOT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)}"
+TOOLS_DIR="$ROOT_DIR/packages/apps/R0dumpManager/tools"
+ARTIFACT_DIR="${ARTIFACT_DIR:-/tmp/r0dump-manager-final-acceptance-$(date +%Y%m%d-%H%M%S)}"
+ALLOW_START_DUMP=0
+TARGET_PACKAGE="${TARGET_PACKAGE:-com.android.settings}"
+RESET_MANAGER_DATA=0
+PREFLIGHT_ONLY=0
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --allow-start-dump)
+      ALLOW_START_DUMP=1
+      shift
+      ;;
+    --target)
+      TARGET_PACKAGE="${2:?missing target package}"
+      shift 2
+      ;;
+    --reset-manager-data)
+      RESET_MANAGER_DATA=1
+      shift
+      ;;
+    --preflight-only)
+      PREFLIGHT_ONLY=1
+      shift
+      ;;
+    --artifact-dir)
+      ARTIFACT_DIR="${2:?missing artifact dir}"
+      shift 2
+      ;;
+    -h|--help)
+      sed -n '1,31p' "$0"
+      exit 0
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      exit 2
+      ;;
+  esac
+done
+
+mkdir -p "$ARTIFACT_DIR"
+
+log() { printf '\n== %s ==\n' "$*"; }
+adb_base=("$ADB" -H "$ADB_HOST" -P "$ADB_PORT" -s "$ADB_SERIAL")
+adb_device() { "${adb_base[@]}" "$@"; }
+
+log "tool configuration"
+{
+  echo "ROOT_DIR=$ROOT_DIR"
+  echo "OUT_DIR=$OUT_DIR"
+  echo "ADB=$ADB"
+  echo "ADB_ENDPOINT=$ADB_HOST:$ADB_PORT"
+  echo "ADB_SERIAL=$ADB_SERIAL"
+  echo "ARTIFACT_DIR=$ARTIFACT_DIR"
+  echo "TARGET_PACKAGE=$TARGET_PACKAGE"
+  echo "ALLOW_START_DUMP=$ALLOW_START_DUMP"
+  echo "RESET_MANAGER_DATA=$RESET_MANAGER_DATA"
+  echo "PREFLIGHT_ONLY=$PREFLIGHT_ONLY"
+} | tee "$ARTIFACT_DIR/final_acceptance_config.txt"
+
+log "source contracts"
+"$TOOLS_DIR/validate_source_contracts.sh" | tee "$ARTIFACT_DIR/source_contracts.txt"
+
+log "local artifact hashes"
+sha256sum \
+  "$OUT_DIR/system.img" \
+  "$OUT_DIR/system/priv-app/R0dumpManager/R0dumpManager.apk" \
+  "$OUT_DIR/system/etc/selinux/plat_sepolicy.cil" \
+  "$OUT_DIR/system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml" \
+  | tee "$ARTIFACT_DIR/local_hashes.txt"
+
+if [[ "$PREFLIGHT_ONLY" -eq 1 ]]; then
+  log "device preflight hashes"
+  {
+    "$ADB" -H "$ADB_HOST" -P "$ADB_PORT" devices -l || true
+    adb_device shell 'sha256sum /system/priv-app/R0dumpManager/R0dumpManager.apk 2>/dev/null || true' || true
+    adb_device shell 'sha256sum /system/etc/selinux/plat_sepolicy.cil 2>/dev/null || true' || true
+    adb_device shell 'sha256sum /system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml 2>/dev/null || true' || true
+  } | tee "$ARTIFACT_DIR/device_preflight_hashes.txt"
+  log "preflight summary"
+  cat <<SUMMARY | tee "$ARTIFACT_DIR/summary.txt"
+PASS: R0dumpManager final acceptance preflight completed
+Artifacts: $ARTIFACT_DIR
+Post-flash validation: skipped by --preflight-only
+SUMMARY
+  exit 0
+fi
+
+log "post-flash manager validation"
+post_args=(--require-system-match --target "$TARGET_PACKAGE" --artifact-dir "$ARTIFACT_DIR/post_flash")
+if [[ "$RESET_MANAGER_DATA" -eq 1 ]]; then
+  post_args+=(--reset-manager-data)
+fi
+if [[ "$ALLOW_START_DUMP" -eq 1 ]]; then
+  post_args+=(--allow-start-dump)
+fi
+ADB="$ADB" ADB_HOST="$ADB_HOST" ADB_PORT="$ADB_PORT" ADB_SERIAL="$ADB_SERIAL" \
+  OUT_DIR="$OUT_DIR" "$TOOLS_DIR/validate_post_flash.sh" "${post_args[@]}" \
+  | tee "$ARTIFACT_DIR/post_flash_validation.txt"
+
+log "final acceptance summary"
+cat <<SUMMARY | tee "$ARTIFACT_DIR/summary.txt"
+PASS: R0dumpManager final acceptance wrapper completed
+Artifacts: $ARTIFACT_DIR
+Broker status validation: enabled
+SUMMARY
diff --git a/tools/validate_post_flash.sh b/tools/validate_post_flash.sh
new file mode 100755
index 0000000..040cfa4
--- /dev/null
+++ b/tools/validate_post_flash.sh
@@ -0,0 +1,110 @@
+#!/usr/bin/env bash
+# R0dump Manager post-flash validation for the D-110 broker control boundary.
+set -euo pipefail
+
+ADB_BIN="${ADB:-adb}"
+ADB_HOST="${ADB_HOST:-127.0.0.1}"
+ADB_PORT="${ADB_PORT:-5038}"
+ADB_SERIAL="${ADB_SERIAL:-}"
+OUT_DIR="${OUT_DIR:-out/target/product/lemonade}"
+ARTIFACT_DIR="${ARTIFACT_DIR:-/tmp/r0dump-manager-validation}"
+REQUIRE_SYSTEM_MATCH=0
+RESET_MANAGER_DATA=0
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --require-system-match) REQUIRE_SYSTEM_MATCH=1 ;;
+    --reset-manager-data) RESET_MANAGER_DATA=1 ;;
+    --target|--allow-start-dump)
+      # The Manager owns mutations through Binder; this post-flash check is read-only.
+      [[ "$1" == "--target" ]] && shift
+      ;;
+    --artifact-dir) ARTIFACT_DIR="${2:?missing artifact dir}"; shift ;;
+    -h|--help) sed -n '1,24p' "$0"; exit 0 ;;
+    *) echo "unknown argument: $1" >&2; exit 2 ;;
+  esac
+  shift
+done
+
+mkdir -p "$ARTIFACT_DIR"
+log() { printf '\n== %s ==\n' "$*"; }
+adb_base=("$ADB_BIN" -H "$ADB_HOST" -P "$ADB_PORT")
+adb_host() { "${adb_base[@]}" "$@"; }
+adb_device() {
+  local args=("${adb_base[@]}")
+  [[ -n "$ADB_SERIAL" ]] && args+=(-s "$ADB_SERIAL")
+  args+=("$@")
+  "${args[@]}"
+}
+
+log "explicit adb 5038 contract"
+echo "endpoint=$ADB_HOST:$ADB_PORT" | tee "$ARTIFACT_DIR/adb_endpoint.txt"
+adb_host devices -l | tee "$ARTIFACT_DIR/devices.txt"
+if [[ -z "$ADB_SERIAL" ]]; then
+  ADB_SERIAL="$(awk '$2 == "device" { print $1 }' "$ARTIFACT_DIR/devices.txt")"
+fi
+[[ -n "$ADB_SERIAL" ]] || { echo "FAIL: no device on explicit adb endpoint $ADB_HOST:$ADB_PORT" >&2; exit 1; }
+[[ "$(grep -c "^$ADB_SERIAL[[:space:]]\+device" "$ARTIFACT_DIR/devices.txt")" -eq 1 ]] || {
+  echo "FAIL: expected exactly one device transport for serial $ADB_SERIAL" >&2; exit 1;
+}
+grep "^$ADB_SERIAL[[:space:]]" "$ARTIFACT_DIR/devices.txt" | tee "$ARTIFACT_DIR/device_transport.txt"
+adb_device shell 'cmd package list users >/dev/null' || {
+  echo "FAIL: selected device shell is not ready for package-manager checks" >&2; exit 1;
+}
+
+local_apk="$OUT_DIR/system/priv-app/R0dumpManager/R0dumpManager.apk"
+local_privapp="$OUT_DIR/system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml"
+if [[ "$REQUIRE_SYSTEM_MATCH" -eq 1 ]]; then
+  [[ -f "$local_apk" && -f "$local_privapp" ]] || { echo "FAIL: missing local Manager artifacts" >&2; exit 1; }
+  sha256sum "$local_apk" "$local_privapp" | tee "$ARTIFACT_DIR/local_hashes.txt"
+  adb_device shell 'sha256sum /system/priv-app/R0dumpManager/R0dumpManager.apk /system/etc/permissions/privapp-permissions-com.android.r0dumpmanager.xml' \
+    | tr -d '\r' | tee "$ARTIFACT_DIR/device_hashes.txt"
+  grep -q "$(sha256sum "$local_apk" | awk '{print $1}')" "$ARTIFACT_DIR/device_hashes.txt" || {
+    echo "FAIL: device Manager APK does not match local artifact" >&2; exit 1;
+  }
+  grep -q "$(sha256sum "$local_privapp" | awk '{print $1}')" "$ARTIFACT_DIR/device_hashes.txt" || {
+    echo "FAIL: device Manager privapp allowlist does not match local artifact" >&2; exit 1;
+  }
+fi
+
+log "broker binder service and status"
+adb_device shell service check r0dump | tr -d '\r' | tee "$ARTIFACT_DIR/service_check_r0dump.txt"
+grep -Eqi 'found|r0dump' "$ARTIFACT_DIR/service_check_r0dump.txt" || {
+  echo "FAIL: r0dump Binder service is unavailable" >&2; exit 1;
+}
+adb_device shell cmd r0dump status | tr -d '\r' | tee "$ARTIFACT_DIR/broker_status_before.txt"
+[[ -s "$ARTIFACT_DIR/broker_status_before.txt" ]] || { echo "FAIL: r0dump broker returned no status" >&2; exit 1; }
+for status_field in ready publish_allowed recovery_state; do
+  grep -q "${status_field}=" "$ARTIFACT_DIR/broker_status_before.txt" || {
+    echo "FAIL: r0dump broker status omitted $status_field" >&2; exit 1;
+  }
+done
+
+log "manager permission and read-only UI smoke"
+adb_device shell dumpsys package com.android.r0dumpmanager > "$ARTIFACT_DIR/package.txt"
+grep -q 'android.permission.MANAGE_R0DUMP: granted=true' "$ARTIFACT_DIR/package.txt" || {
+  echo "FAIL: MANAGE_R0DUMP is not granted to R0dumpManager" >&2; exit 1;
+}
+if [[ "$RESET_MANAGER_DATA" -eq 1 ]]; then
+  adb_device shell pm clear com.android.r0dumpmanager | tee "$ARTIFACT_DIR/manager_data_reset.txt"
+fi
+adb_device shell am force-stop com.android.r0dumpmanager
+adb_device shell am start -n com.android.r0dumpmanager/.MainActivity >/dev/null
+sleep 2
+adb_device shell uiautomator dump /sdcard/r0dump_manager_broker_status.xml >/dev/null
+adb_device pull /sdcard/r0dump_manager_broker_status.xml "$ARTIFACT_DIR/manager_broker_status.xml" >/dev/null
+grep -q 'Broker Status' "$ARTIFACT_DIR/manager_broker_status.xml" || {
+  echo "FAIL: Manager UI does not expose broker status" >&2; exit 1;
+}
+adb_device shell cmd r0dump status | tr -d '\r' | tee "$ARTIFACT_DIR/broker_status_after.txt"
+for status_field in ready publish_allowed recovery_state; do
+  grep -q "${status_field}=" "$ARTIFACT_DIR/broker_status_after.txt" || {
+    echo "FAIL: post-open r0dump broker status omitted $status_field" >&2; exit 1;
+  }
+done
+cmp -s "$ARTIFACT_DIR/broker_status_before.txt" "$ARTIFACT_DIR/broker_status_after.txt" || {
+  echo "FAIL: read-only Manager open changed broker status" >&2; exit 1;
+}
+
+echo "PASS: R0dumpManager broker post-flash validation completed"
+echo "Artifacts: $ARTIFACT_DIR"
