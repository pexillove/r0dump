+private fun buildAdbCommands(state: R0dumpUiState, targetPackage: String, targetLaunchable: Boolean): String {
+    val lines = mutableListOf<String>()
+    lines += "# r0dump broker diagnostics (read-only)"
+    lines += "# Start and Stop are only available through the R0dump Manager broker control API."
+    lines += "adb logcat -s r0dump"
+    lines += "adb shell cmd r0dump status"
+    lines += "# selected target: $targetPackage (${if (targetLaunchable) "launchable" else "no launcher"})"
+    lines += "# broker generation: ${state.generation ?: "unavailable"}"
+    return lines.joinToString("\n")
+}
