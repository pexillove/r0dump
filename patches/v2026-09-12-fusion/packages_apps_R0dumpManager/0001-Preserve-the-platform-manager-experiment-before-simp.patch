+@Composable
+private fun ActionsScreen(state: R0dumpUiState, viewModel: R0dumpManagerViewModel) {
+    val haptic = LocalHapticFeedback.current
+    val context = LocalContext.current
+    var pendingOperation by remember { mutableStateOf<SystemOperation?>(null) }
+    val targetPackage = state.selectedApplication?.packageName ?: "<package>"
+    val operations = state.selectedApplication?.operations ?: R0dumpConfigRegistry.operations
+    val targetLaunchable = state.selectedApplication?.launchable == true
+    val adbCommands = remember(state, targetPackage, targetLaunchable) {
+        buildAdbCommands(state, targetPackage, targetLaunchable)
+    }
+    val adbCommandLineCount = remember(adbCommands) { adbCommands.lineSequence().count() }
+
+    fun runOperation(operation: SystemOperation) {
+        if (state.configState == ConfigState.Updating || state.actionInFlight || state.selectedApplication == null) return
+        when (operation) {
+            SystemOperation.ReloadCurrentProperties -> viewModel.reloadCurrentProperties()
+            SystemOperation.LaunchTarget -> viewModel.launchTarget()
+            SystemOperation.ForceStopTarget -> {
+                haptic.performHapticFeedback(HapticFeedbackType.LongPress)
+                viewModel.forceStopTarget()
+            }
+            SystemOperation.PublishDisabledConfig -> viewModel.stopDump()
+            SystemOperation.RestoreDefaults -> {
+                haptic.performHapticFeedback(HapticFeedbackType.LongPress)
+                viewModel.restoreDefaults()
+            }
+            SystemOperation.CopyAdbCommands -> {
+                copyTextToClipboard(context, "r0dump adb commands", adbCommands)
+                viewModel.recordAdbCommandsCopied()
+            }
+        }
+    }
+
+    fun requestOperation(operation: SystemOperation) {
+        if (state.configState == ConfigState.Updating || state.actionInFlight || state.selectedApplication == null) return
+        if (operation.destructive) {
+            haptic.performHapticFeedback(HapticFeedbackType.LongPress)
+            pendingOperation = operation
+        } else {
+            runOperation(operation)
+        }
+    }
+
+    pendingOperation?.let { operation ->
+        AlertDialog(
+            onDismissRequest = { pendingOperation = null },
+            title = { Text(operation.title) },
+            text = { Text("${operation.description}\n\nTarget: ${state.selectedApplication?.contextLabel() ?: "No target selected"}") },
+            confirmButton = {
+                Button(
+                    onClick = {
+                        pendingOperation = null
+                        runOperation(operation)
+                    },
+                ) {
+                    Text("Confirm")
+                }
+            },
+            dismissButton = {
+                OutlinedButton(onClick = { pendingOperation = null }) {
+                    Text("Cancel")
+                }
+            },
+        )
+    }
+
+    val sections = ActionSection.values().mapNotNull { section ->
+        val sectionOperations = operations.filter { it.section == section }
+        if (sectionOperations.isEmpty()) null else section to sectionOperations
+    }
+
+    LazyColumn(
+        modifier = Modifier.fillMaxSize(),
+        contentPadding = androidx.compose.foundation.layout.PaddingValues(16.dp),
+        verticalArrangement = Arrangement.spacedBy(16.dp),
+    ) {
+        item { PageHeader("Actions", "System operations", state.selectedApplication?.contextLabel()) }
+        item { CompactTargetSelectorCard(state.applications, state.selectedApplication, viewModel::selectApplication, state.configState != ConfigState.Updating && !state.actionInFlight) }
+        sections.forEach { (section, sectionOperations) ->
+            if (section == ActionSection.Debug) {
+                item {
+                    CollapsibleGroupCard(
+                        title = section.title,
+                        summary = sectionOperations.joinToString(" · ") { it.title },
+                        defaultExpanded = false,
+                    ) {
+                        sectionOperations.forEachIndexed { index, operation ->
+                            val enabled = state.configState != ConfigState.Updating && !state.actionInFlight && state.selectedApplication != null
+                            val supportText = when {
+                                state.configState == ConfigState.Updating -> "Configuration update is running"
+                                state.actionInFlight -> "Action is running"
+                                state.selectedApplication == null -> "No target selected"
+                                else -> null
+                            }
+                            ActionCard(operation, operation.marker, operation.accentColor(), enabled, supportText) {
+                                requestOperation(operation)
+                            }
+                            if (index != sectionOperations.lastIndex) Spacer(Modifier.height(12.dp))
+                        }
+                        Spacer(Modifier.height(12.dp))
+                        InlineCollapsibleSection(
+                            title = "ADB Command Preview",
+                            summary = "$adbCommandLineCount lines · inspect generated commands before copying",
+                            defaultExpanded = false,
+                        ) {
+                            Text(
+                                adbCommands,
+                                style = MaterialTheme.typography.bodySmall,
+                                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                            )
+                        }
+                    }
+                }
+            } else {
+                item { Text(section.title, style = MaterialTheme.typography.titleMedium, color = MaterialTheme.colorScheme.primary) }
+                items(sectionOperations) { operation ->
+                    val enabled = state.configState != ConfigState.Updating &&
+                        !state.actionInFlight &&
+                        state.selectedApplication != null &&
+                        (operation != SystemOperation.LaunchTarget || state.selectedApplication.launchable)
+                    val supportText = when {
+                        state.configState == ConfigState.Updating -> "Configuration update is running"
+                        state.actionInFlight -> "Action is running"
+                        state.selectedApplication == null -> "No target selected"
+                        operation == SystemOperation.LaunchTarget && !state.selectedApplication.launchable -> "No launcher activity"
+                        else -> null
+                    }
+                    ActionCard(operation, operation.marker, operation.accentColor(), enabled, supportText) {
+                        requestOperation(operation)
+                    }
+                }
+            }
+        }
+    }
+}
