+package com.android.r0dumpmanager
+
+import android.os.Bundle
+import androidx.activity.ComponentActivity
+import androidx.activity.compose.setContent
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.saveable.rememberSaveable
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.viewmodel.compose.viewModel
+import com.android.r0dumpmanager.app.R0dumpManagerViewModel
+import com.android.r0dumpmanager.ui.MainScreen
+import com.android.r0dumpmanager.ui.theme.R0dumpManagerTheme
+import com.android.r0dumpmanager.ui.welcome.WelcomeScreen
+
+class MainActivity : ComponentActivity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        window.setDecorFitsSystemWindows(false)
+        val preferences = getSharedPreferences(PREFS_NAME, MODE_PRIVATE)
+        setContent {
+            R0dumpManagerRoot(
+                initialShowWelcome = !preferences.getBoolean(KEY_WELCOME_DONE, false),
+                onWelcomeEntered = {
+                    preferences.edit().putBoolean(KEY_WELCOME_DONE, true).commit()
+                },
+            )
+        }
+    }
+}
+
+@Composable
+private fun R0dumpManagerRoot(
+    initialShowWelcome: Boolean,
+    onWelcomeEntered: () -> Unit,
+) {
+    R0dumpManagerTheme {
+        val viewModel: R0dumpManagerViewModel = viewModel()
+        var showWelcome by rememberSaveable { mutableStateOf(initialShowWelcome) }
+        if (showWelcome) {
+            WelcomeScreen(
+                onEnter = {
+                    onWelcomeEntered()
+                    showWelcome = false
+                },
+            )
+        } else {
+            MainScreen(viewModel)
+        }
+    }
+}
+
+private const val PREFS_NAME = "r0dump_manager_prefs"
+private const val KEY_WELCOME_DONE = "welcome_done"
diff --git a/src/com/android/r0dumpmanager/app/R0dumpManagerViewModel.kt b/src/com/android/r0dumpmanager/app/R0dumpManagerViewModel.kt
new file mode 100644
index 0000000..fdd8206
--- /dev/null
+++ b/src/com/android/r0dumpmanager/app/R0dumpManagerViewModel.kt
@@ -0,0 +1,525 @@
+package com.android.r0dumpmanager.app
+
+import android.app.Application
+import android.content.Context
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import com.android.r0dumpmanager.data.control.BrokerStatus
+import com.android.r0dumpmanager.data.control.R0dumpControlRepository
+import com.android.r0dumpmanager.data.log.ConfigAuditStore
+import com.android.r0dumpmanager.data.logcat.R0dumpLogcatRepository
+import com.android.r0dumpmanager.data.packageinfo.PackageRepository
+import com.android.r0dumpmanager.data.reader.PrivateReaderGate
+import com.android.r0dumpmanager.data.reader.PrivateReaderUiState
+import com.android.r0dumpmanager.data.reader.PrivateReaderAvailability
+import com.android.r0dumpmanager.data.reader.R0dumpPrivateStoreRepository
+import com.android.r0dumpmanager.domain.config.ConfigApplication
+import com.android.r0dumpmanager.domain.config.ConfigState
+import com.android.r0dumpmanager.domain.config.DumpPointRegistry
+import com.android.r0dumpmanager.domain.config.FusionConfig
+import com.android.r0dumpmanager.domain.config.FusionConfigValidator
+import com.android.r0dumpmanager.domain.config.R0dumpConfigRegistry
+import com.android.r0dumpmanager.domain.log.ConfigLog
+import com.android.r0dumpmanager.domain.log.LogType
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicLong
+
+private const val STATE_FEEDBACK_MS = 2200L
+private const val PREFS_NAME = "r0dump_manager_prefs"
+private const val KEY_SELECTED_TARGET_PACKAGE = "selected_target_package"
+private const val PRIVATE_READER_PAGE_SIZE = 50
+
+data class R0dumpUiState(
+    val selectedApplication: ConfigApplication? = null,
+    val applications: List<ConfigApplication> = emptyList(),
+    val selectedBits: Set<Int> = emptySet(),
+    val enabled: Boolean = false,
+    val forceStopBeforeLaunch: Boolean = true,
+    val configState: ConfigState = ConfigState.Idle,
+    val actionInFlight: Boolean = false,
+    val brokerStatus: BrokerStatus? = null,
+    val capabilityMask: Long? = null,
+    val privateReader: PrivateReaderUiState = PrivateReaderUiState(),
+    val auditLogs: List<ConfigLog> = emptyList(),
+    val runtimeLogs: List<String> = emptyList(),
+    val message: String? = null,
+    val messageSerial: Long = 0L,
+) {
+    val mask: Int = DumpPointRegistry.maskFor(selectedBits)
+    val maskText: String = "0x" + (mask.toLong() and 0xffffffffL).toString(16).padStart(8, '0')
+    val generation: Long? = brokerStatus?.generation
+    val generationStable: Boolean = generation?.let { (it and 1L) == 0L } ?: true
+    val generationText: String = generation?.toString() ?: "<unset>"
+    val watchPackage: String? = brokerStatus?.packageName
+    // capabilityMask controls optional reader/Evidence features, not passive package+mask control.
+    val canPublish: Boolean = brokerStatus?.ready == true && brokerStatus.publishAllowed
+    val canStop: Boolean = brokerStatus?.ready == true && brokerStatus.active
+    val privateReaderStatus: String = privateReader.message ?: "Verified private store is ready"
+}
+
+private fun R0dumpUiState.withMessage(message: String?): R0dumpUiState =
+    if (message.isNullOrBlank()) {
+        copy(message = null)
+    } else {
+        copy(message = message, messageSerial = messageSerial + 1L)
+    }
+
+class R0dumpManagerViewModel(application: Application) : AndroidViewModel(application) {
+    private val controlRepository = R0dumpControlRepository()
+    private val preferences = application.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+    private val auditStore = ConfigAuditStore(application)
+    private val logcatRepository = R0dumpLogcatRepository()
+    private val packageRepository = PackageRepository(application)
+    private val privateStoreRepository = R0dumpPrivateStoreRepository()
+    private val operationInFlight = AtomicBoolean(false)
+    private val configOperationInFlight = AtomicBoolean(false)
+    private val actionOperationInFlight = AtomicBoolean(false)
+    private val selectionVersion = AtomicLong(0L)
+
+    private val _uiState = MutableStateFlow(R0dumpUiState())
+    val uiState: StateFlow<R0dumpUiState> = _uiState.asStateFlow()
+
+    init {
+        refreshAll()
+    }
+
+    fun refreshAll() {
+        viewModelScope.launch(Dispatchers.IO) {
+            refreshAllNow()
+        }
+    }
+
+    private suspend fun refreshAllNow(
+        preferredPackageName: String? = null,
+        expectedSelectionVersion: Long? = null,
+    ) {
+        val applications = packageRepository.loadInstalledApplications(R0dumpConfigRegistry.groups, R0dumpConfigRegistry.operations)
+        val brokerStatus = controlRepository.status().getOrNull()
+        val capabilityMask = controlRepository.capabilityMask().getOrNull()
+        if (expectedSelectionVersion != null && selectionVersion.get() != expectedSelectionVersion) return
+        val watchPackage = brokerStatus?.packageName.orEmpty()
+        val persistedPackage = preferences.getString(KEY_SELECTED_TARGET_PACKAGE, "").orEmpty()
+        val selected = preferredPackageName?.let { requested ->
+            applications.firstOrNull { it.packageName == requested }
+        } ?: _uiState.value.selectedApplication?.let { old ->
+            applications.firstOrNull { it.packageName == old.packageName }
+        } ?: applications.firstOrNull { it.packageName == persistedPackage }
+            ?: applications.firstOrNull { it.packageName == watchPackage }
+            ?: applications.firstOrNull()
+        val logs = auditStore.readRecent(packageName = selected?.packageName)
+        val runtimeLogs = logcatRepository.readRecent().getOrElse { listOf("logcat unavailable: ${it.message}", "adb logcat -s r0dump") }
+        val indexGeneration = brokerStatus?.indexGeneration ?: -1L
+        val readerGate = PrivateReaderGate.state(
+            brokerStatus?.recoveryState,
+            capabilityMask,
+            indexGeneration,
+        )
+        val privateReader = if (readerGate.canRead && selected != null) {
+            privateStoreRepository.listRuns(
+                packageName = selected.packageName,
+                expectedIndexGeneration = indexGeneration,
+                cursor = null,
+                pageSize = PRIVATE_READER_PAGE_SIZE,
+            ).fold(
+                onSuccess = { page ->
+                    readerGate.copy(
+                        indexGeneration = page.indexGeneration,
+                        runs = page.items,
+                        nextCursor = page.nextCursor,
+                    )
+                },
+                onFailure = {
+                    PrivateReaderUiState(
+                        availability = PrivateReaderAvailability.UNAVAILABLE,
+                        message = "Verified private store is unavailable",
+                    )
+                },
+            )
+        } else {
+            readerGate
+        }
+        if (expectedSelectionVersion != null && selectionVersion.get() != expectedSelectionVersion) return
+        _uiState.update {
+            it.copy(
+                applications = applications,
+                selectedApplication = selected,
+                enabled = brokerStatus?.active ?: false,
+                brokerStatus = brokerStatus,
+                capabilityMask = capabilityMask,
+                privateReader = privateReader,
+                auditLogs = logs,
+                runtimeLogs = runtimeLogs,
+            )
+        }
+    }
+
+    fun selectApplication(application: ConfigApplication) {
+        if (isOperationBusy()) return
+        val version = selectionVersion.incrementAndGet()
+        preferences.edit().putString(KEY_SELECTED_TARGET_PACKAGE, application.packageName).apply()
+        _uiState.update { it.copy(selectedApplication = application) }
+        viewModelScope.launch(Dispatchers.IO) {
+            refreshAllNow(
+                preferredPackageName = application.packageName,
+                expectedSelectionVersion = version,
+            )
+        }
+    }
+
+    fun toggleDumpPoint(bit: Int) {
+        if (isOperationBusy() || !_uiState.value.canPublish) return
+        _uiState.update { state ->
+            val bits = if (bit in state.selectedBits) state.selectedBits - bit else state.selectedBits + bit
+            state.copy(
+                selectedBits = bits,
+            )
+        }
+    }
+
+    fun applyPreset(name: String) {
+        if (isOperationBusy() || !_uiState.value.canPublish) return
+        val bits = when (name) {
+            "key" -> DumpPointRegistry.points.filter { it.shortName in DumpPointRegistry.keyPoints }.map { it.bit }.toSet()
+            "active" -> setOf(1)
+            "all" -> DumpPointRegistry.points.map { it.bit }.toSet()
+            else -> emptySet()
+        }
+        _uiState.update { state ->
+            state.copy(
+                selectedBits = bits,
+            )
+        }
+    }
+
+    fun setForceStopBeforeLaunch(value: Boolean) {
+        if (isOperationBusy()) return
+        _uiState.update { it.copy(forceStopBeforeLaunch = value) }
+    }
+
+    fun consumeMessage(messageSerial: Long) {
+        _uiState.update { state ->
+            if (state.messageSerial == messageSerial) state.copy(message = null) else state
+        }
+    }
+
+    fun startDump() {
+        if (isOperationBusy()) return showBusyMessage()
+        val state = _uiState.value
+        val app = state.selectedApplication ?: return showMessage("Select a target application first")
+        if (!state.canPublish) return showError("Broker is not ready or does not allow publishing")
+        if (!app.launchable) {
+            return showStartPreflightError(app, "Selected application has no launcher activity")
+        }
+        val config = FusionConfig(
+            watchPackage = app.packageName,
+            dumpPointMask = state.mask,
+        )
+        val validation = FusionConfigValidator.validateForStart(config)
+        if (!validation.ok) return showStartPreflightError(app, validation.message)
+        if (!beginConfigOperation()) return
+        viewModelScope.launch(Dispatchers.IO) {
+            try {
+                _uiState.update { it.copy(configState = ConfigState.Updating, message = null) }
+                val beforeStatus = controlRepository.status().getOrThrow()
+                val result = controlRepository.publish(app.packageName, state.mask, beforeStatus.generation)
+                if (result.isSuccess) {
+                    val verifiedStatus = controlRepository.verifyStatus(result.getOrThrow()).getOrThrow()
+                    var workflowOk = true
+                    val messages = mutableListOf("Dump configuration published through broker")
+                    if (state.forceStopBeforeLaunch) {
+                        val forceStopResult = packageRepository.forceStop(app.packageName)
+                        if (forceStopResult.isFailure) {
+                            workflowOk = false
+                            messages += "force-stop failed: ${forceStopResult.exceptionOrNull()?.message ?: "unknown"}"
+                        }
+                    }
+                    val launchResult = packageRepository.launch(app.packageName)
+                    if (launchResult.isFailure) {
+                        workflowOk = false
+                        messages += "launch failed: ${launchResult.exceptionOrNull()?.message ?: "unknown"}"
+                    }
+                    val message = if (workflowOk) "Dump started" else messages.joinToString("; ")
+                    appendLog(app, if (workflowOk) LogType.OPERATION else LogType.ERROR, "broker.active", beforeStatus.active.toString(), "true", workflowOk, message)
+                    val nextState = if (workflowOk) ConfigState.Success else ConfigState.Error(message)
+                    _uiState.update {
+                        it.copy(
+                            enabled = verifiedStatus.active,
+                            brokerStatus = verifiedStatus,
+                            configState = nextState,
+                        ).withMessage(message)
+                    }
+                    settleConfigState(nextState)
+                } else {
+                    appendLog(app, LogType.ERROR, "broker.active", "false", "true", false, result.exceptionOrNull()?.message)
+                    val errorState = ConfigState.Error(result.exceptionOrNull()?.message ?: "Publish failed")
+                    _uiState.update { it.copy(configState = errorState).withMessage(errorState.message) }
+                    settleConfigState(errorState)
+                }
+                refreshAllNow()
+            } catch (error: Throwable) {
+                val message = error.message ?: "r0dump broker publish failed"
+                appendLog(app, LogType.ERROR, "broker.active", "false", "true", false, message)
+                setFeedbackState(ConfigState.Error(message), message)
+            } finally {
+                finishConfigOperation()
+            }
+        }
+    }
+
+    fun stopDump() {
+        publishDisabledSnapshot(successMessage = "Dump stopped", uiSuccessMessage = "Disabled snapshot published")
+    }
+
+    private fun publishDisabledSnapshot(successMessage: String, uiSuccessMessage: String) {
+        if (isOperationBusy()) return showBusyMessage()
+        val state = _uiState.value
+        val app = state.selectedApplication ?: return showMessage("Select a target application first")
+        if (!state.canStop) return showError("Broker is not ready with an active dump to stop")
+        val shouldForceStopTarget = state.forceStopBeforeLaunch
+        if (!beginConfigOperation()) return
+        viewModelScope.launch(Dispatchers.IO) {
+            try {
+                _uiState.update { it.copy(configState = ConfigState.Updating, message = null) }
+                val beforeStatus = controlRepository.status().getOrThrow()
+                val result = if (beforeStatus.active) {
+                    controlRepository.stop(beforeStatus.runId, beforeStatus.generation)
+                } else {
+                    Result.success(beforeStatus)
+                }
+                val verifiedStatus = if (result.isSuccess) {
+                    controlRepository.verifyStatus(result.getOrThrow()).getOrThrow()
+                } else {
+                    beforeStatus
+                }
+                var workflowOk = result.isSuccess
+                var operationMessage = result.exceptionOrNull()?.message ?: successMessage
+                var uiMessage = if (result.isSuccess) uiSuccessMessage else result.exceptionOrNull()?.message
+                if (result.isSuccess && shouldForceStopTarget) {
+                    val forceStopResult = packageRepository.forceStop(app.packageName)
+                    if (forceStopResult.isSuccess) {
+                        operationMessage = "$successMessage; target force-stopped"
+                        uiMessage = "$uiSuccessMessage; target force-stopped"
+                    } else {
+                        workflowOk = false
+                        val reason = forceStopResult.exceptionOrNull()?.message ?: "unknown"
+                        operationMessage = "$successMessage; force-stop failed: $reason"
+                        uiMessage = operationMessage
+                    }
+                }
+                appendLog(app, if (workflowOk) LogType.OPERATION else LogType.ERROR, "broker.active", beforeStatus.active.toString(), "false", workflowOk, operationMessage)
+                val nextState = if (workflowOk) ConfigState.Success else ConfigState.Error(operationMessage)
+                _uiState.update {
+                    it.copy(
+                        enabled = verifiedStatus.active,
+                        brokerStatus = verifiedStatus,
+                        configState = nextState,
+                    ).withMessage(uiMessage)
+                }
+                settleConfigState(nextState)
+                refreshAllNow()
+            } catch (error: Throwable) {
+                val message = error.message ?: "r0dump broker stop failed"
+                appendLog(app, LogType.ERROR, "broker.active", "true", "false", false, message)
+                setFeedbackState(ConfigState.Error(message), message)
+            } finally {
+                finishConfigOperation()
+            }
+        }
+    }
+
+    fun restoreDefaults() {
+        publishDisabledSnapshot(successMessage = "Defaults restored", uiSuccessMessage = "Defaults restored")
+    }
+
+    fun reloadCurrentProperties() {
+        val app = _uiState.value.selectedApplication ?: return showMessage("Select a target application first")
+        if (!beginActionOperation()) return
+        viewModelScope.launch(Dispatchers.IO) {
+            try {
+                val message = "Configuration reloaded"
+                appendLog(app, LogType.OPERATION, null, null, null, true, message)
+                refreshAllNow()
+                showMessage(message)
+            } finally {
+                finishActionOperation()
+            }
+        }
+    }
+
+    fun recordAdbCommandsCopied() {
+        val app = _uiState.value.selectedApplication ?: return showMessage("Select a target application first")
+        if (!beginActionOperation()) return
+        viewModelScope.launch(Dispatchers.IO) {
+            try {
+                val message = "adb commands copied"
+                appendLog(app, LogType.OPERATION, null, null, null, true, message)
+                showMessage(message)
+            } finally {
+                finishActionOperation()
+            }
+        }
+    }
+
+    fun launchTarget() {
+        val app = _uiState.value.selectedApplication ?: return showMessage("Select a target application first")
+        if (!beginActionOperation()) return
+        if (!app.launchable) {
+            val message = "Selected application has no launcher activity"
+            viewModelScope.launch(Dispatchers.IO) {
+                try {
+                    appendLog(app, LogType.ERROR, null, null, null, false, message)
+                    showError(message)
+                } finally {
+                    finishActionOperation()
+                }
+            }
+            return
+        }
+        viewModelScope.launch(Dispatchers.IO) {
+            try {
+                val result = packageRepository.launch(app.packageName)
+                val message = result.exceptionOrNull()?.message ?: "Target launched"
+                appendLog(app, if (result.isSuccess) LogType.OPERATION else LogType.ERROR, null, null, null, result.isSuccess, message)
+                refreshAllNow()
+                showOperationFeedback(result.isSuccess, message)
+            } finally {
+                finishActionOperation()
+            }
+        }
+    }
+
+    fun forceStopTarget() {
+        val app = _uiState.value.selectedApplication ?: return showMessage("Select a target application first")
+        if (!beginActionOperation()) return
+        viewModelScope.launch(Dispatchers.IO) {
+            try {
+                val result = packageRepository.forceStop(app.packageName)
+                val message = result.exceptionOrNull()?.message ?: "Target stopped"
+                appendLog(app, if (result.isSuccess) LogType.OPERATION else LogType.ERROR, null, null, null, result.isSuccess, message)
+                refreshAllNow()
+                showOperationFeedback(result.isSuccess, message)
+            } finally {
+                finishActionOperation()
+            }
+        }
+    }
+
+    private fun beginConfigOperation(): Boolean {
+        if (!operationInFlight.compareAndSet(false, true)) {
+            showBusyMessage()
+            return false
+        }
+        configOperationInFlight.set(true)
+        return true
+    }
+
+    private fun finishConfigOperation() {
+        configOperationInFlight.set(false)
+        operationInFlight.set(false)
+    }
+
+    private fun beginActionOperation(): Boolean {
+        if (!operationInFlight.compareAndSet(false, true)) {
+            showBusyMessage()
+            return false
+        }
+        actionOperationInFlight.set(true)
+        _uiState.update { it.copy(actionInFlight = true) }
+        return true
+    }
+
+    private fun finishActionOperation() {
+        actionOperationInFlight.set(false)
+        _uiState.update { it.copy(actionInFlight = false) }
+        operationInFlight.set(false)
+    }
+
+    private fun isOperationBusy(): Boolean = operationInFlight.get()
+
+    private fun showBusyMessage() {
+        showMessage(if (actionOperationInFlight.get()) "Action is already running" else "Configuration update is already running")
+    }
+
+    private fun appendLogAsync(app: ConfigApplication, type: LogType, key: String?, old: String?, new: String?, ok: Boolean, message: String?) {
+        viewModelScope.launch(Dispatchers.IO) {
+            appendLog(app, type, key, old, new, ok, message)
+        }
+    }
+
+    private fun appendLog(app: ConfigApplication, type: LogType, key: String?, old: String?, new: String?, ok: Boolean, message: String?) {
+        appendLogs(
+            listOf(
+                ConfigLog(
+                    timestamp = System.currentTimeMillis(),
+                    applicationId = app.id,
+                    packageName = app.packageName,
+                    type = type,
+                    key = key,
+                    oldValue = old,
+                    newValue = new,
+                    result = ok,
+                    message = message,
+                ),
+            ),
+        )
+    }
+
+    private fun appendLogs(logs: List<ConfigLog>) {
+        if (logs.isEmpty()) return
+        auditStore.appendAll(logs)
+        val selectedPackage = _uiState.value.selectedApplication?.packageName
+        _uiState.update { it.copy(auditLogs = auditStore.readRecent(packageName = selectedPackage)) }
+    }
+
+    private fun settleConfigState(expected: ConfigState) {
+        viewModelScope.launch {
+            delay(STATE_FEEDBACK_MS)
+            _uiState.update { state ->
+                if (state.configState == expected) {
+                    state.copy(configState = ConfigState.Idle)
+                } else {
+                    state
+                }
+            }
+        }
+    }
+
+    private fun setFeedbackState(configState: ConfigState, message: String?) {
+        _uiState.update { it.copy(configState = configState).withMessage(message) }
+        when (configState) {
+            ConfigState.Success,
+            is ConfigState.Error -> settleConfigState(configState)
+            ConfigState.Idle,
+            ConfigState.Updating -> Unit
+        }
+    }
+
+
+    private fun showOperationFeedback(ok: Boolean, message: String) {
+        if (ok) {
+            showMessage(message)
+        } else {
+            showError(message)
+        }
+    }
+
+    private fun showMessage(message: String) {
+        _uiState.update { it.withMessage(message) }
+    }
+
+    private fun showError(message: String) {
+        setFeedbackState(ConfigState.Error(message), message)
+    }
+
+    private fun showStartPreflightError(app: ConfigApplication, message: String) {
+        appendLogAsync(app, LogType.ERROR, "broker.active", "false", "true", false, message)
+        showError(message)
+    }
+}
diff --git a/src/com/android/r0dumpmanager/data/control/R0dumpControlRepository.kt b/src/com/android/r0dumpmanager/data/control/R0dumpControlRepository.kt
new file mode 100644
