+@Composable
+private fun RuntimeCard(state: R0dumpUiState, viewModel: R0dumpManagerViewModel) {
+    val updating = state.configState == ConfigState.Updating || state.actionInFlight
+    val canPublish = state.canPublish && !updating
+    val haptic = LocalHapticFeedback.current
+    LaunchedEffect(state.configState) {
+        when (state.configState) {
+            ConfigState.Success,
+            is ConfigState.Error -> haptic.performHapticFeedback(HapticFeedbackType.LongPress)
+            ConfigState.Idle,
+            ConfigState.Updating -> Unit
+        }
+    }
+    GroupCard(title = "Runtime") {
+        ConfigRow("Dump Status", state.dumpStatusDescription().withApplyModeHint(ApplyMode.PROCESS_RESTART)) {
+            Text(
+                if (state.enabled) "ON" else "OFF",
+                color = if (state.enabled) successColor() else MaterialTheme.colorScheme.onSurfaceVariant,
+                fontWeight = FontWeight.Medium,
+            )
+        }
+        DividerInset()
+        ConfigRow("Enable Dump", "Publish Fusion config and launch target".withApplyModeHint(ApplyMode.PROCESS_RESTART)) {
+            Button(onClick = viewModel::startDump, enabled = canPublish) { Text("Start") }
+        }
+        DividerInset()
+        ConfigRow("Force-stop before launch", "Required when target process is already alive") {
+            Switch(checked = state.forceStopBeforeLaunch, onCheckedChange = viewModel::setForceStopBeforeLaunch, enabled = !updating)
+        }
+        if (!state.forceStopBeforeLaunch) {
+            Text(
+                "Warning: an already-running target process may not read this new config until it restarts.",
+                style = MaterialTheme.typography.labelMedium,
+                color = warningColor(),
+                modifier = Modifier.padding(start = 40.dp, top = 4.dp, bottom = 4.dp),
+            )
+        }
+        DividerInset()
+        ConfigRow("Current mask", "${state.maskText} · ${state.selectedBits.size}/28 points".withApplyModeHint(ApplyMode.PROCESS_RESTART)) {
+            OutlinedButton(onClick = viewModel::stopDump, enabled = state.canStop && !updating) { Text("Stop") }
+        }
+        DividerInset()
+        ConfigRow("Generation", if (state.generationStable) "stable even generation" else "updating or incomplete odd generation") {
+            Text(
+                state.generationText,
+                color = if (state.generationStable) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.error,
+                fontWeight = FontWeight.Medium,
+            )
+        }
+        if (!state.canPublish) {
+            DividerInset()
+            Text(
+                "Capture controls are unavailable until the broker is ready and allows publishing.",
+                style = MaterialTheme.typography.labelMedium,
+                color = warningColor(),
+            )
+        }
+        StateLine(state.configState)
+    }
+}
