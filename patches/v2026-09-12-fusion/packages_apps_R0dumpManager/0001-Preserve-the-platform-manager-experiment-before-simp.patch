+@Composable
+private fun AppIcon(text: String, packageName: String?) {
+    val context = LocalContext.current
+    val density = LocalDensity.current
+    val paddingPx = with(density) { 6.dp.roundToPx() }
+    val icon = remember(packageName) {
+        packageName?.let { name ->
+            runCatching { context.packageManager.getApplicationIcon(name) }.getOrNull()
+        }
+    }
+
+    if (icon == null) {
+        AppMonogram(text)
+        return
+    }
+
+    AndroidView(
+        modifier = Modifier
+            .size(40.dp)
+            .clip(CircleShape)
+            .background(MaterialTheme.colorScheme.primaryContainer),
+        factory = { viewContext ->
+            ImageView(viewContext).apply {
+                scaleType = ImageView.ScaleType.CENTER_INSIDE
+                setPadding(paddingPx, paddingPx, paddingPx, paddingPx)
+            }
+        },
+        update = { imageView ->
+            imageView.setPadding(paddingPx, paddingPx, paddingPx, paddingPx)
+            imageView.setImageDrawable(icon.constantState?.newDrawable() ?: icon)
+        },
+    )
+}
