@@ -0,0 +1,57 @@
+package com.android.r0dumpmanager.data.packageinfo
+
+import android.app.ActivityManager
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import com.android.r0dumpmanager.domain.config.ConfigApplication
+import com.android.r0dumpmanager.domain.config.ConfigGroup
+import com.android.r0dumpmanager.domain.operation.SystemOperation
+
+class PackageRepository(
+    private val context: Context,
+) {
+    private val packageManager = context.packageManager
+
+    fun loadInstalledApplications(groups: List<ConfigGroup>, operations: List<SystemOperation>): List<ConfigApplication> = packageManager
+        .getInstalledApplications(PackageManager.MATCH_ALL)
+        .mapNotNull { applicationInfo ->
+            val packageName = applicationInfo.packageName ?: return@mapNotNull null
+            if (packageName == context.packageName) return@mapNotNull null
+            val launchable = packageManager.getLaunchIntentForPackage(packageName) != null
+            ConfigApplication(
+                id = packageName,
+                label = applicationInfo.loadLabel(packageManager)?.toString() ?: packageName,
+                packageName = packageName,
+                description = applicationInfo.sourceDir,
+                configGroups = groups,
+                operations = supportedOperations(operations, launchable),
+                launchable = launchable,
+            )
+        }
+        .distinctBy { it.packageName }
+        .sortedWith(
+            compareByDescending<ConfigApplication> { it.launchable }
+                .thenBy(String.CASE_INSENSITIVE_ORDER) { it.label },
+        )
+
+    private fun supportedOperations(operations: List<SystemOperation>, launchable: Boolean): List<SystemOperation> =
+        if (launchable) {
+            operations
+        } else {
+            operations.filterNot { it == SystemOperation.LaunchTarget }
+        }
+
+    fun launch(packageName: String): Result<Unit> = runCatching {
+        val intent = packageManager.getLaunchIntentForPackage(packageName)
+            ?: error("No launcher activity for $packageName")
+        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        context.startActivity(intent)
+    }
+
+    fun forceStop(packageName: String): Result<Unit> = runCatching {
+        val activityManager = context.getSystemService(ActivityManager::class.java)
+            ?: error("ActivityManager unavailable")
+        activityManager.forceStopPackage(packageName)
+    }
+}
diff --git a/src/com/android/r0dumpmanager/data/reader/PrivateStoreModels.kt b/src/com/android/r0dumpmanager/data/reader/PrivateStoreModels.kt
new file mode 100644
index 0000000..fcd5af2
--- /dev/null
+++ b/src/com/android/r0dumpmanager/data/reader/PrivateStoreModels.kt
@@ -0,0 +1,138 @@
+package com.android.r0dumpmanager.data.reader
+
+import android.r0dump.R0dumpCapabilities
+import com.android.r0dumpmanager.data.control.RecoveryState
+
+object PrivateStoreCapabilities {
+    const val CAP_PRIVATE_STORE_CONTROL_V1: Long = R0dumpCapabilities.CAP_PRIVATE_STORE_CONTROL_V1
+
+    fun hasPrivateStoreControl(capabilityMask: Long?): Boolean =
+        capabilityMask != null &&
+            (capabilityMask and CAP_PRIVATE_STORE_CONTROL_V1) != 0L
+}
+
+enum class PrivateReaderAvailability {
+    UNAVAILABLE,
+    INDEXING,
+    READY,
+    FAILED,
+}
+
+data class PrivateReaderUiState(
+    val availability: PrivateReaderAvailability = PrivateReaderAvailability.UNAVAILABLE,
+    val indexGeneration: Long? = null,
+    val runs: List<PrivateRunSummary> = emptyList(),
+    val nextCursor: String? = null,
+    val message: String? = null,
+) {
+    val canRead: Boolean = availability == PrivateReaderAvailability.READY
+}
+
+object PrivateReaderGate {
+    fun state(
+        recoveryState: RecoveryState?,
+        capabilityMask: Long?,
+        indexGeneration: Long?,
+    ): PrivateReaderUiState = when {
+        recoveryState == RecoveryState.INDEXING -> PrivateReaderUiState(
+            availability = PrivateReaderAvailability.INDEXING,
+            message = "Verified private store is indexing",
+        )
+        recoveryState == RecoveryState.FAILED -> PrivateReaderUiState(
+            availability = PrivateReaderAvailability.FAILED,
+            message = "Verified private store recovery failed",
+        )
+        recoveryState == RecoveryState.NOT_STARTED -> PrivateReaderUiState(
+            availability = PrivateReaderAvailability.UNAVAILABLE,
+            message = "Verified private store recovery has not started",
+        )
+        recoveryState == RecoveryState.READY &&
+            PrivateStoreCapabilities.hasPrivateStoreControl(capabilityMask) &&
+            indexGeneration != null && indexGeneration > 0L -> PrivateReaderUiState(
+            availability = PrivateReaderAvailability.READY,
+            indexGeneration = indexGeneration,
+        )
+        else -> PrivateReaderUiState(
+            availability = PrivateReaderAvailability.UNAVAILABLE,
+            message = "Verified private store is unavailable",
+        )
+    }
+}
