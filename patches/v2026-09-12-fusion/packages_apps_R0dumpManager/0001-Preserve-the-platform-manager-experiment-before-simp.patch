+            state.selectedApplication == null || log.packageName == state.selectedApplication.packageName
+        }.filter { log ->
+            when (filter) {
+                LogFilter.All -> true
+                LogFilter.Config -> log.type == LogType.CONFIG_CHANGE
+                LogFilter.Action -> log.type == LogType.OPERATION
+                LogFilter.Error -> log.type == LogType.ERROR || !log.result
