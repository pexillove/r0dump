+private fun logDayLabel(timestamp: Long): String {
+    val current = Calendar.getInstance()
+    val target = Calendar.getInstance().apply { timeInMillis = timestamp }
+    val yesterday = Calendar.getInstance().apply { add(Calendar.DAY_OF_YEAR, -1) }
+    return when {
+        current.isSameDay(target) -> "Today"
+        yesterday.isSameDay(target) -> "Yesterday"
+        else -> DateFormat.getDateInstance(DateFormat.MEDIUM).format(Date(timestamp))
+    }
+}
+
+private fun Calendar.isSameDay(other: Calendar): Boolean =
+    get(Calendar.YEAR) == other.get(Calendar.YEAR) &&
+        get(Calendar.DAY_OF_YEAR) == other.get(Calendar.DAY_OF_YEAR)
+
+private fun R0dumpUiState.dumpStatusDescription(): String =
+    if (enabled) "enabled for ${watchPackage ?: selectedApplication?.packageName ?: "<unknown>"}" else "stopped"
