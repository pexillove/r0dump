--- a/runtime/interpreter/mterp/riscv64/main.S
+++ b/runtime/interpreter/mterp/riscv64/main.S
@@ -279,6 +279,12 @@ END \name
 // - a0: ArtMethod*
 // Clobbers: t0
 .macro START_EXECUTING_INSTRUCTIONS
+    la t0, g_r0dump_nterp_method_entry_enabled
+    lw t0, (t0)
+    beqz t0, 8f
+    ld a0, (sp)
+    call nterp_r0dump_method_entry
+8:
     ld a0, (sp)
     lhu t0, ART_METHOD_HOTNESS_COUNT_OFFSET(a0)  // t0 := hotness
 #if (NTERP_HOTNESS_VALUE != 0)
@@ -696,6 +702,7 @@ NTERP_TRAMPOLINE nterp_get_method, NterpGetMethod
