+extern "C" void NterpR0dumpMethodEntry(ArtMethod* method)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  ScopedAssertNoThreadSuspension sants("In nterp r0dump method entry");
+  r0dump_ObserveMethodCodeItem(r0dump_Point::kNterpMethodEntry,
+                               "Nterp.method.entry",
+                               method,
+                               r0dump_CodeItemRole::kNterpEntry);
+}
+
 inline void UpdateHotness(Thread* self, ArtMethod* method) REQUIRES_SHARED(Locks::mutator_lock_) {
   // The hotness we will add to a method when we perform a
   // field/method/class/string lookup.
diff --git a/runtime/interpreter/mterp/riscv64/main.S b/runtime/interpreter/mterp/riscv64/main.S
