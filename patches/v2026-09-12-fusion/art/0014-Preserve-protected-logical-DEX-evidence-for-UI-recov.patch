+void r0dump_AnnotateLogicalCopy(r0dump_RecordMetadata* metadata,
+                                bool complete,
+                                size_t copied_bytes) {
+  if (metadata == nullptr || metadata->runtime_view_json.empty()) {
+    return;
+  }
+  const size_t closing = metadata->runtime_view_json.find_last_of('}');
+  if (closing == std::string::npos) {
+    return;
+  }
+  metadata->runtime_view_json.insert(
+      closing,
+      ",\"logical_data_complete\":" + std::string(complete ? "true" : "false") +
+          ",\"logical_data_copied_bytes\":" + std::to_string(copied_bytes));
+}
+
+// Copy a logical DexFile data range without ever dereferencing an address that is not covered by
+// a readable mapping. Protected loaders may scatter this range across anonymous mappings and leave
+// guard gaps between them.  Gaps remain zero-filled and are reported to the caller via `complete`;
+// host-side reconstruction still validates all table references before accepting the image.
+std::unique_ptr<uint8_t[]> r0dump_CopyLogicalData(const uint8_t* begin,
+                                                  size_t size,
+                                                  bool* complete,
+                                                  size_t* copied_bytes) {
+  if (complete == nullptr || copied_bytes == nullptr || begin == nullptr || size == 0u ||
+      size > UINTPTR_MAX - reinterpret_cast<uintptr_t>(begin)) {
+    return nullptr;
+  }
+  std::unique_ptr<uint8_t[]> copy(new (std::nothrow) uint8_t[size]());
+  if (copy == nullptr) {
+    return nullptr;
+  }
+  const uintptr_t start = reinterpret_cast<uintptr_t>(begin);
+  const uintptr_t end = start + size;
+  *complete = true;
+  *copied_bytes = 0u;
+  FILE* maps = fopen("/proc/self/maps", "re");
+  if (maps == nullptr) {
+    return nullptr;
+  }
+  uintptr_t cursor = start;
+  char line[768] = {};
+  while (fgets(line, sizeof(line), maps) != nullptr) {
+    uintptr_t map_start = 0u;
+    uintptr_t map_end = 0u;
+    char permissions[5] = {};
+    if (sscanf(line, "%" SCNxPTR "-%" SCNxPTR " %4s", &map_start, &map_end, permissions) !=
+            3 ||
+        map_end <= start || map_start >= end || map_end <= map_start) {
+      continue;
+    }
+    const uintptr_t segment_start = std::max(start, map_start);
+    const uintptr_t segment_end = std::min(end, map_end);
+    if (segment_start > cursor) {
+      *complete = false;
+    }
+    if (permissions[0] != 'r') {
+      *complete = false;
+      cursor = std::max(cursor, segment_end);
+      continue;
+    }
+    const size_t segment_size = static_cast<size_t>(segment_end - segment_start);
+    const size_t local_offset = static_cast<size_t>(segment_start - start);
+    const iovec local = {copy.get() + local_offset, segment_size};
+    const iovec remote = {reinterpret_cast<void*>(segment_start), segment_size};
+    ssize_t read_bytes;
+    do {
+      read_bytes = process_vm_readv(getpid(), &local, 1u, &remote, 1u, 0u);
+    } while (read_bytes < 0 && errno == EINTR);
+    if (read_bytes != static_cast<ssize_t>(segment_size)) {
+      *complete = false;
+      if (read_bytes > 0) {
+        *copied_bytes += static_cast<size_t>(read_bytes);
+      }
+    } else {
+      *copied_bytes += segment_size;
+    }
+    cursor = std::max(cursor, segment_end);
+  }
+  fclose(maps);
+  if (cursor < end) {
+    *complete = false;
+  }
+  return copy;
+}
