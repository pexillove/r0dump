+    {R0dumpPoint::kDefineClassSuccess, "DefineClass.success"},
+    {R0dumpPoint::kLoadMethodReady, "LoadMethod.ready"},
+    {R0dumpPoint::kLoadClassEntry, "LoadClass.entry"},
+    {R0dumpPoint::kLoadClassSuccess, "LoadClass.success"},
