+#ifndef ART_RUNTIME_R0DUMP_R0DUMP_HOOK_POINT_H_
+#define ART_RUNTIME_R0DUMP_R0DUMP_HOOK_POINT_H_
+
+#include <cstdint>
+#include <optional>
+#include <string_view>
+
+#include "base/macros.h"
+
+namespace art HIDDEN {
+
+// These values are persisted in capture_point_mask. Do not reorder or reuse them.
+enum class R0dumpPoint : uint8_t {
+  kCookieResultDex = 0,
+  kInMemoryBufferCopied = 1,
+  kInMemoryDexParsed = 2,
+  kOpenCommonReturn = 3,
+  kDefineClassNativeMatch = 4,
+  kRegisterDexFileReturn = 5,
+  kDefineClassEntry = 6,
+  kDefineClassSuccess = 7,
+  kLoadMethodReady = 8,
+  kLoadClassEntry = 9,
+  kLoadClassSuccess = 10,
+  kResolveMethodCacheHit = 11,
+  kResolveMethodLookupSuccess = 12,
+  kVerifyClassComplete = 13,
+  kClassInitBeforeClinit = 14,
+  kClassInitSuccess = 15,
+  kOatDexFileOpenSuccess = 16,
+  kVdexLoadComplete = 17,
+  kOatManagerFileComplete = 18,
+  kOatManagerMemoryComplete = 19,
+  kOatManagerRegisterBeforeLock = 20,
+  kImageSpaceDexTracked = 21,
+  kArtMethodInvokeDispatch = 22,
+  kInterpreterExecuteEntry = 23,
+  kJitMethodEntered = 24,
+  kJitCompileBegin = 25,
+  kJitCompileEnd = 26,
+  kReflectMethodBeforeInvoke = 27,
+  kReflectCtorBeforeInvoke = 28,
+  kInstrumentationEnter = 29,
+  kInstrumentationExitValue = 30,
+  kInstrumentationExitObject = 31,
+  kBdclPathConstructor = 32,
+  kBdclMemoryConstructor = 33,
+  kBdclFindClassSuccess = 34,
+  kBdclAddDexPathReturn = 35,
+  kDexFileOpenFileReturn = 36,
+  kDexFileOpenMemoryReturn = 37,
+  kDexFileBeforeDefine = 38,
+  kWalkCookieDex = 39,
+  kWalkExecutableMethod = 40,
+  kForceInvokeNoExecute = 41,
+};
+
+using R0dumpCapturePointMask = uint64_t;
+
+constexpr uint8_t kR0dumpPointCount = 42;
+constexpr R0dumpCapturePointMask kR0dumpDefinedPointMask =
+    (R0dumpCapturePointMask{1} << kR0dumpPointCount) - 1;
+
+constexpr uint8_t R0dumpPointIndex(R0dumpPoint point) { return static_cast<uint8_t>(point); }
+
+constexpr bool R0dumpIsDefinedPoint(R0dumpPoint point) {
+  return R0dumpPointIndex(point) < kR0dumpPointCount;
+}
+
+constexpr R0dumpCapturePointMask R0dumpPointBit(R0dumpPoint point) {
+  return R0dumpIsDefinedPoint(point) ? R0dumpCapturePointMask{1} << R0dumpPointIndex(point)
+                                     : R0dumpCapturePointMask{0};
+}
+
+constexpr bool R0dumpIsDefinedPointMask(R0dumpCapturePointMask mask) {
+  return (mask & ~kR0dumpDefinedPointMask) == 0;
+}
+
+constexpr bool R0dumpIsValidCapturePointMask(R0dumpCapturePointMask mask) {
+  return R0dumpIsDefinedPointMask(mask);
+}
+
+constexpr bool R0dumpIsCapturePointEnabled(R0dumpCapturePointMask mask, R0dumpPoint point) {
+  return R0dumpIsDefinedPoint(point) && (mask & R0dumpPointBit(point)) != 0u;
+}
+
+std::string_view R0dumpPointName(R0dumpPoint point);
+std::optional<R0dumpPoint> R0dumpPointFromName(std::string_view name);
+
+}  // namespace art HIDDEN
+
+#endif  // ART_RUNTIME_R0DUMP_R0DUMP_HOOK_POINT_H_
