+#include "r0dump/r0dump_hook_point.h"
+
+#include <set>
+
+#include "gtest/gtest.h"
+
+namespace art HIDDEN {
+namespace {
+
+TEST(R0dumpHookPointTest, DefinedPointsHaveUniqueOneBitMasks) {
+  std::set<R0dumpCapturePointMask> masks;
+  for (uint8_t index = 0; index < kR0dumpPointCount; ++index) {
+    const auto point = static_cast<R0dumpPoint>(index);
+    const R0dumpCapturePointMask mask = R0dumpPointBit(point);
+    EXPECT_NE(mask, 0u);
+    EXPECT_EQ(mask & (mask - 1), 0u);
+    EXPECT_TRUE(masks.insert(mask).second);
+  }
+  EXPECT_EQ(masks.size(), kR0dumpPointCount);
+  EXPECT_EQ(kR0dumpDefinedPointMask, (R0dumpCapturePointMask{1} << kR0dumpPointCount) - 1);
+}
+
+TEST(R0dumpHookPointTest, NamesRoundTripForEveryDefinedPoint) {
+  for (uint8_t index = 0; index < kR0dumpPointCount; ++index) {
+    const auto point = static_cast<R0dumpPoint>(index);
+    const std::string_view name = R0dumpPointName(point);
+    ASSERT_FALSE(name.empty());
+    const std::optional<R0dumpPoint> resolved = R0dumpPointFromName(name);
+    ASSERT_TRUE(resolved.has_value());
+    EXPECT_EQ(*resolved, point);
+  }
+  EXPECT_EQ(R0dumpPointName(static_cast<R0dumpPoint>(kR0dumpPointCount)), "");
+  EXPECT_FALSE(R0dumpPointFromName("Walk.inventory").has_value());
+  EXPECT_FALSE(R0dumpPointFromName("ForceInvoke.request").has_value());
+}
+
+TEST(R0dumpHookPointTest, RejectsUndefinedMaskBits) {
+  EXPECT_TRUE(R0dumpIsDefinedPointMask(0));
+  EXPECT_TRUE(R0dumpIsDefinedPointMask(kR0dumpDefinedPointMask));
+  EXPECT_FALSE(R0dumpIsDefinedPointMask(R0dumpCapturePointMask{1} << kR0dumpPointCount));
+  EXPECT_FALSE(R0dumpIsDefinedPointMask(~kR0dumpDefinedPointMask));
+  EXPECT_EQ(R0dumpPointBit(static_cast<R0dumpPoint>(kR0dumpPointCount)), 0u);
+}
+
+TEST(R0dumpHookPointTest, ForceInvokeUsesBit41) {
+  EXPECT_EQ(R0dumpPointIndex(R0dumpPoint::kForceInvokeNoExecute), 41u);
+  EXPECT_EQ(R0dumpPointBit(R0dumpPoint::kForceInvokeNoExecute), R0dumpCapturePointMask{1} << 41);
+  EXPECT_EQ(R0dumpPointName(R0dumpPoint::kForceInvokeNoExecute), "ForceInvoke.no_execute");
+}
+
+TEST(R0dumpHookPointTest, EnabledCheckRejectsUndefinedPoints) {
+  const R0dumpCapturePointMask mask = R0dumpPointBit(R0dumpPoint::kOpenCommonReturn);
+  EXPECT_TRUE(R0dumpIsCapturePointEnabled(mask, R0dumpPoint::kOpenCommonReturn));
+  EXPECT_FALSE(R0dumpIsCapturePointEnabled(mask, R0dumpPoint::kCookieResultDex));
+  EXPECT_FALSE(R0dumpIsCapturePointEnabled(~R0dumpCapturePointMask{0},
+                                           static_cast<R0dumpPoint>(kR0dumpPointCount)));
+}
+
+}  // namespace
+}  // namespace art HIDDEN
