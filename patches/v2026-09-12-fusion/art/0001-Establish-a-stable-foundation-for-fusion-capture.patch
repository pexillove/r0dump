+#include "r0dump/r0dump_config.h"
+
+#include <gtest/gtest.h>
+
+#include "r0dump/r0dump_hook_point.h"
+
+namespace art HIDDEN {
+namespace {
+
+R0dumpProcessConfig ValidConfig() {
+  R0dumpProcessConfig config;
+  config.enabled = true;
+  config.run_id = "20260824T120000Z-a1b2c3d4";
+  config.target_package = "com.example.target";
+  config.target_process = "com.example.target";
+  config.capture_point_mask = R0dumpPointBit(R0dumpPoint::kCookieResultDex);
+  return config;
+}
+
+TEST(R0dumpConfigTest, AcceptsCanonicalConfig) {
+  R0dumpConfigError error;
+  EXPECT_TRUE(R0dumpValidateConfig(ValidConfig(), &error));
+  EXPECT_EQ(error.code, R0dumpConfigErrorCode::kNone);
+  EXPECT_EQ(error.field, nullptr);
+}
+
+TEST(R0dumpConfigTest, RejectsUndefinedCapturePointBit) {
+  R0dumpProcessConfig config = ValidConfig();
+  config.capture_point_mask |= uint64_t{1} << 42u;
+  R0dumpConfigError error;
+  EXPECT_FALSE(R0dumpValidateConfig(config, &error));
+  EXPECT_EQ(error.code, R0dumpConfigErrorCode::kInvalidCapturePointMask);
+}
+
+TEST(R0dumpConfigTest, ForceInvokeRequiresNoExecutePointAndExactSelector) {
+  R0dumpProcessConfig config = ValidConfig();
+  config.force_invoke_enabled = true;
+  config.force_class = "com.example.target.Entry";
+  config.force_method = "materialize";
+  config.force_method_descriptor = "()V";
+
+  R0dumpConfigError error;
+  EXPECT_FALSE(R0dumpValidateConfig(config, &error));
+  EXPECT_EQ(error.code, R0dumpConfigErrorCode::kInvalidForceSelector);
+
+  config.capture_point_mask |= R0dumpPointBit(R0dumpPoint::kForceInvokeNoExecute);
+  EXPECT_TRUE(R0dumpValidateConfig(config, &error));
+
+  config.force_method_descriptor = "";
+  EXPECT_FALSE(R0dumpValidateConfig(config, &error));
+
+  config.force_method_descriptor = "(Ljava.lang.String;)V";
+  EXPECT_FALSE(R0dumpValidateConfig(config, &error));
+
+  config.force_method_descriptor = "([Ljava/lang/String;I)Ljava/lang/Object;";
+  EXPECT_TRUE(R0dumpValidateConfig(config, &error));
+}
+
+TEST(R0dumpConfigTest, RejectsPathLikeIdentityFields) {
+  R0dumpProcessConfig config = ValidConfig();
+  config.run_id = "../escape";
+  EXPECT_FALSE(R0dumpValidateConfig(config, nullptr));
+
+  config = ValidConfig();
+  config.target_process = "com.other.process";
+  EXPECT_FALSE(R0dumpValidateConfig(config, nullptr));
+
+  config = ValidConfig();
+  config.target_process = "com.example.target:child";
+  EXPECT_TRUE(R0dumpValidateConfig(config, nullptr));
+}
+
+TEST(R0dumpConfigTest, RejectsBudgetsOutsideDocumentedHardLimits) {
+  R0dumpProcessConfig config = ValidConfig();
+  config.max_total_bytes = kR0dumpMaxTotalBytesHardLimit + 1u;
+  EXPECT_FALSE(R0dumpValidateConfig(config, nullptr));
+
+  config = ValidConfig();
+  config.max_dex_bytes = config.max_total_bytes + 1u;
+  EXPECT_FALSE(R0dumpValidateConfig(config, nullptr));
+
+  config = ValidConfig();
+  config.max_artifacts = config.max_records + 1u;
+  EXPECT_FALSE(R0dumpValidateConfig(config, nullptr));
+}
+
+TEST(R0dumpConfigTest, PublishesOneImmutableSnapshot) {
+  R0dumpConfigStore store;
+  R0dumpConfigError error;
+  EXPECT_TRUE(store.ConfigureOnce(ValidConfig(), &error));
+  ASSERT_NE(store.Get(), nullptr);
+  EXPECT_TRUE(store.IsEnabledFor("com.example.target", "com.example.target"));
+  EXPECT_FALSE(store.IsEnabledFor("com.example.other", "com.example.other"));
+
+  R0dumpProcessConfig replacement = ValidConfig();
+  replacement.run_id = "replacement";
+  EXPECT_FALSE(store.ConfigureOnce(std::move(replacement), &error));
+  EXPECT_EQ(error.code, R0dumpConfigErrorCode::kAlreadyConfigured);
+  EXPECT_EQ(store.Get()->run_id, "20260824T120000Z-a1b2c3d4");
+}
+
