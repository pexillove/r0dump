+    {R0dumpPoint::kJitMethodEntered, "Jit.method_entered"},
+    {R0dumpPoint::kJitCompileBegin, "Jit.compile.begin"},
+    {R0dumpPoint::kJitCompileEnd, "Jit.compile.end"},
+    {R0dumpPoint::kReflectMethodBeforeInvoke, "Reflect.method.before_invoke"},
+    {R0dumpPoint::kReflectCtorBeforeInvoke, "Reflect.ctor.before_invoke"},
+    {R0dumpPoint::kInstrumentationEnter, "Instrumentation.enter"},
