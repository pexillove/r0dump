+
+namespace art HIDDEN {
+namespace {
+
+void SetError(R0dumpConfigError* error, R0dumpConfigErrorCode code, const char* field) {
+  if (error != nullptr) {
+    error->code = code;
+    error->field = field;
+  }
+}
+
+bool IsAsciiAlpha(char value) {
+  return (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z');
+}
+
+bool IsAsciiDigit(char value) { return value >= '0' && value <= '9'; }
+
+bool IsJavaIdentifierSegment(std::string_view value) {
+  if (value.empty() || !(IsAsciiAlpha(value.front()) || value.front() == '_')) {
+    return false;
+  }
+  return std::all_of(value.begin() + 1u, value.end(), [](char ch) {
+    return IsAsciiAlpha(ch) || IsAsciiDigit(ch) || ch == '_';
+  });
+}
+
+bool IsPackageName(std::string_view value) {
+  if (value.empty() || value.size() > 255u || value.front() == '.' || value.back() == '.') {
+    return false;
+  }
+  size_t start = 0u;
+  size_t segment_count = 0u;
+  while (start < value.size()) {
+    const size_t end = value.find('.', start);
+    const size_t length = (end == std::string_view::npos ? value.size() : end) - start;
+    if (!IsJavaIdentifierSegment(value.substr(start, length))) {
+      return false;
+    }
+    ++segment_count;
+    if (end == std::string_view::npos) {
+      break;
+    }
+    start = end + 1u;
+  }
+  return segment_count >= 1u;
+}
+
+bool IsRunId(std::string_view value) {
+  if (value.empty() || value.size() > 64u ||
+      !(IsAsciiAlpha(value.front()) || IsAsciiDigit(value.front()))) {
+    return false;
+  }
+  return std::all_of(value.begin(), value.end(), [](char ch) {
+    return IsAsciiAlpha(ch) || IsAsciiDigit(ch) || ch == '-' || ch == '_' || ch == '.';
+  });
+}
+
+bool IsTargetProcess(std::string_view package_name, std::string_view process_name) {
+  if (process_name.empty() || process_name == package_name) {
+    return true;
+  }
+  if (process_name.size() <= package_name.size() + 1u ||
+      process_name.substr(0u, package_name.size()) != package_name ||
+      process_name[package_name.size()] != ':') {
+    return false;
+  }
+  const std::string_view suffix = process_name.substr(package_name.size() + 1u);
+  size_t start = 0u;
+  while (start < suffix.size()) {
+    const size_t end = suffix.find('.', start);
+    const size_t length = (end == std::string_view::npos ? suffix.size() : end) - start;
+    if (!IsJavaIdentifierSegment(suffix.substr(start, length))) {
+      return false;
+    }
+    if (end == std::string_view::npos) {
+      return true;
+    }
+    start = end + 1u;
+  }
+  return false;
+}
+
+bool IsBinaryClassName(std::string_view value) {
+  if (value.empty() || value.size() > 1024u || value.find('/') != std::string_view::npos) {
+    return false;
+  }
+  size_t start = 0u;
+  while (start < value.size()) {
+    const size_t end = value.find('.', start);
+    const size_t length = (end == std::string_view::npos ? value.size() : end) - start;
+    if (length == 0u) {
+      return false;
+    }
+    const std::string_view segment = value.substr(start, length);
+    if (!(IsAsciiAlpha(segment.front()) || segment.front() == '_' || segment.front() == '$')) {
+      return false;
+    }
+    if (!std::all_of(segment.begin() + 1u, segment.end(), [](char ch) {
+          return IsAsciiAlpha(ch) || IsAsciiDigit(ch) || ch == '_' || ch == '$';
+        })) {
+      return false;
+    }
+    if (end == std::string_view::npos) {
+      break;
+    }
+    start = end + 1u;
+  }
+  return true;
+}
+
+bool IsMethodName(std::string_view value) {
+  if (value.empty() || value.size() > 255u) {
+    return false;
+  }
+  if (value == "<init>" || value == "<clinit>") {
+    return true;
+  }
+  return IsJavaIdentifierSegment(value);
+}
+
+bool IsMethodDescriptor(std::string_view value) {
+  if (value.size() < 3u || value.size() > 1024u || value.front() != '(' ||
+      value.find('\0') != std::string_view::npos) {
+    return false;
+  }
+  const size_t close = value.find(')');
+  if (close == std::string_view::npos || close + 1u >= value.size() ||
+      value.find(')', close + 1u) != std::string_view::npos) {
+    return false;
+  }
+
+  auto consume_type = [](std::string_view descriptor, size_t* cursor, bool allow_void) {
+    const size_t start = *cursor;
+    while (*cursor < descriptor.size() && descriptor[*cursor] == '[') {
+      ++*cursor;
+    }
+    if (*cursor >= descriptor.size()) {
+      return false;
+    }
+    const bool is_array = *cursor != start;
+    const char kind = descriptor[(*cursor)++];
+    if (kind == 'V') {
+      return allow_void && !is_array;
+    }
+    if (kind == 'L') {
+      const size_t semicolon = descriptor.find(';', *cursor);
+      if (semicolon == std::string_view::npos) {
+        return false;
+      }
+      *cursor = semicolon + 1u;
+    } else if (std::string_view("BCDFIJSZ").find(kind) == std::string_view::npos) {
+      return false;
+    }
+    const std::string type(descriptor.substr(start, *cursor - start));
+    return IsValidDescriptor(type.c_str());
+  };
+
+  size_t cursor = 1u;
+  while (cursor < close) {
+    const size_t before = cursor;
+    if (!consume_type(value.substr(0u, close), &cursor, /*allow_void=*/false) || cursor <= before) {
+      return false;
+    }
+  }
+  if (cursor != close) {
+    return false;
+  }
+  cursor = close + 1u;
+  return consume_type(value, &cursor, /*allow_void=*/true) && cursor == value.size();
+}
+
+}  // namespace
+
+bool R0dumpProcessConfig::MatchesProcess(std::string_view package_name,
+                                         std::string_view process_name) const {
+  return package_name == target_package &&
+         (target_process.empty() || process_name == target_process);
+}
+
+bool R0dumpValidateConfig(const R0dumpProcessConfig& config, R0dumpConfigError* error) {
+  SetError(error, R0dumpConfigErrorCode::kNone, nullptr);
+  if (config.schema != kR0dumpConfigSchema) {
+    SetError(error, R0dumpConfigErrorCode::kUnsupportedSchema, "schema");
+    return false;
+  }
+  if (!IsRunId(config.run_id)) {
+    SetError(error, R0dumpConfigErrorCode::kInvalidRunId, "run_id");
+    return false;
+  }
+  if (!IsPackageName(config.target_package)) {
+    SetError(error, R0dumpConfigErrorCode::kInvalidTargetPackage, "target_package");
+    return false;
+  }
+  if (!IsTargetProcess(config.target_package, config.target_process)) {
+    SetError(error, R0dumpConfigErrorCode::kInvalidTargetProcess, "target_process");
+    return false;
+  }
+  if (!R0dumpIsValidCapturePointMask(config.capture_point_mask)) {
+    SetError(error, R0dumpConfigErrorCode::kInvalidCapturePointMask, "capture_point_mask");
+    return false;
+  }
+  if (config.max_records == 0u || config.max_records > kR0dumpMaxRecordsHardLimit ||
+      config.max_artifacts == 0u || config.max_artifacts > kR0dumpMaxArtifactsHardLimit ||
+      config.max_artifacts > config.max_records || config.max_total_bytes == 0u ||
+      config.max_total_bytes > kR0dumpMaxTotalBytesHardLimit || config.max_dex_bytes == 0u ||
+      config.max_dex_bytes > kR0dumpMaxDexBytesHardLimit ||
+      config.max_dex_bytes > config.max_total_bytes) {
+    SetError(error, R0dumpConfigErrorCode::kInvalidBudget, "budgets");
+    return false;
+  }
+  if (config.manifest_max_components == 0u ||
+      config.manifest_max_components > kR0dumpManifestComponentsHardLimit) {
+    SetError(error, R0dumpConfigErrorCode::kInvalidManifestLimit, "manifest_max_components");
+    return false;
+  }
+  if (config.walk_max_classes == 0u || config.walk_max_methods == 0u) {
+    SetError(error, R0dumpConfigErrorCode::kInvalidWalkLimit, "walk_limits");
+    return false;
+  }
+  if (config.force_max_calls == 0u || config.force_max_calls > kR0dumpForceCallsHardLimit) {
+    SetError(error, R0dumpConfigErrorCode::kInvalidForceSelector, "force_max_calls");
+    return false;
+  }
+  if (config.force_invoke_enabled) {
+    if (!R0dumpIsCapturePointEnabled(config.capture_point_mask,
+                                     R0dumpPoint::kForceInvokeNoExecute) ||
+        !IsBinaryClassName(config.force_class) || !IsMethodName(config.force_method) ||
+        !IsMethodDescriptor(config.force_method_descriptor)) {
+      SetError(error, R0dumpConfigErrorCode::kInvalidForceSelector, "force_selector");
+      return false;
+    }
+  }
+  return true;
+}
+
+R0dumpConfigStore::~R0dumpConfigStore() { published_.store(nullptr, std::memory_order_release); }
+
+bool R0dumpConfigStore::ConfigureOnce(R0dumpProcessConfig config, R0dumpConfigError* error) {
+  if (!R0dumpValidateConfig(config, error)) {
+    return false;
+  }
+  std::lock_guard<std::mutex> lock(lock_);
+  if (owned_ != nullptr) {
+    SetError(error, R0dumpConfigErrorCode::kAlreadyConfigured, "config");
+    return false;
+  }
+  owned_ = std::make_unique<const R0dumpProcessConfig>(std::move(config));
+  published_.store(owned_.get(), std::memory_order_release);
+  return true;
+}
+
+bool R0dumpConfigStore::IsEnabledFor(std::string_view package_name,
+                                     std::string_view process_name) const {
+  const R0dumpProcessConfig* config = Get();
+  return config != nullptr && config->enabled && config->MatchesProcess(package_name, process_name);
+}
+
+}  // namespace art HIDDEN
