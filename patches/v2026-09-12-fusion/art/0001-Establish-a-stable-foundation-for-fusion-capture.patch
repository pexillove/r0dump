+#ifndef ART_RUNTIME_R0DUMP_R0DUMP_CONFIG_H_
+#define ART_RUNTIME_R0DUMP_R0DUMP_CONFIG_H_
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <string_view>
+
+#include "base/macros.h"
+
+namespace art HIDDEN {
+
+inline constexpr uint32_t kR0dumpConfigSchema = 1u;
+inline constexpr uint32_t kR0dumpMaxRecordsHardLimit = 4096u;
+inline constexpr uint32_t kR0dumpMaxArtifactsHardLimit = 512u;
+inline constexpr uint64_t kR0dumpMaxTotalBytesHardLimit = 512u * 1024u * 1024u;
+inline constexpr uint64_t kR0dumpMaxDexBytesHardLimit = 64u * 1024u * 1024u;
+inline constexpr uint32_t kR0dumpManifestComponentsHardLimit = 16384u;
+inline constexpr uint32_t kR0dumpForceCallsHardLimit = 8u;
+
+enum class R0dumpWalkStart : uint8_t {
+  kAfterApplicationOnCreate,
+  kAfterFirstActivityOnCreate,
+};
+
+enum class R0dumpWalkMode : uint8_t {
+  kLoadedOnly,
+  kDexNames,
+};
+
+enum class R0dumpConfigErrorCode : uint8_t {
+  kNone,
+  kAlreadyConfigured,
+  kUnsupportedSchema,
+  kInvalidRunId,
+  kInvalidTargetPackage,
+  kInvalidTargetProcess,
+  kInvalidCapturePointMask,
+  kInvalidBudget,
+  kInvalidManifestLimit,
+  kInvalidWalkLimit,
+  kInvalidForceSelector,
+};
+
+struct R0dumpConfigError {
+  R0dumpConfigErrorCode code = R0dumpConfigErrorCode::kNone;
+  const char* field = nullptr;
+};
+
+struct R0dumpProcessConfig {
+  uint32_t schema = kR0dumpConfigSchema;
+  bool enabled = false;
+  std::string run_id;
+  std::string target_package;
+  std::string target_process;
+  uint64_t capture_point_mask = 0u;
+
+  uint32_t max_records = 512u;
+  uint32_t max_artifacts = 128u;
+  uint64_t max_total_bytes = 192u * 1024u * 1024u;
+  uint64_t max_dex_bytes = 32u * 1024u * 1024u;
+
+  bool manifest_enabled = true;
+  bool manifest_include_splits = true;
+  uint32_t manifest_max_components = 8192u;
+
+  bool walk_enabled = false;
+  R0dumpWalkStart walk_start = R0dumpWalkStart::kAfterApplicationOnCreate;
+  R0dumpWalkMode walk_mode = R0dumpWalkMode::kLoadedOnly;
+  uint32_t walk_delay_ms = 5000u;
+  uint32_t walk_max_classes = 2000u;
+  uint32_t walk_max_methods = 20000u;
+
+  bool force_invoke_enabled = false;
+  std::string force_class;
+  std::string force_method;
+  std::string force_method_descriptor;
+  uint32_t force_max_calls = 1u;
+
+  bool MatchesProcess(std::string_view package_name, std::string_view process_name) const;
+};
+
+bool R0dumpValidateConfig(const R0dumpProcessConfig& config, R0dumpConfigError* error);
+
+class R0dumpConfigStore final {
+ public:
+  R0dumpConfigStore() = default;
+  ~R0dumpConfigStore();
+
+  R0dumpConfigStore(const R0dumpConfigStore&) = delete;
+  R0dumpConfigStore& operator=(const R0dumpConfigStore&) = delete;
+
+  bool ConfigureOnce(R0dumpProcessConfig config, R0dumpConfigError* error);
+
+  const R0dumpProcessConfig* Get() const { return published_.load(std::memory_order_acquire); }
+
+  bool IsEnabledFor(std::string_view package_name, std::string_view process_name) const;
+
+ private:
+  mutable std::mutex lock_;
+  std::unique_ptr<const R0dumpProcessConfig> owned_;
+  std::atomic<const R0dumpProcessConfig*> published_{nullptr};
+};
+
+}  // namespace art HIDDEN
+
+#endif  // ART_RUNTIME_R0DUMP_R0DUMP_CONFIG_H_
