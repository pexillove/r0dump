+uint64_t TestClock() { return g_now_ns.load(); }
+
+void Collect(R0dumpLogLevel, std::string_view line) {
+  std::lock_guard<std::mutex> lock(g_lines_lock);
+  g_lines->emplace_back(line);
+}
+
+class R0dumpLogTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    g_now_ns.store(0);
+    g_lines = &lines_;
+    R0dumpSetLogClockForTesting(TestClock);
+    R0dumpSetLogSinkForTesting(Collect);
+    R0dumpResetLogStateForTesting();
+  }
+
+  void TearDown() override {
+    R0dumpSetLogSinkForTesting(nullptr);
+    R0dumpSetLogClockForTesting(nullptr);
+    R0dumpResetLogStateForTesting();
+    g_lines = nullptr;
+  }
+
+  std::vector<std::string> lines_;
+};
+
+TEST_F(R0dumpLogTest, FormatsAndEscapesStructuredFields) {
+  R0dumpLog(R0dumpLogLevel::kInfo,
+            "capture staged",
+            {{"status", "ok"}, {"site", "dex=raw"}, {"path", "a b\\c\n"}});
+
+  ASSERT_EQ(1u, lines_.size());
+  EXPECT_EQ("event=capture\\sstaged status=ok site=dex\\=raw path=a\\sb\\\\c\\n", lines_[0]);
+}
+
+TEST_F(R0dumpLogTest, LimitsEachEventStatusAndSiteAndReportsSuppression) {
+  for (size_t i = 0; i != 12; ++i) {
+    R0dumpLog(R0dumpLogLevel::kInfo, "hook_seen", {{"status", "ok"}, {"site", "42"}});
+  }
+  EXPECT_EQ(10u, lines_.size());
+
+  g_now_ns.store(UINT64_C(1000000000));
+  R0dumpLog(R0dumpLogLevel::kInfo, "hook_seen", {{"status", "ok"}, {"site", "42"}});
+  ASSERT_EQ(12u, lines_.size());
+  EXPECT_EQ("event=hook_seen status=ok site=42 suppressed=2", lines_[10]);
+  EXPECT_EQ("event=hook_seen status=ok site=42", lines_[11]);
+}
+
+TEST_F(R0dumpLogTest, UsesIndependentRateBuckets) {
+  for (size_t i = 0; i != 11; ++i) {
+    R0dumpLog(R0dumpLogLevel::kInfo, "hook_seen", {{"status", "ok"}, {"site", "1"}});
+  }
+  R0dumpLog(R0dumpLogLevel::kInfo, "hook_seen", {{"status", "ok"}, {"site", "2"}});
+  EXPECT_EQ(11u, lines_.size());
+}
+
+TEST_F(R0dumpLogTest, SerializesConcurrentCalls) {
+  constexpr size_t kThreadCount = 4;
+  std::vector<std::thread> threads;
+  for (size_t i = 0; i != kThreadCount; ++i) {
+    threads.emplace_back([]() {
+      R0dumpLog(R0dumpLogLevel::kInfo, "walk_completed", {{"status", "ok"}, {"site", "1"}});
+    });
+  }
+  for (std::thread& thread : threads) {
+    thread.join();
+  }
+  EXPECT_EQ(kThreadCount, lines_.size());
+}
