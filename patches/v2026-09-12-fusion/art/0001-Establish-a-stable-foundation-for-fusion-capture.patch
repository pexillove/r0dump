index 0000000..08e6d72
--- /dev/null
+++ b/runtime/r0dump/r0dump_log.cc
@@ -0,0 +1,206 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "r0dump/r0dump_log.h"
+
+#include <android-base/logging.h>
+
+#include <chrono>
+#include <map>
+#include <mutex>
+#include <string>
+#include <tuple>
+
+namespace art HIDDEN {
+namespace {
+
+constexpr char kR0dumpLogTag[] = "R0dumpFusion";
+constexpr uint64_t kRateWindowNs = UINT64_C(1000000000);
+constexpr size_t kRecordsPerWindow = 10;
+
+struct RateKey {
+  std::string event;
+  std::string status;
+  std::string site;
+
+  bool operator<(const RateKey& other) const {
+    return std::tie(event, status, site) < std::tie(other.event, other.status, other.site);
+  }
+};
+
+struct RateState {
+  uint64_t window_start_ns = 0;
+  size_t emitted = 0;
+  size_t suppressed = 0;
+};
+
+struct LogState {
+  std::mutex lock;
+  std::map<RateKey, RateState> rates;
+  R0dumpLogSink sink = nullptr;
+  R0dumpLogClock clock = nullptr;
+};
+
+LogState& GetLogState() {
+  static LogState* state = new LogState;
+  return *state;
+}
+
+uint64_t DefaultClock() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+android::base::LogSeverity ToAndroidLogSeverity(R0dumpLogLevel level) {
+  switch (level) {
+    case R0dumpLogLevel::kDebug:
+      return android::base::DEBUG;
+    case R0dumpLogLevel::kInfo:
+      return android::base::INFO;
+    case R0dumpLogLevel::kWarn:
+      return android::base::WARNING;
+    case R0dumpLogLevel::kError:
+      return android::base::ERROR;
+  }
+}
+
+void DefaultSink(R0dumpLogLevel level, std::string_view line) {
+  std::string message(line);
+  android::base::LogMessage::LogLine(
+      __FILE__, __LINE__, ToAndroidLogSeverity(level), kR0dumpLogTag, message.c_str());
+}
+
+std::string Escape(std::string_view value) {
+  static constexpr char kHex[] = "0123456789ABCDEF";
+  std::string escaped;
+  escaped.reserve(value.size());
+  for (unsigned char c : value) {
+    switch (c) {
+      case '\\':
+        escaped += "\\\\";
+        break;
+      case ' ':
+        escaped += "\\s";
+        break;
+      case '\n':
+        escaped += "\\n";
+        break;
+      case '\r':
+        escaped += "\\r";
+        break;
+      case '\t':
+        escaped += "\\t";
+        break;
+      case '=':
+        escaped += "\\=";
+        break;
+      default:
+        if (c < 0x20 || c == 0x7f) {
+          escaped += "\\x";
+          escaped += kHex[c >> 4];
+          escaped += kHex[c & 0x0f];
+        } else {
+          escaped += static_cast<char>(c);
+        }
+        break;
+    }
+  }
+  return escaped;
+}
+
+std::string FindField(std::initializer_list<R0dumpLogField> fields, std::string_view key) {
+  for (const R0dumpLogField& field : fields) {
+    if (field.key == key) {
+      return std::string(field.value);
+    }
+  }
+  return "-";
+}
+
+std::string Format(std::string_view event, std::initializer_list<R0dumpLogField> fields) {
+  std::string line = "event=" + Escape(event);
+  for (const R0dumpLogField& field : fields) {
+    line += ' ';
+    line += Escape(field.key);
+    line += '=';
+    line += Escape(field.value);
+  }
+  return line;
+}
+
+std::string FormatSuppressed(const RateKey& key, size_t suppressed) {
+  return "event=" + Escape(key.event) + " status=" + Escape(key.status) +
+         " site=" + Escape(key.site) + " suppressed=" + std::to_string(suppressed);
+}
+
+}  // namespace
+
+void R0dumpLog(R0dumpLogLevel level,
+               std::string_view event,
+               std::initializer_list<R0dumpLogField> fields) {
+  LogState& state = GetLogState();
+  R0dumpLogSink sink;
+  std::string summary;
+  std::string line;
+  {
+    std::lock_guard<std::mutex> lock(state.lock);
+    const uint64_t now_ns = (state.clock == nullptr) ? DefaultClock() : state.clock();
+    RateKey key{std::string(event), FindField(fields, "status"), FindField(fields, "site")};
+    RateState& rate = state.rates[key];
+    if (now_ns - rate.window_start_ns >= kRateWindowNs) {
+      if (rate.suppressed != 0u) {
+        summary = FormatSuppressed(key, rate.suppressed);
+      }
+      rate.window_start_ns = now_ns;
+      rate.emitted = 0;
+      rate.suppressed = 0;
+    }
+    if (rate.emitted == kRecordsPerWindow) {
+      ++rate.suppressed;
+    } else {
+      ++rate.emitted;
+      line = Format(event, fields);
+    }
+    sink = (state.sink == nullptr) ? DefaultSink : state.sink;
+  }
+  if (!summary.empty()) {
+    sink(R0dumpLogLevel::kWarn, summary);
+  }
+  if (!line.empty()) {
+    sink(level, line);
+  }
+}
+
+void R0dumpSetLogSinkForTesting(R0dumpLogSink sink) {
+  LogState& state = GetLogState();
+  std::lock_guard<std::mutex> lock(state.lock);
+  state.sink = sink;
+}
+
+void R0dumpSetLogClockForTesting(R0dumpLogClock clock) {
+  LogState& state = GetLogState();
+  std::lock_guard<std::mutex> lock(state.lock);
+  state.clock = clock;
+}
+
+void R0dumpResetLogStateForTesting() {
+  LogState& state = GetLogState();
+  std::lock_guard<std::mutex> lock(state.lock);
+  state.rates.clear();
+}
+
+}  // namespace art HIDDEN
