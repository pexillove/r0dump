+std::string_view R0dumpPointName(R0dumpPoint point) {
+  const uint8_t index = R0dumpPointIndex(point);
+  return index < kR0dumpPointDescriptors.size() ? kR0dumpPointDescriptors[index].name
+                                                : std::string_view();
+}
+
+std::optional<R0dumpPoint> R0dumpPointFromName(std::string_view name) {
+  for (const R0dumpPointDescriptor& descriptor : kR0dumpPointDescriptors) {
