+bool r0dump_IsNamespacePrefix(std::string_view value) {
+  if (value.empty() || value.size() > kR0dumpPropertyValueBytesHardLimit || value.back() != '.') {
+    return false;
+  }
+  const std::string_view body = value.substr(0u, value.size() - 1u);
+  size_t start = 0u;
+  while (start < body.size()) {
+    const size_t end = body.find('.', start);
+    const size_t length = (end == std::string_view::npos ? body.size() : end) - start;
+    const std::string_view segment = body.substr(start, length);
+    if (segment.empty() || !(r0dump_IsAsciiAlpha(segment.front()) || segment.front() == '_' ||
+                             segment.front() == '$') ||
+        !std::all_of(segment.begin() + 1u, segment.end(), [](char ch) {
+          return r0dump_IsAsciiAlpha(ch) || r0dump_IsAsciiDigit(ch) || ch == '_' || ch == '$';
+        })) {
+      return false;
+    }
+    if (end == std::string_view::npos) {
+      break;
+    }
+    start = end + 1u;
+  }
+  return true;
+}
