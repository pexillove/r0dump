+  private static void r0dump_validateFields(JSONObject json) {
+    if (json.length() != FIELDS.size()) {
+      throw r0dump_invalid("fields");
+    }
+    final Iterator<String> keys = json.keys();
+    while (keys.hasNext()) {
+      if (!FIELDS.contains(keys.next())) {
+        throw r0dump_invalid("unknown_field");
+      }
+    }
+    for (String field : FIELDS) {
+      if (!json.has(field)) {
+        throw r0dump_invalid("missing_field");
+      }
+    }
+  }
