+  @Test
+  public void r0dump_publishIfEnabled_validTarget_publishesExactConfig() throws Exception {
+    final r0dump_RecordingPublisher publisher = new r0dump_RecordingPublisher();
+
+    assertThat(
+            r0dump_FusionConfig.r0dump_publishIfEnabled(
+                r0dump_validJson().toString(),
+                PACKAGE_NAME,
+                PROCESS_NAME,
+                OUTPUT_PARENT,
+                publisher))
+        .isTrue();
+
+    assertThat(publisher.callCount).isEqualTo(1);
+    assertThat(publisher.config.runId).isEqualTo("20260824T120000Z-a1b2c3d4");
+    assertThat(publisher.config.targetPackage).isEqualTo(PACKAGE_NAME);
+    assertThat(publisher.config.targetProcess).isEqualTo(PROCESS_NAME);
+    assertThat(publisher.config.capturePointMask).isEqualTo(0x180000000ffL);
+    assertThat(publisher.config.walkStart)
+        .isEqualTo(r0dump_FusionConfig.WALK_START_AFTER_APPLICATION_ON_CREATE);
+    assertThat(publisher.config.walkMode).isEqualTo(r0dump_FusionConfig.WALK_MODE_LOADED_ONLY);
+    assertThat(publisher.outputParent).isEqualTo(OUTPUT_PARENT);
+  }
