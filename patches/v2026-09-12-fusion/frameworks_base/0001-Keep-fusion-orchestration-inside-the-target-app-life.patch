+  private static String r0dump_requireString(JSONObject json, String field) throws JSONException {
+    final Object value = json.get(field);
+    if (!(value instanceof String)) {
+      throw r0dump_invalid(field);
+    }
+    return (String) value;
+  }
+
+  private static long r0dump_parseMask(String value) {
+    if (value.length() != 18 || !value.startsWith("0x")) {
+      throw r0dump_invalid("capture_point_mask");
+    }
+    for (int i = 2; i < value.length(); i++) {
+      final char ch = value.charAt(i);
+      if (!((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F'))) {
+        throw r0dump_invalid("capture_point_mask");
+      }
+    }
+    try {
+      return Long.parseUnsignedLong(value.substring(2), 16);
+    } catch (NumberFormatException e) {
+      throw r0dump_invalid("capture_point_mask");
+    }
+  }
+
+  private static int r0dump_parseWalkStart(String value) {
+    switch (value) {
+      case "after_application_on_create":
+        return WALK_START_AFTER_APPLICATION_ON_CREATE;
+      case "after_first_activity_on_create":
+        return WALK_START_AFTER_FIRST_ACTIVITY_ON_CREATE;
+      default:
+        throw r0dump_invalid("walk_start");
+    }
+  }
+
+  private static int r0dump_parseWalkMode(String value) {
+    switch (value) {
+      case "loaded_only":
+        return WALK_MODE_LOADED_ONLY;
+      case "dex_names":
+        return WALK_MODE_DEX_NAMES;
+      default:
+        throw r0dump_invalid("walk_mode");
+    }
+  }
+
+  private static boolean r0dump_isRunId(String value) {
+    if (value.isEmpty() || value.length() > 64 || !r0dump_isAsciiAlphaNumeric(value.charAt(0))) {
+      return false;
+    }
+    for (int i = 1; i < value.length(); i++) {
+      final char ch = value.charAt(i);
+      if (!r0dump_isAsciiAlphaNumeric(ch) && ch != '-' && ch != '_' && ch != '.') {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  private static boolean r0dump_fitsPropertyValue(String value) {
+    return value.getBytes(StandardCharsets.UTF_8).length <= SystemProperties.PROP_VALUE_MAX;
+  }
+
+  private static boolean r0dump_isPackageName(String value) {
+    if (value.isEmpty() || value.length() > 255 || value.startsWith(".") || value.endsWith(".")) {
+      return false;
+    }
+    for (String segment : value.split("\\.", -1)) {
+      if (!r0dump_isJavaIdentifierSegment(segment, false)) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  private static boolean r0dump_isTargetProcess(String packageName, String processName) {
+    if (processName.isEmpty() || processName.equals(packageName)) {
+      return true;
+    }
+    if (!processName.startsWith(packageName + ":")) {
+      return false;
+    }
+    for (String segment : processName.substring(packageName.length() + 1).split("\\.", -1)) {
+      if (!r0dump_isJavaIdentifierSegment(segment, false)) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  private static boolean r0dump_isBinaryClassName(String value) {
+    if (value.isEmpty() || value.length() > 1024 || value.indexOf('/') >= 0) {
+      return false;
+    }
+    for (String segment : value.split("\\.", -1)) {
+      if (!r0dump_isJavaIdentifierSegment(segment, true)) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  private static boolean r0dump_isMethodName(String value) {
+    return "<init>".equals(value)
+        || "<clinit>".equals(value)
+        || (value.length() <= 255 && r0dump_isJavaIdentifierSegment(value, false));
+  }
+
+  private static boolean r0dump_isMethodDescriptor(String descriptor) {
+    if (descriptor.length() < 3 || descriptor.length() > 1024 || descriptor.charAt(0) != '(') {
+      return false;
+    }
+    int cursor = 1;
+    while (cursor < descriptor.length() && descriptor.charAt(cursor) != ')') {
+      final int next = r0dump_consumeDescriptorType(descriptor, cursor, false);
+      if (next <= cursor) {
+        return false;
+      }
+      cursor = next;
+    }
+    if (cursor >= descriptor.length() || descriptor.charAt(cursor) != ')') {
+      return false;
+    }
+    return r0dump_consumeDescriptorType(descriptor, cursor + 1, true) == descriptor.length();
+  }
+
+  private static int r0dump_consumeDescriptorType(
+      String descriptor, int cursor, boolean allowVoid) {
+    final int start = cursor;
+    while (cursor < descriptor.length() && descriptor.charAt(cursor) == '[') {
+      cursor++;
+    }
+    if (cursor >= descriptor.length()) {
+      return -1;
+    }
+    final boolean isArray = cursor != start;
+    final char kind = descriptor.charAt(cursor++);
+    if (kind == 'V') {
+      return allowVoid && !isArray ? cursor : -1;
+    }
+    if ("BCDFIJSZ".indexOf(kind) >= 0) {
+      return cursor;
+    }
+    if (kind != 'L') {
+      return -1;
+    }
+    final int end = descriptor.indexOf(';', cursor);
+    if (end < cursor || end < 0) {
+      return -1;
+    }
+    final String className = descriptor.substring(cursor, end);
+    if (className.indexOf('.') >= 0) {
+      return -1;
+    }
+    for (String segment : className.split("/", -1)) {
+      if (!r0dump_isJavaIdentifierSegment(segment, true)) {
+        return -1;
+      }
+    }
+    return end + 1;
+  }
+
+  private static boolean r0dump_isJavaIdentifierSegment(String value, boolean allowDollar) {
+    if (value.isEmpty() || !r0dump_isIdentifierStart(value.charAt(0), allowDollar)) {
+      return false;
+    }
+    for (int i = 1; i < value.length(); i++) {
+      final char ch = value.charAt(i);
+      if (!r0dump_isAsciiAlphaNumeric(ch) && ch != '_' && (!allowDollar || ch != '$')) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  private static boolean r0dump_isIdentifierStart(char ch, boolean allowDollar) {
+    return r0dump_isAsciiAlpha(ch) || ch == '_' || (allowDollar && ch == '$');
+  }
+
+  private static boolean r0dump_isAsciiAlphaNumeric(char ch) {
+    return r0dump_isAsciiAlpha(ch) || (ch >= '0' && ch <= '9');
+  }
+
+  private static boolean r0dump_isAsciiAlpha(char ch) {
+    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z');
+  }
+
+  static String r0dump_getOutputParent(Context appContext) {
+    try {
+      final File directory = appContext.getExternalFilesDir(null);
+      return directory == null ? null : directory.getAbsolutePath();
+    } catch (RuntimeException e) {
+      return null;
+    }
+  }
+
+  private static boolean r0dump_isTrustedOutputParent(String outputParent, String packageName) {
+    final int userId = UserHandle.getUserId(Process.myUid());
+    return ("/storage/emulated/" + userId + "/Android/data/" + packageName + "/files")
+        .equals(outputParent);
+  }
+
+  private String r0dump_propertyValue(String field) {
+    switch (field) {
+      case "schema":
+        return Integer.toString(schema);
+      case "enabled":
+        return enabled ? "1" : "0";
+      case "run_id":
+        return runId;
+      case "target_package":
+        return targetPackage;
+      case "target_process":
+        return targetProcess;
+      case "capture_point_mask":
+        return String.format(Locale.ROOT, "0x%016x", capturePointMask);
+      case "max_records":
+        return Long.toString(maxRecords);
+      case "max_artifacts":
+        return Long.toString(maxArtifacts);
+      case "max_total_bytes":
+        return Long.toString(maxTotalBytes);
+      case "max_dex_bytes":
+        return Long.toString(maxDexBytes);
+      case "buffer_pool_bytes":
+        return Long.toString(bufferPoolBytes);
+      case "max_code_item_bytes":
+        return Long.toString(maxCodeItemBytes);
+      case "max_frozen_generations":
+        return Long.toString(maxFrozenGenerations);
+      case "flush_idle_ms":
+        return Long.toString(flushIdleMs);
+      case "manifest_enabled":
+        return manifestEnabled ? "1" : "0";
+      case "manifest_include_splits":
+        return manifestIncludeSplits ? "1" : "0";
+      case "manifest_max_components":
+        return Long.toString(manifestMaxComponents);
+      case "manifest_max_splits":
+        return Long.toString(manifestMaxSplits);
+      case "manifest_max_events_per_source":
+        return Long.toString(manifestMaxEventsPerSource);
+      case "manifest_max_total_events":
+        return Long.toString(manifestMaxTotalEvents);
+      case "manifest_max_xml_depth":
+        return Long.toString(manifestMaxXmlDepth);
+      case "manifest_max_attribute_length":
+        return Long.toString(manifestMaxAttributeLength);
+      case "walk_enabled":
+        return walkEnabled ? "1" : "0";
+      case "walk_start":
+        return walkStart == WALK_START_AFTER_APPLICATION_ON_CREATE
+            ? "after_application_on_create"
+            : "after_first_activity_on_create";
+      case "walk_mode":
+        return walkMode == WALK_MODE_LOADED_ONLY ? "loaded_only" : "dex_names";
+      case "walk_delay_ms":
+        return Long.toString(walkDelayMs);
+      case "walk_max_classes":
+        return Long.toString(walkMaxClasses);
+      case "walk_max_methods":
+        return Long.toString(walkMaxMethods);
+      case "force_invoke_enabled":
+        return forceInvokeEnabled ? "1" : "0";
+      case "force_class":
+        return forceClass;
+      case "force_method":
+        return forceMethod;
+      case "force_method_descriptor":
+        return forceMethodDescriptor;
+      case "force_max_calls":
+        return Long.toString(forceMaxCalls);
+      case "anr_protection_enabled":
+        return anrProtectionEnabled ? "1" : "0";
+      default:
+        throw r0dump_invalid("property_field");
+    }
+  }
+
+  private static IllegalArgumentException r0dump_invalid(String field) {
+    return new IllegalArgumentException(field);
+  }
+
+  interface r0dump_Publisher {
+    boolean r0dump_publish(r0dump_FusionConfig config, String processName, String outputParent);
+  }
+
+  interface r0dump_PropertyAccess {
+    String r0dump_get(String key, String defaultValue);
+
+    void r0dump_set(String key, String value);
+  }
+}
