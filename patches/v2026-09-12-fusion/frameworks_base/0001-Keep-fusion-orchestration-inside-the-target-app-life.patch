+  private static void r0dump_validateStrictJson(String rawConfig) throws IOException {
+    final Set<String> names = new HashSet<>();
+    try (JsonReader reader = new JsonReader(new StringReader(rawConfig))) {
+      reader.beginObject();
+      while (reader.hasNext()) {
+        final String name = reader.nextName();
+        if (!names.add(name)) {
+          throw r0dump_invalid("duplicate_field");
+        }
+        reader.skipValue();
+      }
+      reader.endObject();
+      if (reader.peek() != JsonToken.END_DOCUMENT) {
+        throw r0dump_invalid("json_syntax");
+      }
+    }
+  }
