+package android.app;
+
+import android.content.pm.ApplicationInfo;
+import dalvik.system.r0dump_Runtime;
+import java.lang.reflect.Constructor;
+import java.lang.reflect.Executable;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.IdentityHashMap;
+import java.util.concurrent.atomic.AtomicReference;
+
+/** Process-local, bounded ClassLoader inventory for r0dump. */
+final class r0dump_ClassLoaderWalk {
+  private static final int r0dump_SOURCE_COOKIE = 0;
+  private static final int r0dump_SOURCE_LOADED_TABLE = 1;
+  private static final int r0dump_SOURCE_MANIFEST = 2;
+
+  private static final AtomicReference<r0dump_Request> r0dump_REQUEST = new AtomicReference<>();
+
+  private static final class r0dump_Request {
+    final r0dump_FusionConfig config;
+    final LoadedApk loadedApk;
+    final ApplicationInfo appInfo;
+
+    r0dump_Request(r0dump_FusionConfig config, LoadedApk loadedApk, ApplicationInfo appInfo) {
+      this.config = config;
+      this.loadedApk = loadedApk;
+      this.appInfo = new ApplicationInfo(appInfo);
+    }
+  }
+
+  private static final class r0dump_State {
+    final int maxClasses;
+    final int maxExecutables;
+    final IdentityHashMap<ClassLoader, HashSet<String>> seenClasses = new IdentityHashMap<>();
+    int classCount;
+    int executableCount;
+
+    r0dump_State(r0dump_FusionConfig config) {
+      maxClasses = (int) config.walkMaxClasses;
+      maxExecutables = (int) config.walkMaxMethods;
+    }
+
+    boolean r0dump_hasClassBudget() {
+      return classCount < maxClasses && executableCount < maxExecutables;
+    }
+
+    boolean r0dump_markClass(ClassLoader loader, String className) {
+      HashSet<String> names = seenClasses.get(loader);
+      if (names == null) {
+        names = new HashSet<>();
+        seenClasses.put(loader, names);
+      }
+      if (!names.add(className)) {
+        return false;
+      }
+      classCount++;
+      return true;
+    }
+  }
+
+  private r0dump_ClassLoaderWalk() {}
+
+  static void r0dump_prepare(
+      r0dump_FusionConfig config, LoadedApk loadedApk, ApplicationInfo appInfo) {
+    if (config == null || loadedApk == null || appInfo == null) {
+      return;
+    }
+    r0dump_REQUEST.compareAndSet(null, new r0dump_Request(config, loadedApk, appInfo));
+  }
+
+  static void r0dump_schedule(int walkStart) {
+    final r0dump_Request request = r0dump_REQUEST.get();
+    if (request == null || request.config.walkStart != walkStart) {
+      return;
+    }
+    final ClassLoader contextLoader = Thread.currentThread().getContextClassLoader();
+    r0dump_FileWorker.r0dump_schedule(
+        request.config.walkDelayMs, () -> r0dump_run(request, contextLoader));
+  }
+
+  private static boolean r0dump_run(r0dump_Request request, ClassLoader contextLoader) {
+    final r0dump_ManifestHelper.r0dump_Snapshot r0dump_manifest;
+    if (request.config.manifestEnabled) {
+      r0dump_manifest =
+          r0dump_ManifestHelper.r0dump_parse(
+              request.loadedApk,
+              request.appInfo,
+              request.config.targetPackage,
+              request.config.manifestIncludeSplits,
+              new r0dump_ManifestHelper.r0dump_Limits(
+                  (int) request.config.manifestMaxComponents,
+                  (int) request.config.manifestMaxSplits,
+                  (int) request.config.manifestMaxEventsPerSource,
+                  (int) request.config.manifestMaxTotalEvents,
+                  (int) request.config.manifestMaxXmlDepth,
+                  (int) request.config.manifestMaxAttributeLength));
+      r0dump_publishManifestSnapshot(r0dump_manifest);
+    } else {
+      r0dump_manifest = null;
+    }
+    if (request.config.walkEnabled || request.config.forceInvokeEnabled) {
+      final ClassLoader applicationLoader;
+      try {
+        applicationLoader = request.loadedApk.getClassLoader();
+      } catch (RuntimeException e) {
+        return false;
+      }
+
+      final ArrayList<ClassLoader> loaders = new ArrayList<>();
+      final IdentityHashMap<ClassLoader, Boolean> seenLoaders = new IdentityHashMap<>();
+      r0dump_addLoaderChain(applicationLoader, loaders, seenLoaders);
+      r0dump_addLoaderChain(contextLoader, loaders, seenLoaders);
+      try {
+        final ClassLoader[] registeredLoaders = r0dump_Runtime.r0dump_GetRegisteredClassLoaders();
+        if (registeredLoaders != null) {
+          for (ClassLoader loader : registeredLoaders) {
+            r0dump_addLoaderChain(loader, loaders, seenLoaders);
+          }
+        }
+      } catch (RuntimeException | LinkageError ignored) {
+      }
+
+      if (request.config.walkEnabled) {
+        final r0dump_State state = new r0dump_State(request.config);
+        for (ClassLoader loader : loaders) {
+          if (!state.r0dump_hasClassBudget()) {
+            break;
+          }
+          r0dump_walkCookieNames(request.config, loader, state);
+          if (!state.r0dump_hasClassBudget()) {
+            break;
+          }
+          try {
+            r0dump_walkNames(
+                request.config,
+                loader,
+                r0dump_Runtime.r0dump_GetLoadedClassNames(loader),
+                null,
+                r0dump_SOURCE_LOADED_TABLE,
+                state);
+          } catch (RuntimeException | LinkageError ignored) {
+          }
+          if (loader == applicationLoader
+              && request.config.manifestEnabled
+              && state.r0dump_hasClassBudget()) {
+            r0dump_walkManifestNames(r0dump_manifest, request.config, applicationLoader, state);
+          }
+        }
+      }
+      if (request.config.forceInvokeEnabled) {
+        r0dump_forceInvoke(request.config, loaders);
+      }
+    }
+    return true;
+  }
+
+  private static void r0dump_publishManifestSnapshot(
+      r0dump_ManifestHelper.r0dump_Snapshot snapshot) {
+    final int seedCount = snapshot.seeds.size();
+    final String[] classNames = new String[seedCount];
+    final String[] seedKinds = new String[seedCount];
+    final int[] sourceOrdinals = new int[seedCount];
+    for (int i = 0; i < seedCount; i++) {
+      final r0dump_ManifestHelper.r0dump_ClassSeed seed = snapshot.seeds.get(i);
+      classNames[i] = seed.className;
+      seedKinds[i] = seed.kind.name();
+      sourceOrdinals[i] = seed.sourceOrdinal;
+    }
+    final int sourceCount = snapshot.sources.size();
+    final String[] sourceKinds = new String[sourceCount];
+    final String[] sourceStatuses = new String[sourceCount];
+    final int[] sourceEventCounts = new int[sourceCount];
+    final String[] sourceLimitHits = new String[sourceCount];
+    for (int i = 0; i < sourceCount; i++) {
+      final r0dump_ManifestHelper.r0dump_ManifestSource source = snapshot.sources.get(i);
+      sourceKinds[i] =
+          source.kind == r0dump_ManifestHelper.r0dump_SourceKind.BASE ? "base" : "split";
+      sourceStatuses[i] = source.status.name();
+      sourceEventCounts[i] = source.eventCount;
+      sourceLimitHits[i] =
+          source.limitHit == r0dump_ManifestHelper.r0dump_LimitKind.NONE
+              ? null
+              : source.limitHit.name();
+    }
+    r0dump_Runtime.r0dump_PublishManifestSnapshot(
+        snapshot.status.name(),
+        snapshot.packageName,
+        classNames,
+        seedKinds,
+        sourceOrdinals,
+        sourceKinds,
+        sourceStatuses,
+        sourceEventCounts,
+        sourceLimitHits,
+        snapshot.sourceCount,
+        snapshot.parsedSourceCount,
+        snapshot.rejectedSourceCount,
+        snapshot.xmlEventCount,
+        snapshot.limitHit == r0dump_ManifestHelper.r0dump_LimitKind.NONE
+            ? null
+            : snapshot.limitHit.name());
+  }
+
+  private static void r0dump_addLoaderChain(
+      ClassLoader loader,
+      ArrayList<ClassLoader> loaders,
+      IdentityHashMap<ClassLoader, Boolean> seenLoaders) {
+    for (ClassLoader current = loader;
+        current != null && seenLoaders.put(current, Boolean.TRUE) == null;
+        current = current.getParent()) {
+      loaders.add(current);
+    }
+  }
+
+  private static void r0dump_walkCookieNames(
+      r0dump_FusionConfig config, ClassLoader loader, r0dump_State state) {
+    final Object[] cookies;
+    try {
+      cookies = r0dump_Runtime.r0dump_GetDexCookies(loader);
+    } catch (RuntimeException | LinkageError e) {
+      return;
+    }
+    if (cookies == null) {
+      return;
+    }
+    for (Object cookie : cookies) {
+      if (cookie == null || !state.r0dump_hasClassBudget()) {
+        continue;
+      }
+      try {
+        r0dump_Runtime.r0dump_CaptureCookie(cookie, r0dump_SOURCE_COOKIE);
+        r0dump_walkNames(
+            config,
+            loader,
+            r0dump_Runtime.r0dump_GetCookieClassNames(cookie),
+            cookie,
+            r0dump_SOURCE_COOKIE,
+            state);
+      } catch (RuntimeException | LinkageError ignored) {
+      }
+    }
+  }
+
+  private static void r0dump_walkManifestNames(
+      r0dump_ManifestHelper.r0dump_Snapshot snapshot,
+      r0dump_FusionConfig config,
+      ClassLoader applicationLoader,
+      r0dump_State state) {
+    if (snapshot == null) {
+      return;
+    }
+    final String[] names = new String[snapshot.seeds.size()];
+    for (int i = 0; i < snapshot.seeds.size(); i++) {
+      names[i] = snapshot.seeds.get(i).className;
+    }
+    r0dump_walkNames(config, applicationLoader, names, null, r0dump_SOURCE_MANIFEST, state);
+  }
+
+  private static void r0dump_walkNames(
+      r0dump_FusionConfig config,
+      ClassLoader loader,
+      String[] classNames,
+      Object cookie,
+      int sourceId,
+      r0dump_State state) {
+    if (classNames == null) {
+      return;
+    }
+    for (String className : classNames) {
+      if (!state.r0dump_hasClassBudget()) {
+        return;
+      }
+      if (className == null || className.isEmpty() || !state.r0dump_markClass(loader, className)) {
+        continue;
+      }
+      try {
+        final Class<?> klass =
+            config.walkMode == r0dump_FusionConfig.WALK_MODE_LOADED_ONLY
+                ? r0dump_Runtime.r0dump_FindLoadedClass(loader, className)
+                : Class.forName(className, false, loader);
+        if (klass != null) {
+          r0dump_captureExecutables(klass, cookie, className, sourceId, state);
+        }
+      } catch (ClassNotFoundException | SecurityException | LinkageError ignored) {
+      }
+    }
+  }
+
+  private static void r0dump_captureExecutables(
+      Class<?> klass, Object cookie, String className, int sourceId, r0dump_State state) {
+    final Method[] methods;
+    final Constructor<?>[] constructors;
+    try {
+      methods = klass.getDeclaredMethods();
+      constructors = klass.getDeclaredConstructors();
+    } catch (SecurityException | LinkageError e) {
+      return;
+    }
+    for (Method method : methods) {
+      if (state.executableCount >= state.maxExecutables) {
+        return;
+      }
+      state.executableCount++;
+      try {
+        r0dump_Runtime.r0dump_CaptureExecutable(method, cookie, className, sourceId);
+      } catch (RuntimeException | LinkageError ignored) {
+      }
+    }
+    for (Constructor<?> constructor : constructors) {
+      if (state.executableCount >= state.maxExecutables) {
+        return;
+      }
+      state.executableCount++;
+      try {
+        r0dump_Runtime.r0dump_CaptureExecutable(constructor, cookie, className, sourceId);
+      } catch (RuntimeException | LinkageError ignored) {
+      }
+    }
+  }
+
+  private static void r0dump_forceInvoke(
+      r0dump_FusionConfig config, ArrayList<ClassLoader> loaders) {
+    if (!config.forceInvokeEnabled) {
+      return;
+    }
+    final IdentityHashMap<Class<?>, Boolean> seenClasses = new IdentityHashMap<>();
+    int captured = 0;
+    for (ClassLoader loader : loaders) {
+      if (captured >= config.forceMaxCalls) {
+        return;
+      }
+      try {
+        final Class<?> klass = Class.forName(config.forceClass, false, loader);
+        if (seenClasses.put(klass, Boolean.TRUE) != null) {
+          continue;
+        }
+        final Executable executable = r0dump_findForceExecutable(klass, config);
+        if (executable != null
+            && r0dump_Runtime.r0dump_ForceInvoke(executable, null, config.forceClass)) {
+          captured++;
+        }
+      } catch (ClassNotFoundException | SecurityException | LinkageError ignored) {
+      }
+    }
+  }
+
+  private static Executable r0dump_findForceExecutable(Class<?> klass, r0dump_FusionConfig config) {
+    Executable match = null;
+    for (Method method : klass.getDeclaredMethods()) {
+      if (config.forceMethod.equals(method.getName())
+          && config.forceMethodDescriptor.equals(r0dump_descriptor(method))) {
+        if (match != null) {
+          return null;
+        }
+        match = method;
+      }
+    }
+    for (Constructor<?> constructor : klass.getDeclaredConstructors()) {
+      if ("<init>".equals(config.forceMethod)
+          && config.forceMethodDescriptor.equals(r0dump_descriptor(constructor))) {
+        if (match != null) {
+          return null;
+        }
+        match = constructor;
+      }
+    }
+    return match;
+  }
+
+  private static String r0dump_descriptor(Executable executable) {
+    final StringBuilder descriptor = new StringBuilder("(");
+    for (Class<?> parameterType : executable.getParameterTypes()) {
+      descriptor.append(r0dump_descriptor(parameterType));
+    }
+    descriptor.append(')');
+    descriptor.append(
+        executable instanceof Method
+            ? r0dump_descriptor(((Method) executable).getReturnType())
+            : "V");
+    return descriptor.toString();
+  }
+
+  private static String r0dump_descriptor(Class<?> type) {
+    if (type.isPrimitive()) {
+      if (type == void.class) return "V";
+      if (type == boolean.class) return "Z";
+      if (type == byte.class) return "B";
+      if (type == char.class) return "C";
+      if (type == short.class) return "S";
+      if (type == int.class) return "I";
+      if (type == long.class) return "J";
+      if (type == float.class) return "F";
+      return "D";
+    }
+    if (type.isArray()) {
+      return type.getName().replace('.', '/');
+    }
+    return "L" + type.getName().replace('.', '/') + ";";
+  }
+}
