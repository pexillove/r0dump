+
+package com.android.frameworks.coretests.r0dumpforce;
+
+import android.app.Application;
+import android.content.SharedPreferences;
+
+public final class r0dump_ForceFixtureApplication extends Application {
+  private static final String r0dump_PREFS = "r0dump_force_counts";
+  private static r0dump_ForceFixtureApplication r0dump_instance;
+
+  @Override
+  public void onCreate() {
+    super.onCreate();
+    r0dump_instance = this;
+  }
+
+  static void r0dump_increment(String key) {
+    final r0dump_ForceFixtureApplication application = r0dump_instance;
+    if (application == null) {
+      throw new IllegalStateException("fixture application is not ready");
+    }
+    final SharedPreferences preferences =
+        application.getSharedPreferences(r0dump_PREFS, MODE_PRIVATE);
+    final int next = preferences.getInt(key, 0) + 1;
+    if (!preferences.edit().putInt(key, next).commit()) {
+      throw new IllegalStateException("fixture counter write failed");
+    }
+  }
+}
