+  private ApplicationInfo r0dump_applicationInfo(boolean includeSplit) {
+    final ApplicationInfo appInfo = new ApplicationInfo();
+    appInfo.packageName = PACKAGE_NAME;
+    appInfo.sourceDir = mBasePath;
+    appInfo.splitSourceDirs = includeSplit ? new String[] {mSplitPath} : null;
+    return appInfo;
+  }
+
+  private static r0dump_ManifestHelper.r0dump_Snapshot r0dump_parse(
+      LoadedApk loadedApk,
+      ApplicationInfo appInfo,
+      String expectedPackage,
+      boolean includeSplits,
+      int maxComponents) {
+    return r0dump_ManifestHelper.r0dump_parse(
+        loadedApk, appInfo, expectedPackage, includeSplits, r0dump_limits(maxComponents));
+  }
+
+  private static r0dump_ManifestHelper.r0dump_SourceResult r0dump_parseSource(
+      XmlResourceParser parser, int sourceOrdinal, int remainingComponents, int remainingEvents) {
+    return r0dump_ManifestHelper.r0dump_parseSource(
+        parser,
+        sourceOrdinal,
+        r0dump_limits(remainingComponents),
+        remainingComponents,
+        remainingEvents);
+  }
+
+  private static String r0dump_normalizeClassName(String packageName, String rawClassName) {
+    return r0dump_ManifestHelper.r0dump_normalizeClassName(packageName, rawClassName, 1024);
+  }
+
+  private static r0dump_ManifestHelper.r0dump_Limits r0dump_limits(int maxComponents) {
+    return new r0dump_ManifestHelper.r0dump_Limits(maxComponents, 32, 16384, 65536, 64, 1024);
+  }
+
+  private String r0dump_extractApk(int id) throws Exception {
+    final String entryName = mContext.getResources().getResourceEntryName(id);
+    final File path = new File(mContext.getFilesDir(), entryName + ".apk");
+    try (InputStream input = mContext.getResources().openRawResource(id)) {
+      FileUtils.copyToFileOrThrow(input, path);
+    }
+    return path.getAbsolutePath();
+  }
+
+  private static List<String> r0dump_seedNames(r0dump_ManifestHelper.r0dump_Snapshot snapshot) {
+    final ArrayList<String> names = new ArrayList<>();
+    for (r0dump_ManifestHelper.r0dump_ClassSeed seed : snapshot.seeds) {
+      names.add(seed.className);
+    }
+    return names;
+  }
+}
