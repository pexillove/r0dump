+  private static final class r0dump_RecordingPublisher
+      implements r0dump_FusionConfig.r0dump_Publisher {
+    int callCount;
+    r0dump_FusionConfig config;
+    String processName;
+    String outputParent;
+
+    @Override
+    public boolean r0dump_publish(
+        r0dump_FusionConfig config, String processName, String outputParent) {
+      callCount++;
+      this.config = config;
+      this.processName = processName;
+      this.outputParent = outputParent;
+      return true;
+    }
+  }
+
+  private static final class r0dump_FakeProperties
+      implements r0dump_FusionConfig.r0dump_PropertyAccess {
+    final Map<String, String> values = new HashMap<>();
+    boolean changeGenerationAfterFirstRead;
+    int generationReads;
+
+    @Override
+    public String r0dump_get(String key, String defaultValue) {
+      if (key.equals(r0dump_FusionConfig.PROPERTY_PREFIX + "generation")) {
+        generationReads++;
+        if (changeGenerationAfterFirstRead && generationReads > 1) {
+          return Long.toString(Long.parseLong(values.get(key)) + 2L);
+        }
+      }
+      return values.getOrDefault(key, defaultValue);
+    }
+
+    @Override
+    public void r0dump_set(String key, String value) {
+      values.put(key, value);
+    }
+  }
