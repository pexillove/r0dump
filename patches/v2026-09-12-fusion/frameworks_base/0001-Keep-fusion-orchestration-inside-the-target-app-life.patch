+
+package android.app;
+
+import android.os.SystemClock;
+import dalvik.system.r0dump_Runtime;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+interface r0dump_Work {
+  boolean r0dump_run();
+}
+
+/** The sole process-local daemon responsible for deferred r0dump file flushing. */
+final class r0dump_FileWorker {
+  private static final String r0dump_WORKER_NAME = "r0dump-fusion-writer";
+  private static final AtomicBoolean r0dump_SCHEDULED = new AtomicBoolean();
+
+  private r0dump_FileWorker() {}
+
+  static void r0dump_schedule(long delayMs, r0dump_Work work) {
+    if (work == null || !r0dump_SCHEDULED.compareAndSet(false, true)) {
+      return;
+    }
+    final Thread worker =
+        new Thread(
+            () -> {
+              boolean r0dump_completed = false;
+              try {
+                r0dump_waitAndServiceFlush(delayMs);
+                r0dump_completed = work.r0dump_run();
+              } finally {
+                boolean r0dump_due = r0dump_Runtime.r0dump_CompleteWalk(r0dump_completed);
+                while (r0dump_due) {
+                  r0dump_due = r0dump_Runtime.r0dump_ServiceFlush();
+                }
+                r0dump_serviceFlushForever();
+              }
+            },
+            r0dump_WORKER_NAME);
+    worker.setDaemon(true);
+    worker.start();
+  }
+
+  private static void r0dump_waitAndServiceFlush(long delayMs) {
+    long r0dump_remaining = delayMs;
+    do {
+      final long r0dump_slice = Math.min(r0dump_remaining, 500L);
+      if (r0dump_slice > 0L) {
+        SystemClock.sleep(r0dump_slice);
+        r0dump_remaining -= r0dump_slice;
+      }
+      while (r0dump_Runtime.r0dump_ServiceFlush()) {}
+    } while (r0dump_remaining > 0L);
+  }
+
+  private static void r0dump_serviceFlushForever() {
+    while (true) {
+      SystemClock.sleep(250L);
+      while (r0dump_Runtime.r0dump_ServiceFlush()) {}
+    }
+  }
+}
