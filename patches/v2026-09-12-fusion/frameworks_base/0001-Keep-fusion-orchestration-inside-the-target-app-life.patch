+    assertThat(r0dump_normalizeClassName(PACKAGE_NAME, "foo/Bar")).isNull();
+    assertThat(r0dump_normalizeClassName(PACKAGE_NAME, "[Lfoo.Bar;")).isNull();
+    assertThat(r0dump_normalizeClassName(PACKAGE_NAME, "foo..Bar")).isNull();
