+package android.app;
+
+import android.content.pm.ApplicationInfo;
+import android.content.res.AssetManager;
+import android.content.res.XmlResourceParser;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import org.xmlpull.v1.XmlPullParser;
+import org.xmlpull.v1.XmlPullParserException;
+
+/** Parses trusted compiled manifests into class seeds for r0dump's future walk worker. */
+final class r0dump_ManifestHelper {
+  private static final String ANDROID_NAMESPACE = "http://schemas.android.com/apk/res/android";
+  private static final String MANIFEST_FILE = "AndroidManifest.xml";
+
+  static final class r0dump_Limits {
+    final int maxComponents;
+    final int maxSplits;
+    final int maxEventsPerSource;
+    final int maxTotalEvents;
+    final int maxXmlDepth;
+    final int maxAttributeLength;
+
+    r0dump_Limits(
+        int maxComponents,
+        int maxSplits,
+        int maxEventsPerSource,
+        int maxTotalEvents,
+        int maxXmlDepth,
+        int maxAttributeLength) {
+      this.maxComponents = maxComponents;
+      this.maxSplits = maxSplits;
+      this.maxEventsPerSource = maxEventsPerSource;
+      this.maxTotalEvents = maxTotalEvents;
+      this.maxXmlDepth = maxXmlDepth;
+      this.maxAttributeLength = maxAttributeLength;
+    }
+  }
+
+  enum r0dump_Status {
+    OK,
+    DISABLED,
+    NO_BASE_APK,
+    ASSET_COOKIE_MISSING,
+    XML_OPEN_FAILED,
+    MALFORMED_XML,
+    PACKAGE_MISSING,
+    PACKAGE_MISMATCH,
+    LIMIT_EXCEEDED,
+    PARTIAL_SPLIT_FAILURE
+  }
+
+  enum r0dump_SeedKind {
+    APPLICATION,
+    ACTIVITY,
+    ACTIVITY_ALIAS_TARGET,
+    SERVICE,
+    RECEIVER,
+    PROVIDER,
+    INSTRUMENTATION
+  }
+
+  enum r0dump_LimitKind {
+    NONE,
+    SOURCE_COUNT,
+    SOURCE_EVENT_COUNT,
+    TOTAL_EVENT_COUNT,
+    XML_DEPTH,
+    ATTRIBUTE_LENGTH,
+    COMPONENT_COUNT
+  }
+
+  enum r0dump_SourceKind {
+    BASE,
+    SPLIT
+  }
+
+  static final class r0dump_ClassSeed {
+    final String className;
+    final r0dump_SeedKind kind;
+    final int sourceOrdinal;
+
+    r0dump_ClassSeed(String className, r0dump_SeedKind kind, int sourceOrdinal) {
+      this.className = className;
+      this.kind = kind;
+      this.sourceOrdinal = sourceOrdinal;
+    }
+  }
+
+  static final class r0dump_ManifestSource {
+    final int ordinal;
+    final r0dump_SourceKind kind;
+    final r0dump_Status status;
+    final int eventCount;
+    final r0dump_LimitKind limitHit;
+
+    r0dump_ManifestSource(
+        int ordinal,
+        r0dump_SourceKind kind,
+        r0dump_Status status,
+        int eventCount,
+        r0dump_LimitKind limitHit) {
+      this.ordinal = ordinal;
+      this.kind = kind;
+      this.status = status;
+      this.eventCount = eventCount;
+      this.limitHit = limitHit;
+    }
+  }
+
+  static final class r0dump_Snapshot {
+    final r0dump_Status status;
+    final String packageName;
+    final List<r0dump_ClassSeed> seeds;
+    final List<r0dump_ManifestSource> sources;
+    final int sourceCount;
+    final int parsedSourceCount;
+    final int rejectedSourceCount;
+    final int xmlEventCount;
+    final r0dump_LimitKind limitHit;
+
+    r0dump_Snapshot(
+        r0dump_Status status,
+        String packageName,
+        List<r0dump_ClassSeed> seeds,
+        List<r0dump_ManifestSource> sources,
+        int sourceCount,
+        int parsedSourceCount,
+        int rejectedSourceCount,
+        int xmlEventCount,
+        r0dump_LimitKind limitHit) {
+      this.status = status;
+      this.packageName = packageName;
+      this.seeds = Collections.unmodifiableList(new ArrayList<>(seeds));
+      this.sources = Collections.unmodifiableList(new ArrayList<>(sources));
+      this.sourceCount = sourceCount;
+      this.parsedSourceCount = parsedSourceCount;
+      this.rejectedSourceCount = rejectedSourceCount;
+      this.xmlEventCount = xmlEventCount;
+      this.limitHit = limitHit;
+    }
+  }
+
+  static final class r0dump_SourceResult {
+    final r0dump_Status status;
+    final String packageName;
+    final List<r0dump_ClassSeed> seeds;
+    final int eventCount;
+    final r0dump_LimitKind limitHit;
+
+    r0dump_SourceResult(
+        r0dump_Status status, String packageName, List<r0dump_ClassSeed> seeds, int eventCount) {
+      this(status, packageName, seeds, eventCount, r0dump_LimitKind.NONE);
+    }
+
+    r0dump_SourceResult(
+        r0dump_Status status,
+        String packageName,
+        List<r0dump_ClassSeed> seeds,
+        int eventCount,
+        r0dump_LimitKind limitHit) {
+      this.status = status;
+      this.packageName = packageName;
+      this.seeds = seeds;
+      this.eventCount = eventCount;
+      this.limitHit = limitHit;
+    }
+  }
+
+  private static final class r0dump_LimitException extends Exception {
+    final r0dump_LimitKind kind;
+
+    r0dump_LimitException(r0dump_LimitKind kind) {
+      this.kind = kind;
+    }
+  }
+
+  private r0dump_ManifestHelper() {}
+
+  static r0dump_Snapshot r0dump_parse(
+      LoadedApk loadedApk,
+      ApplicationInfo appInfo,
+      String expectedPackage,
+      boolean includeSplits,
+      r0dump_Limits limits) {
+    if (loadedApk == null
+        || appInfo == null
+        || appInfo.sourceDir == null
+        || appInfo.sourceDir.isEmpty()) {
+      return r0dump_snapshot(r0dump_Status.NO_BASE_APK, null, List.of(), 0, 0, 0, 0);
+    }
+    if (limits == null
+        || limits.maxComponents <= 0
+        || limits.maxSplits < 0
+        || limits.maxEventsPerSource <= 0
+        || limits.maxTotalEvents < limits.maxEventsPerSource
+        || limits.maxXmlDepth <= 0
+        || limits.maxAttributeLength <= 0) {
+      return r0dump_snapshot(
+          r0dump_Status.LIMIT_EXCEEDED,
+          null,
+          List.of(),
+          1,
+          0,
+          0,
+          0,
+          r0dump_LimitKind.COMPONENT_COUNT);
+    }
+
+    final ArrayList<String> sourcePaths = new ArrayList<>();
+    sourcePaths.add(appInfo.sourceDir);
+    if (includeSplits && appInfo.splitSourceDirs != null) {
+      if (appInfo.splitSourceDirs.length > limits.maxSplits) {
+        return r0dump_snapshot(
+            r0dump_Status.LIMIT_EXCEEDED,
+            null,
+            List.of(),
+            1,
+            0,
+            1,
+            0,
+            r0dump_LimitKind.SOURCE_COUNT);
+      }
+      for (int i = 0; i < appInfo.splitSourceDirs.length; i++) {
+        sourcePaths.add(appInfo.splitSourceDirs[i]);
+      }
+    }
+
+    final AssetManager assets;
+    try {
+      assets = loadedApk.getAssets();
+    } catch (RuntimeException e) {
+      return r0dump_snapshot(
+          r0dump_Status.XML_OPEN_FAILED, null, List.of(), sourcePaths.size(), 0, 1, 0);
+    }
+
+    final ArrayList<r0dump_ClassSeed> seeds = new ArrayList<>();
+    final ArrayList<r0dump_ManifestSource> sources = new ArrayList<>();
+    String basePackage = null;
+    int parsedSourceCount = 0;
+    int rejectedSourceCount = 0;
+    int totalEventCount = 0;
+    boolean splitFailed = false;
+
+    for (int ordinal = 0; ordinal < sourcePaths.size(); ordinal++) {
+      final String sourcePath = sourcePaths.get(ordinal);
+      final int cookie;
+      try {
+        cookie = sourcePath == null ? 0 : assets.findCookieForPath(sourcePath);
+      } catch (RuntimeException e) {
+        sources.add(r0dump_source(ordinal, r0dump_Status.ASSET_COOKIE_MISSING, 0, null));
+        if (ordinal == 0) {
+          return r0dump_snapshot(
+              r0dump_Status.ASSET_COOKIE_MISSING,
+              null,
+              List.of(),
+              sourcePaths.size(),
+              0,
+              1,
+              totalEventCount,
+              r0dump_LimitKind.NONE,
+              sources);
+        }
+        rejectedSourceCount++;
+        splitFailed = true;
+        continue;
+      }
+      if (cookie <= 0) {
+        sources.add(r0dump_source(ordinal, r0dump_Status.ASSET_COOKIE_MISSING, 0, null));
+        if (ordinal == 0) {
+          return r0dump_snapshot(
+              r0dump_Status.ASSET_COOKIE_MISSING,
+              null,
+              List.of(),
+              sourcePaths.size(),
+              0,
+              1,
+              totalEventCount,
+              r0dump_LimitKind.NONE,
+              sources);
+        }
+        rejectedSourceCount++;
+        splitFailed = true;
+        continue;
+      }
+
+      final r0dump_SourceResult result =
+          r0dump_parseSource(
+              assets,
+              cookie,
+              ordinal,
+              limits,
+              limits.maxComponents - seeds.size(),
+              limits.maxTotalEvents - totalEventCount);
+      totalEventCount += result.eventCount;
+      if (result.status != r0dump_Status.OK) {
+        sources.add(r0dump_source(ordinal, result.status, result.eventCount, result.limitHit));
+        rejectedSourceCount++;
+        if (ordinal == 0 || result.status == r0dump_Status.LIMIT_EXCEEDED) {
+          return r0dump_snapshot(
+              result.status,
+              basePackage,
+              ordinal == 0 ? List.of() : seeds,
+              sourcePaths.size(),
+              parsedSourceCount,
+              rejectedSourceCount,
+              totalEventCount,
+              result.limitHit,
+              sources);
+        }
+        splitFailed = true;
+        continue;
+      }
+
+      if (ordinal == 0) {
+        basePackage = result.packageName;
+        if (basePackage == null || basePackage.isEmpty()) {
+          sources.add(
+              r0dump_source(ordinal, r0dump_Status.PACKAGE_MISSING, result.eventCount, null));
+          return r0dump_snapshot(
+              r0dump_Status.PACKAGE_MISSING,
+              null,
+              List.of(),
+              sourcePaths.size(),
+              0,
+              1,
+              totalEventCount,
+              r0dump_LimitKind.NONE,
+              sources);
+        }
+        if (!basePackage.equals(appInfo.packageName) || !basePackage.equals(expectedPackage)) {
+          sources.add(
+              r0dump_source(ordinal, r0dump_Status.PACKAGE_MISMATCH, result.eventCount, null));
+          return r0dump_snapshot(
+              r0dump_Status.PACKAGE_MISMATCH,
+              basePackage,
+              List.of(),
+              sourcePaths.size(),
+              0,
+              1,
+              totalEventCount,
+              r0dump_LimitKind.NONE,
+              sources);
+        }
+      } else if (!basePackage.equals(result.packageName)) {
+        sources.add(
+            r0dump_source(ordinal, r0dump_Status.PACKAGE_MISMATCH, result.eventCount, null));
+        rejectedSourceCount++;
+        splitFailed = true;
+        continue;
+      }
+
+      seeds.addAll(result.seeds);
+      sources.add(r0dump_source(ordinal, r0dump_Status.OK, result.eventCount, null));
+      parsedSourceCount++;
+    }
+
+    return r0dump_snapshot(
+        splitFailed ? r0dump_Status.PARTIAL_SPLIT_FAILURE : r0dump_Status.OK,
+        basePackage,
+        seeds,
+        sourcePaths.size(),
+        parsedSourceCount,
+        rejectedSourceCount,
+        totalEventCount,
+        r0dump_LimitKind.NONE,
+        sources);
+  }
+
+  private static r0dump_SourceResult r0dump_parseSource(
+      AssetManager assets,
+      int cookie,
+      int sourceOrdinal,
+      r0dump_Limits limits,
+      int remainingComponents,
+      int remainingEvents) {
+    final XmlResourceParser parser;
+    try {
+      parser = assets.openXmlResourceParser(cookie, MANIFEST_FILE);
+    } catch (IOException e) {
+      return new r0dump_SourceResult(
+          r0dump_Status.XML_OPEN_FAILED, null, List.of(), 0, r0dump_LimitKind.NONE);
+    } catch (RuntimeException e) {
+      return new r0dump_SourceResult(
+          r0dump_Status.MALFORMED_XML, null, List.of(), 0, r0dump_LimitKind.NONE);
+    }
+    return r0dump_parseSource(parser, sourceOrdinal, limits, remainingComponents, remainingEvents);
+  }
+
+  static r0dump_SourceResult r0dump_parseSource(
+      XmlResourceParser parser,
+      int sourceOrdinal,
+      r0dump_Limits limits,
+      int remainingComponents,
+      int remainingEvents) {
+    if (remainingEvents <= 0) {
+      parser.close();
+      return new r0dump_SourceResult(
+          r0dump_Status.LIMIT_EXCEEDED, null, List.of(), 0, r0dump_LimitKind.TOTAL_EVENT_COUNT);
+    }
+
+    int eventCount = 0;
+    int applicationDepth = -1;
+    String packageName = null;
+    final ArrayList<r0dump_ClassSeed> seeds = new ArrayList<>();
+    try (parser) {
+      int event = parser.getEventType();
+      while (event != XmlPullParser.END_DOCUMENT) {
+        eventCount++;
+        if (eventCount > limits.maxEventsPerSource) {
+          throw new r0dump_LimitException(r0dump_LimitKind.SOURCE_EVENT_COUNT);
+        }
+        if (eventCount > remainingEvents) {
+          throw new r0dump_LimitException(r0dump_LimitKind.TOTAL_EVENT_COUNT);
+        }
+        if (parser.getDepth() > limits.maxXmlDepth) {
+          throw new r0dump_LimitException(r0dump_LimitKind.XML_DEPTH);
+        }
+        if (event == XmlPullParser.START_TAG) {
+          final int depth = parser.getDepth();
+          final String tag = parser.getName();
+          if (depth == 1 && "manifest".equals(tag)) {
+            packageName = r0dump_readAttribute(parser, null, "package", limits);
+          } else if (depth == 2 && "application".equals(tag)) {
+            applicationDepth = depth;
+            r0dump_addSeed(
+                seeds,
+                packageName,
+                r0dump_readAttribute(parser, ANDROID_NAMESPACE, "name", limits),
+                r0dump_SeedKind.APPLICATION,
+                sourceOrdinal,
+                remainingComponents,
+                limits);
+          } else if (depth == 2 && "instrumentation".equals(tag)) {
+            r0dump_addSeed(
+                seeds,
+                packageName,
+                r0dump_readAttribute(parser, ANDROID_NAMESPACE, "name", limits),
+                r0dump_SeedKind.INSTRUMENTATION,
+                sourceOrdinal,
+                remainingComponents,
+                limits);
+          } else if (applicationDepth > 0 && depth == applicationDepth + 1) {
+            final r0dump_SeedKind kind = r0dump_componentKind(tag);
+            if (kind != null) {
+              final String attribute =
+                  kind == r0dump_SeedKind.ACTIVITY_ALIAS_TARGET ? "targetActivity" : "name";
+              r0dump_addSeed(
+                  seeds,
+                  packageName,
+                  r0dump_readAttribute(parser, ANDROID_NAMESPACE, attribute, limits),
+                  kind,
+                  sourceOrdinal,
+                  remainingComponents,
+                  limits);
+            }
+          }
+        } else if (event == XmlPullParser.END_TAG && parser.getDepth() == applicationDepth) {
+          applicationDepth = -1;
+        }
+        event = parser.next();
+      }
+    } catch (r0dump_LimitException e) {
+      return new r0dump_SourceResult(
+          r0dump_Status.LIMIT_EXCEEDED, packageName, List.of(), eventCount, e.kind);
+    } catch (IOException e) {
+      return new r0dump_SourceResult(
+          eventCount == 0 ? r0dump_Status.XML_OPEN_FAILED : r0dump_Status.MALFORMED_XML,
+          packageName,
+          List.of(),
+          eventCount);
+    } catch (XmlPullParserException | RuntimeException e) {
+      return new r0dump_SourceResult(
+          r0dump_Status.MALFORMED_XML, packageName, List.of(), eventCount);
+    }
+
+    if (packageName == null || packageName.isEmpty()) {
+      return new r0dump_SourceResult(r0dump_Status.PACKAGE_MISSING, null, List.of(), eventCount);
+    }
+    return new r0dump_SourceResult(r0dump_Status.OK, packageName, seeds, eventCount);
+  }
+
+  private static String r0dump_readAttribute(
+      XmlResourceParser parser, String namespace, String name, r0dump_Limits limits)
+      throws r0dump_LimitException {
+    final String value = parser.getAttributeValue(namespace, name);
+    if (value != null && value.length() > limits.maxAttributeLength) {
+      throw new r0dump_LimitException(r0dump_LimitKind.ATTRIBUTE_LENGTH);
+    }
+    return value;
+  }
+
+  private static r0dump_SeedKind r0dump_componentKind(String tag) {
+    switch (tag) {
+      case "activity":
+        return r0dump_SeedKind.ACTIVITY;
+      case "activity-alias":
+        return r0dump_SeedKind.ACTIVITY_ALIAS_TARGET;
+      case "service":
+        return r0dump_SeedKind.SERVICE;
+      case "receiver":
+        return r0dump_SeedKind.RECEIVER;
+      case "provider":
+        return r0dump_SeedKind.PROVIDER;
+      default:
+        return null;
+    }
+  }
+
+  private static void r0dump_addSeed(
+      List<r0dump_ClassSeed> seeds,
+      String packageName,
+      String rawClassName,
+      r0dump_SeedKind kind,
+      int sourceOrdinal,
+      int maxComponents,
+      r0dump_Limits limits)
+      throws r0dump_LimitException {
+    final String className =
+        r0dump_normalizeClassName(packageName, rawClassName, limits.maxAttributeLength);
+    if (className == null) {
+      return;
+    }
+    if (seeds.size() >= maxComponents) {
+      throw new r0dump_LimitException(r0dump_LimitKind.COMPONENT_COUNT);
+    }
+    seeds.add(new r0dump_ClassSeed(className, kind, sourceOrdinal));
+  }
+
+  static String r0dump_normalizeClassName(
+      String packageName, String rawClassName, int maxAttributeLength) {
+    if (packageName == null
+        || packageName.isEmpty()
+        || rawClassName == null
+        || rawClassName.isEmpty()
+        || rawClassName.length() > maxAttributeLength) {
+      return null;
+    }
+
+    final String className;
+    if (rawClassName.charAt(0) == '.') {
+      className = packageName + rawClassName;
+    } else if (rawClassName.indexOf('.') < 0) {
+      className = packageName + "." + rawClassName;
+    } else {
+      className = rawClassName;
+    }
+    if (className.length() > maxAttributeLength
+        || className.indexOf('/') >= 0
+        || className.indexOf(';') >= 0
+        || className.indexOf('[') >= 0
+        || className.indexOf('\0') >= 0) {
+      return null;
+    }
+
+    int segmentStart = 0;
+    while (segmentStart < className.length()) {
+      final int segmentEnd = className.indexOf('.', segmentStart);
+      final int end = segmentEnd < 0 ? className.length() : segmentEnd;
+      if (end == segmentStart || !Character.isJavaIdentifierStart(className.charAt(segmentStart))) {
+        return null;
+      }
+      for (int i = segmentStart + 1; i < end; i++) {
+        if (!Character.isJavaIdentifierPart(className.charAt(i))) {
+          return null;
+        }
+      }
+      if (segmentEnd < 0) {
+        return className;
+      }
+      segmentStart = segmentEnd + 1;
+    }
+    return null;
+  }
+
+  private static r0dump_Snapshot r0dump_snapshot(
+      r0dump_Status status,
+      String packageName,
+      List<r0dump_ClassSeed> seeds,
+      int sourceCount,
+      int parsedSourceCount,
+      int rejectedSourceCount,
+      int xmlEventCount) {
+    return r0dump_snapshot(
+        status,
+        packageName,
+        seeds,
+        sourceCount,
+        parsedSourceCount,
+        rejectedSourceCount,
+        xmlEventCount,
+        r0dump_LimitKind.NONE);
+  }
+
+  private static r0dump_Snapshot r0dump_snapshot(
+      r0dump_Status status,
+      String packageName,
+      List<r0dump_ClassSeed> seeds,
+      int sourceCount,
+      int parsedSourceCount,
+      int rejectedSourceCount,
+      int xmlEventCount,
+      r0dump_LimitKind limitHit) {
+    final ArrayList<r0dump_ManifestSource> sources = new ArrayList<>(sourceCount);
+    for (int ordinal = 0; ordinal < sourceCount; ordinal++) {
+      sources.add(
+          r0dump_source(
+              ordinal,
+              ordinal == 0 ? status : r0dump_Status.DISABLED,
+              ordinal == 0 ? xmlEventCount : 0,
+              ordinal == 0 ? limitHit : r0dump_LimitKind.NONE));
+    }
+    return r0dump_snapshot(
+        status,
+        packageName,
+        seeds,
+        sourceCount,
+        parsedSourceCount,
+        rejectedSourceCount,
+        xmlEventCount,
+        limitHit,
+        sources);
+  }
+
+  private static r0dump_Snapshot r0dump_snapshot(
+      r0dump_Status status,
+      String packageName,
+      List<r0dump_ClassSeed> seeds,
+      int sourceCount,
+      int parsedSourceCount,
+      int rejectedSourceCount,
+      int xmlEventCount,
+      r0dump_LimitKind limitHit,
+      List<r0dump_ManifestSource> sources) {
+    final ArrayList<r0dump_ManifestSource> completeSources = new ArrayList<>(sources);
+    for (int ordinal = completeSources.size(); ordinal < sourceCount; ordinal++) {
+      completeSources.add(r0dump_source(ordinal, r0dump_Status.DISABLED, 0, null));
+    }
+    return new r0dump_Snapshot(
+        status,
+        packageName,
+        seeds,
+        completeSources,
+        sourceCount,
+        parsedSourceCount,
+        rejectedSourceCount,
+        xmlEventCount,
+        limitHit);
+  }
+
+  private static r0dump_ManifestSource r0dump_source(
+      int ordinal, r0dump_Status status, int eventCount, r0dump_LimitKind limitHit) {
+    return new r0dump_ManifestSource(
+        ordinal,
+        ordinal == 0 ? r0dump_SourceKind.BASE : r0dump_SourceKind.SPLIT,
+        status,
+        eventCount,
+        limitHit == null ? r0dump_LimitKind.NONE : limitHit);
+  }
+}
