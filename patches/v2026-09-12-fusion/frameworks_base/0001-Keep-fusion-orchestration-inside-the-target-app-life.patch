+      throw r0dump_invalid("schema");
+    }
+    if (!r0dump_isRunId(runId)) {
+      throw r0dump_invalid("run_id");
+    }
+    if (!r0dump_isPackageName(targetPackage)) {
+      throw r0dump_invalid("target_package");
+    }
+    if (!r0dump_isTargetProcess(targetPackage, targetProcess)) {
+      throw r0dump_invalid("target_process");
+    }
+    if (!r0dump_fitsPropertyValue(runId)
+        || !r0dump_fitsPropertyValue(targetPackage)
+        || !r0dump_fitsPropertyValue(targetProcess)
+        || !r0dump_fitsPropertyValue(forceClass)
+        || !r0dump_fitsPropertyValue(forceMethod)
+        || !r0dump_fitsPropertyValue(forceMethodDescriptor)) {
+      throw r0dump_invalid("property_value_length");
+    }
+    if ((capturePointMask & ~DEFINED_CAPTURE_POINT_MASK) != 0) {
+      throw r0dump_invalid("capture_point_mask");
+    }
+    if (maxRecords == 0
+        || maxRecords > 4096
+        || maxArtifacts == 0
+        || maxArtifacts > 512
+        || maxArtifacts > maxRecords
+        || maxTotalBytes > 512L * 1024 * 1024
+        || maxDexBytes > 128L * 1024 * 1024
+        || maxDexBytes > maxTotalBytes
+        || bufferPoolBytes < maxDexBytes
+        || bufferPoolBytes > 256L * 1024 * 1024
+        || maxCodeItemBytes == 0
+        || maxCodeItemBytes > 1024L * 1024
+        || maxCodeItemBytes > bufferPoolBytes
+        || maxFrozenGenerations == 0
+        || maxFrozenGenerations > 4
+        || flushIdleMs == 0
+        || flushIdleMs > 60000) {
+      throw r0dump_invalid("budgets");
+    }
+    if (manifestMaxComponents == 0 || manifestMaxComponents > 16384) {
+      throw r0dump_invalid("manifest_max_components");
+    }
+    if (manifestMaxSplits > 32
+        || manifestMaxEventsPerSource == 0
+        || manifestMaxEventsPerSource > 262144
+        || manifestMaxTotalEvents < manifestMaxEventsPerSource
+        || manifestMaxTotalEvents > 1048576
+        || manifestMaxXmlDepth == 0
+        || manifestMaxXmlDepth > 256
+        || manifestMaxAttributeLength == 0
+        || manifestMaxAttributeLength > 4096) {
+      throw r0dump_invalid("manifest_limits");
+    }
+    if (walkMaxClasses == 0
+        || walkMaxClasses > 1000000
+        || walkMaxMethods == 0
+        || walkMaxMethods > 10000000) {
+      throw r0dump_invalid("walk_limits");
+    }
+    if (forceMaxCalls == 0 || forceMaxCalls > 8) {
+      throw r0dump_invalid("force_max_calls");
+    }
+    if (forceInvokeEnabled
+        && ((capturePointMask & FORCE_INVOKE_NO_EXECUTE_BIT) == 0
+            || !r0dump_isBinaryClassName(forceClass)
+            || !r0dump_isMethodName(forceMethod)
+            || !r0dump_isMethodDescriptor(forceMethodDescriptor))) {
+      throw r0dump_invalid("force_selector");
+    }
+  }
