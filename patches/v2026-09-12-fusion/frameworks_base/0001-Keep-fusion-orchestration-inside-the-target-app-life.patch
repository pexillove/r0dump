diff --git a/services/core/java/com/android/server/am/r0dump_anr_protection_source_test.py b/services/core/java/com/android/server/am/r0dump_anr_protection_source_test.py
new file mode 100644
index 000000000..30994cf96
--- /dev/null
+++ b/services/core/java/com/android/server/am/r0dump_anr_protection_source_test.py
@@ -0,0 +1,39 @@
+#!/usr/bin/env python3
+
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[7]
+PROCESS_ERROR = ROOT / "services/core/java/com/android/server/am/ProcessErrorStateRecord.java"
+CONFIG = ROOT / "core/java/android/app/r0dump_FusionConfig.java"
+
+
+def r0dump_require(source: str, needle: str) -> None:
+    if needle not in source:
+        raise AssertionError(f"missing source contract: {needle}")
+
+
+def main() -> None:
+    process_error = PROCESS_ERROR.read_text(encoding="utf-8")
+    config = CONFIG.read_text(encoding="utf-8")
+
+    r0dump_require(process_error, "import android.app.r0dump_FusionConfig;")
+    r0dump_require(
+        process_error,
+        "r0dump_FusionConfig.r0dump_shouldProtectAnr(packageName, mApp.processName)",
+    )
+    if process_error.count("r0dump_shouldSuppressAnrKillLocked(annotation)") != 3:
+        raise AssertionError("all three ANR kill exits must use the r0dump protection gate")
+    if "persist.sys.r0dump.fusion" in process_error or "SystemProperties" in process_error:
+        raise AssertionError("ProcessErrorStateRecord must not read r0dump properties directly")
+
+    r0dump_require(config, '"anr_protection_enabled"')
+    r0dump_require(
+        config,
+        'r0dump_readPropertyBoolean(properties, "anr_protection_enabled", "0")',
+    )
+    r0dump_require(config, "public static boolean r0dump_shouldProtectAnr(")
+
+
+if __name__ == "__main__":
+    main()
