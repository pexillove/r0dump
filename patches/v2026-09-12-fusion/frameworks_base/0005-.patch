+  static byte[] encodeExportRequest(int requesterUid, String packageName, int apkCount)
+      throws IOException {
+    if (requesterUid < 10000 || apkCount <= 0 || apkCount > MAX_APK_COUNT) {
+      throw new IOException("invalid export identity");
+    }
+    final ByteBuffer buffer =
+        ByteBuffer.allocate(EXPORT_REQUEST_BYTES).order(ByteOrder.LITTLE_ENDIAN);
+    buffer.putInt(EXPORT_MAGIC);
+    buffer.putShort(EXPORT_VERSION);
+    buffer.putShort((short) EXPORT_REQUEST_BYTES);
+    buffer.putInt(0); // Owner user only.
+    buffer.putInt(requesterUid);
+    buffer.putInt(apkCount);
+    putFixedString(buffer, packageName, PACKAGE_BYTES);
+    return buffer.array();
+  }
+
