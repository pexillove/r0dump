+    @Override
+    public ParcelFileDescriptor r0dump_exportLatest(String packageName) {
+        mContext.enforceCallingPermission(R0DUMP_EXPORT_PERMISSION,
+                "r0dump artifact export requires the Manager permission");
+        final int callingUid = Binder.getCallingUid();
+        final int callingPid = Binder.getCallingPid();
+        if (packageName == null
+                || UserHandle.getUserId(callingUid) != UserHandle.USER_SYSTEM
+                || mPackageManagerInt.getPackageUid(R0DUMP_MANAGER_PACKAGE, 0,
+                        UserHandle.USER_SYSTEM) != callingUid
+                || !mAtmInternal.isUidForeground(callingUid)) {
+            throw new SecurityException("r0dump artifact export requires the foreground owner Manager");
+        }
+        synchronized (this) {
+            synchronized (mPidsSelfLocked) {
+                final ProcessRecord process = mPidsSelfLocked.get(callingPid);
+                if (process == null
+                        || process.uid != callingUid
+                        || !process.getPkgList().containsKey(R0DUMP_MANAGER_PACKAGE)) {
+                    throw new SecurityException("r0dump artifact export caller identity mismatch");
+                }
+            }
+        }
+        final ApplicationInfo target = mPackageManagerInt.getApplicationInfo(
+                packageName, 0, Process.SYSTEM_UID, UserHandle.USER_SYSTEM);
+        if (target == null || target.sourceDir == null) {
+            return null;
+        }
+        final int splitCount = target.splitSourceDirs == null ? 0 : target.splitSourceDirs.length;
+        final String[] apkPaths = new String[splitCount + 1];
+        apkPaths[0] = target.sourceDir;
+        if (splitCount != 0) {
+            System.arraycopy(target.splitSourceDirs, 0, apkPaths, 1, splitCount);
+        }
+        try {
+            return mR0dumpFilePreparationBridge.exportLatest(callingUid, packageName, apkPaths);
+        } catch (IOException e) {
+            Slog.w(TAG, "Unable to request r0dump artifact export", e);
+            return null;
+        }
+    }
+
