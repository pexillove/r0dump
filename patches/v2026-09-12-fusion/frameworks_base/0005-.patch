+
+  @Test
+  public void encodeExportRequest_hasStableLayoutAndApkCount() throws Exception {
+    final byte[] request =
+        r0dump_FilePreparationBridge.encodeExportRequest(10195, "com.example.target", 3);
+
+    assertThat(request).hasLength(116);
+    final ByteBuffer buffer = ByteBuffer.wrap(request).order(ByteOrder.LITTLE_ENDIAN);
+    assertThat(buffer.getInt()).isEqualTo(0x52304558);
+    assertThat(buffer.getShort()).isEqualTo((short) 1);
+    assertThat(Short.toUnsignedInt(buffer.getShort())).isEqualTo(116);
+    assertThat(buffer.getInt()).isEqualTo(0);
+    assertThat(buffer.getInt()).isEqualTo(10195);
+    assertThat(buffer.getInt()).isEqualTo(3);
+    final byte[] packageBytes = new byte[96];
+    buffer.get(packageBytes);
+    assertThat(new String(packageBytes, 0, "com.example.target".length(), StandardCharsets.UTF_8))
+        .isEqualTo("com.example.target");
+  }
