+  ParcelFileDescriptor exportLatest(int requesterUid, String packageName, String[] apkPaths)
+      throws IOException {
+    if (apkPaths == null || apkPaths.length == 0 || apkPaths.length > MAX_APK_COUNT) {
+      throw new IOException("invalid APK path count");
+    }
+    final byte[] request = encodeExportRequest(requesterUid, packageName, apkPaths.length);
+    final ParcelFileDescriptor[] apkDescriptors = new ParcelFileDescriptor[apkPaths.length];
+    try {
+      final FileDescriptor[] descriptors = new FileDescriptor[apkPaths.length];
+      for (int i = 0; i < apkPaths.length; i++) {
+        apkDescriptors[i] =
+            ParcelFileDescriptor.open(new File(apkPaths[i]), ParcelFileDescriptor.MODE_READ_ONLY);
+        descriptors[i] = apkDescriptors[i].getFileDescriptor();
+      }
+      try (LocalSocket socket = new LocalSocket(LocalSocket.SOCKET_SEQPACKET)) {
+        socket.connect(
+            new LocalSocketAddress("r0dump_file_helper", LocalSocketAddress.Namespace.RESERVED));
+        socket.setSoTimeout(EXPORT_TIMEOUT_MS);
+        socket.setFileDescriptorsForSend(descriptors);
+        socket.getOutputStream().write(request);
+        socket.getOutputStream().flush();
+        socket.setFileDescriptorsForSend(null);
+        return ParcelFileDescriptor.dup(socket.getFileDescriptor());
+      }
+    } finally {
+      for (ParcelFileDescriptor descriptor : apkDescriptors) {
+        if (descriptor != null) {
+          descriptor.close();
+        }
+      }
+    }
+  }
+
