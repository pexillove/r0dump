+package com.android.server.am;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.junit.Assert.assertThrows;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import org.junit.Test;
+
+public class r0dump_FilePreparationBridgeTest {
+  @Test
+  public void encodeRequest_hasStableLittleEndianLayoutAndZeroPadding() throws Exception {
+    final byte[] request =
+        r0dump_FilePreparationBridge.encodeRequest(
+            10198, 2468, "com.coolapk.market", "com.coolapk.market:push", "run-1", 278L);
+
+    assertThat(request).hasLength(285);
+    final ByteBuffer buffer = ByteBuffer.wrap(request).order(ByteOrder.LITTLE_ENDIAN);
+    assertThat(buffer.getInt()).isEqualTo(0x52304648);
+    assertThat(buffer.getShort()).isEqualTo((short) 1);
+    assertThat(Short.toUnsignedInt(buffer.getShort())).isEqualTo(285);
+    assertThat(buffer.getLong()).isEqualTo(278L);
+    assertThat(buffer.getInt()).isEqualTo(0);
+    assertThat(buffer.getInt()).isEqualTo(10198);
+    assertThat(buffer.getInt()).isEqualTo(2468);
+
+    final byte[] packageBytes = new byte[96];
+    buffer.get(packageBytes);
+    assertThat(new String(packageBytes, 0, "com.coolapk.market".length(), StandardCharsets.UTF_8))
+        .isEqualTo("com.coolapk.market");
+    assertThat(packageBytes["com.coolapk.market".length()]).isEqualTo((byte) 0);
+  }
+
+  @Test
+  public void encodeRequest_rejectsOddGenerationAndOversizedField() {
+    assertThrows(
+        IOException.class,
+        () ->
+            r0dump_FilePreparationBridge.encodeRequest(
+                10198, 2468, "com.coolapk.market", "com.coolapk.market", "run", 3L));
+    assertThrows(
+        IOException.class,
+        () ->
+            r0dump_FilePreparationBridge.encodeRequest(
+                10198, 2468, "a".repeat(96), "process", "run", 4L));
+  }
+}
