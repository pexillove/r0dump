+package com.android.server.am;
+
+import static android.system.OsConstants.SOCK_SEQPACKET;
+
+import android.net.LocalSocket;
+import android.net.LocalSocketAddress;
+import android.os.ParcelFileDescriptor;
+import android.system.ErrnoException;
+import android.system.Os;
+import java.io.FileDescriptor;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+
+/** Fixed-protocol client for the init-owned r0dump file helper. */
+final class r0dump_FilePreparationBridge {
+  private static final int MAGIC = 0x52304648;
+  private static final short VERSION = 1;
+  private static final int PACKAGE_BYTES = 96;
+  private static final int PROCESS_BYTES = 96;
+  private static final int RUN_ID_BYTES = 65;
+  private static final int REQUEST_BYTES = 285;
+  private static final int RESPONSE_BYTES = 12;
+  private static final int STATUS_OK = 0;
+  private static final int TIMEOUT_MS = 2000;
+
+  ParcelFileDescriptor prepare(
+      int targetUid,
+      int targetPid,
+      String packageName,
+      String processName,
+      String runId,
+      long generation)
+      throws IOException {
+    final byte[] request =
+        encodeRequest(targetUid, targetPid, packageName, processName, runId, generation);
+    try (LocalSocket socket = new LocalSocket(LocalSocket.SOCKET_SEQPACKET)) {
+      socket.connect(
+          new LocalSocketAddress("r0dump_file_helper", LocalSocketAddress.Namespace.RESERVED));
+      // LocalSocket creates its native fd lazily. Socket options are only valid after connect().
+      socket.setSoTimeout(TIMEOUT_MS);
+      socket.getOutputStream().write(request);
+      socket.getOutputStream().flush();
+
+      final byte[] response = new byte[RESPONSE_BYTES];
+      readExactly(socket.getInputStream(), response);
+      final FileDescriptor[] received = socket.getAncillaryFileDescriptors();
+      try {
+        final ByteBuffer buffer = ByteBuffer.wrap(response).order(ByteOrder.LITTLE_ENDIAN);
+        if (buffer.getInt() != MAGIC
+            || buffer.getShort() != VERSION
+            || Short.toUnsignedInt(buffer.getShort()) != RESPONSE_BYTES
+            || buffer.getInt() != STATUS_OK
+            || received == null
+            || received.length != 1) {
+          return null;
+        }
+        return createDeliveryChannel(received);
+      } finally {
+        closeDescriptors(received);
+      }
+    }
+  }
+
+  private static ParcelFileDescriptor createDeliveryChannel(FileDescriptor[] directoryDescriptors)
+      throws IOException {
+    final ParcelFileDescriptor[] channel =
+        ParcelFileDescriptor.createSocketPair(SOCK_SEQPACKET);
+    try (ParcelFileDescriptor sender = channel[0]) {
+      final LocalSocket socket = new LocalSocket(sender.getFileDescriptor());
+      socket.setFileDescriptorsForSend(directoryDescriptors);
+      socket.getOutputStream().write(1);
+      socket.getOutputStream().flush();
+      final ParcelFileDescriptor receiver = channel[1];
+      channel[1] = null;
+      return receiver;
+    } finally {
+      if (channel[1] != null) {
+        channel[1].close();
+      }
+    }
+  }
+
+  static byte[] encodeRequest(
+      int targetUid,
+      int targetPid,
+      String packageName,
+      String processName,
+      String runId,
+      long generation)
+      throws IOException {
+    if (targetUid < 10000 || targetPid <= 0 || generation < 0 || (generation & 1L) != 0L) {
+      throw new IOException("invalid request identity");
+    }
+    final ByteBuffer buffer = ByteBuffer.allocate(REQUEST_BYTES).order(ByteOrder.LITTLE_ENDIAN);
+    buffer.putInt(MAGIC);
+    buffer.putShort(VERSION);
+    buffer.putShort((short) REQUEST_BYTES);
+    buffer.putLong(generation);
+    buffer.putInt(0); // Owner user only.
+    buffer.putInt(targetUid);
+    buffer.putInt(targetPid);
+    putFixedString(buffer, packageName, PACKAGE_BYTES);
+    putFixedString(buffer, processName, PROCESS_BYTES);
+    putFixedString(buffer, runId, RUN_ID_BYTES);
+    return buffer.array();
+  }
+
+  private static void putFixedString(ByteBuffer buffer, String value, int capacity)
+      throws IOException {
+    if (value == null) {
+      throw new IOException("missing request field");
+    }
+    final byte[] encoded = value.getBytes(StandardCharsets.UTF_8);
+    if (encoded.length == 0 || encoded.length >= capacity) {
+      throw new IOException("request field too long");
+    }
+    buffer.put(encoded);
+    buffer.position(buffer.position() + capacity - encoded.length);
+  }
+
+  private static void readExactly(InputStream input, byte[] destination) throws IOException {
+    int offset = 0;
+    while (offset < destination.length) {
+      final int read = input.read(destination, offset, destination.length - offset);
+      if (read < 0) {
+        throw new IOException("short helper response");
+      }
+      offset += read;
+    }
+  }
+
+  private static void closeDescriptors(FileDescriptor[] descriptors) {
+    if (descriptors == null) {
+      return;
+    }
+    for (FileDescriptor descriptor : descriptors) {
+      try {
+        Os.close(descriptor);
+      } catch (ErrnoException ignored) {
+      }
+    }
+  }
+}
