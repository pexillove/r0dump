       return false;
@@ -334,13 +401,86 @@ public final class r0dump_FusionConfig {
   }
 
   static boolean r0dump_shouldProtectAnr(
-      r0dump_FusionConfig config, String packageName, String processName) {
+      r0dump_FusionConfig config, int targetUid, String packageName, String processName) {
     return config != null
         && config.enabled
         && config.anrProtectionEnabled
+        && r0dump_isSystemUserUid(targetUid)
         && config.r0dump_matchesProcess(packageName, processName);
   }
 
+  private static long r0dump_requireExpectedStableGeneration(
+      r0dump_PropertyAccess properties, long expectedGeneration) {
+    if (expectedGeneration < 0L || (expectedGeneration & 1L) != 0L) {
+      throw r0dump_state("expected_generation");
+    }
+    final long generation = r0dump_readGeneration(properties);
+    if ((generation & 1L) != 0L) {
+      throw r0dump_state("generation_in_progress");
+    }
+    if (generation != expectedGeneration) {
+      throw r0dump_state("generation_conflict");
+    }
+    if (generation > Long.MAX_VALUE - 2L) {
+      throw r0dump_state("generation_exhausted");
+    }
+    return generation;
+  }
+
+  private static void r0dump_publishCompleteOrThrow(
+      r0dump_FusionConfig config, long generation, r0dump_PropertyAccess properties) {
+    final long publishingGeneration = generation + 1L;
+    try {
+      properties.r0dump_set(PROPERTY_GENERATION, Long.toString(publishingGeneration));
+      for (String field : FIELDS) {
+        properties.r0dump_set(PROPERTY_PREFIX + field, config.r0dump_propertyValue(field));
+      }
+      properties.r0dump_set(PROPERTY_GENERATION, Long.toString(publishingGeneration + 1L));
+    } catch (RuntimeException e) {
+      throw r0dump_state("property_write_failed");
+    }
+    r0dump_verifyCompleteOrThrow(config, publishingGeneration + 1L, properties);
+  }
+
+  private static void r0dump_publishDisabledOrThrow(
+      long generation, r0dump_PropertyAccess properties) {
+    final long publishingGeneration = generation + 1L;
+    try {
+      properties.r0dump_set(PROPERTY_GENERATION, Long.toString(publishingGeneration));
+      properties.r0dump_set(PROPERTY_PREFIX + "enabled", "0");
+      properties.r0dump_set(PROPERTY_GENERATION, Long.toString(publishingGeneration + 1L));
+    } catch (RuntimeException e) {
+      throw r0dump_state("property_write_failed");
+    }
+    r0dump_verifyDisabledOrThrow(publishingGeneration + 1L, properties);
+  }
+
+  private static void r0dump_verifyCompleteOrThrow(
+      r0dump_FusionConfig config, long expectedGeneration, r0dump_PropertyAccess properties) {
+    if (r0dump_readGeneration(properties) != expectedGeneration) {
+      throw r0dump_state("property_verification_failed");
+    }
+    for (String field : FIELDS) {
+      if (!config
+          .r0dump_propertyValue(field)
+          .equals(properties.r0dump_get(PROPERTY_PREFIX + field, ""))) {
+        throw r0dump_state("property_verification_failed");
+      }
+    }
+    if (r0dump_readGeneration(properties) != expectedGeneration) {
+      throw r0dump_state("property_verification_failed");
+    }
+  }
+
+  private static void r0dump_verifyDisabledOrThrow(
+      long expectedGeneration, r0dump_PropertyAccess properties) {
+    if (r0dump_readGeneration(properties) != expectedGeneration
+        || !"0".equals(properties.r0dump_get(PROPERTY_PREFIX + "enabled", ""))
+        || r0dump_readGeneration(properties) != expectedGeneration) {
+      throw r0dump_state("property_verification_failed");
+    }
+  }
+
   private static long r0dump_readGeneration(r0dump_PropertyAccess properties) {
     final String value = properties.r0dump_get(PROPERTY_GENERATION, "0");
     try {
@@ -824,6 +964,10 @@ public final class r0dump_FusionConfig {
         .equals(outputParent);
   }
 
+  static boolean r0dump_isSystemUserUid(int uid) {
+    return UserHandle.getUserId(uid) == UserHandle.USER_SYSTEM;
+  }
+
   private String r0dump_propertyValue(String field) {
     switch (field) {
       case "schema":
@@ -905,6 +1049,10 @@ public final class r0dump_FusionConfig {
     return new IllegalArgumentException(field);
   }
 
+  private static IllegalStateException r0dump_state(String reason) {
+    return new IllegalStateException(reason);
+  }
+
   interface r0dump_Publisher {
     boolean r0dump_publish(r0dump_FusionConfig config, String processName, String outputParent);
   }
