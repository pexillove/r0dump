+  @Test
+  public void r0dump_managerWrite_validatesPublishesAndVerifiesCompleteSnapshot() throws Exception {
+    final r0dump_FakeProperties properties = new r0dump_FakeProperties();
+    final String rawConfig = r0dump_validJson().toString();
+
+    assertThat(r0dump_FusionConfig.r0dump_writePersistedForManager(rawConfig, 0L, properties))
+        .isEqualTo(2L);
+    assertThat(properties.values.get(r0dump_FusionConfig.PROPERTY_PREFIX + "generation"))
+        .isEqualTo("2");
+    assertThat(properties.values.get(r0dump_FusionConfig.PROPERTY_PREFIX + "enabled"))
+        .isEqualTo("1");
+    assertThat(properties.values.get(r0dump_FusionConfig.PROPERTY_PREFIX + "run_id"))
+        .isEqualTo("20260824T120000Z-a1b2c3d4");
+
+    final IllegalStateException conflict =
+        assertThrows(
+            IllegalStateException.class,
+            () -> r0dump_FusionConfig.r0dump_writePersistedForManager(rawConfig, 0L, properties));
+    assertThat(conflict).hasMessageThat().isEqualTo("generation_conflict");
+  }
+
