   }
 
+  /**
+   * Validates and atomically publishes a complete configuration for the system r0dump manager.
+   *
+   * @hide
+   */
+  public static long r0dump_writePersistedForManager(String rawConfig, long expectedGeneration) {
+    return r0dump_writePersistedForManager(rawConfig, expectedGeneration, SYSTEM_PROPERTIES);
+  }
+
+  /**
+   * Atomically disables the persisted configuration for the system r0dump manager.
+   *
+   * @hide
+   */
+  public static long r0dump_disablePersistedForManager(long expectedGeneration) {
+    return r0dump_disablePersistedForManager(expectedGeneration, SYSTEM_PROPERTIES);
+  }
+
+  /**
+   * Recovers an interrupted publication by committing a disabled snapshot.
+   *
+   * @hide
+   */
+  public static long r0dump_recoverDisabledPersistedForManager() {
+    return r0dump_recoverDisabledPersistedForManager(SYSTEM_PROPERTIES);
+  }
+
+  static long r0dump_writePersistedForManager(
+      String rawConfig, long expectedGeneration, r0dump_PropertyAccess properties) {
+    final r0dump_FusionConfig config = r0dump_parse(rawConfig);
+    final long generation = r0dump_requireExpectedStableGeneration(properties, expectedGeneration);
+    r0dump_publishCompleteOrThrow(config, generation, properties);
+    return generation + 2L;
+  }
+
+  static long r0dump_disablePersistedForManager(
+      long expectedGeneration, r0dump_PropertyAccess properties) {
+    final long generation = r0dump_requireExpectedStableGeneration(properties, expectedGeneration);
+    r0dump_publishDisabledOrThrow(generation, properties);
+    return generation + 2L;
+  }
+
+  static long r0dump_recoverDisabledPersistedForManager(r0dump_PropertyAccess properties) {
+    final long generation = r0dump_readGeneration(properties);
+    if ((generation & 1L) == 0L) {
+      throw r0dump_state("generation_not_in_progress");
+    }
+    if (generation == Long.MAX_VALUE) {
+      throw r0dump_state("generation_exhausted");
+    }
+    try {
+      properties.r0dump_set(PROPERTY_PREFIX + "enabled", "0");
+      properties.r0dump_set(PROPERTY_GENERATION, Long.toString(generation + 1L));
+    } catch (RuntimeException e) {
+      throw r0dump_state("property_write_failed");
+    }
+    r0dump_verifyDisabledOrThrow(generation + 1L, properties);
+    return generation + 1L;
+  }
+
