+    assertThat(r0dump_FusionConfig.r0dump_recoverDisabledPersistedForManager(properties))
+        .isEqualTo(6L);
+    assertThat(properties.values.get(r0dump_FusionConfig.PROPERTY_PREFIX + "generation"))
