+    final List<String> namespacePrefixes;
+    final IdentityHashMap<ClassLoader, HashSet<String>> seenNames = new IdentityHashMap<>();
+    final IdentityHashMap<Class<?>, Boolean> seenClasses = new IdentityHashMap<>();
+    int classCount;
+    int executableCount;
+    int attemptCount;
+
+    r0dump_ForceState(
+        r0dump_FusionConfig config, List<String> namespacePrefixes, int priorAttempts) {
+      maxClasses = (int) config.walkMaxClasses;
+      maxExecutables = (int) config.walkMaxMethods;
+      maxAttempts = (int) config.forceMaxCalls;
+      this.namespacePrefixes = namespacePrefixes;
+      attemptCount = priorAttempts;
+    }
+
+    boolean r0dump_hasBudget() {
+      return classCount < maxClasses
+          && executableCount < maxExecutables
+          && attemptCount < maxAttempts;
+    }
+
+    boolean r0dump_markName(ClassLoader loader, String className) {
+      HashSet<String> names = seenNames.get(loader);
+      if (names == null) {
+        names = new HashSet<>();
+        seenNames.put(loader, names);
+      }
+      if (!names.add(className)) {
+        return false;
+      }
+      classCount++;
+      return true;
+    }
+  }
