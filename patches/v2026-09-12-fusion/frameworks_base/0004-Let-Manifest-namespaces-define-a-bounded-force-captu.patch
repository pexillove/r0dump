+  private static void r0dump_forceManifestNamespaces(
+      r0dump_ManifestHelper.r0dump_Snapshot snapshot,
+      r0dump_FusionConfig config,
+      ClassLoader applicationLoader,
+      ArrayList<ClassLoader> loaders,
+      int priorAttempts) {
+    final List<String> prefixes = r0dump_manifestNamespacePrefixes(snapshot);
+    if (!config.forceInvokeEnabled || prefixes.isEmpty() || priorAttempts >= config.forceMaxCalls) {
+      return;
+    }
+    final r0dump_ForceState state = new r0dump_ForceState(config, prefixes, priorAttempts);
+    final String[] seedNames = new String[snapshot.seeds.size()];
+    for (int i = 0; i < snapshot.seeds.size(); i++) {
+      seedNames[i] = snapshot.seeds.get(i).className;
+    }
+    r0dump_forceNames(applicationLoader, seedNames, state);
+    for (ClassLoader loader : loaders) {
+      if (!state.r0dump_hasBudget()) {
+        return;
+      }
+      try {
+        final Object[] cookies = r0dump_Runtime.r0dump_GetDexCookies(loader);
+        if (cookies != null) {
+          for (Object cookie : cookies) {
+            if (cookie != null && state.r0dump_hasBudget()) {
+              r0dump_forceNames(loader, r0dump_Runtime.r0dump_GetCookieClassNames(cookie), state);
+            }
+          }
+        }
+      } catch (RuntimeException | LinkageError ignored) {
+      }
+      if (!state.r0dump_hasBudget()) {
+        return;
+      }
+      try {
+        r0dump_forceNames(loader, r0dump_Runtime.r0dump_GetLoadedClassNames(loader), state);
+      } catch (RuntimeException | LinkageError ignored) {
+      }
+    }
+  }
+
+  static List<String> r0dump_manifestNamespacePrefixes(
+      r0dump_ManifestHelper.r0dump_Snapshot snapshot) {
+    if (snapshot == null) {
+      return List.of();
+    }
+    final LinkedHashSet<String> candidates = new LinkedHashSet<>();
+    for (r0dump_ManifestHelper.r0dump_ClassSeed seed : snapshot.seeds) {
+      if (seed == null || seed.className == null) {
+        continue;
+      }
+      final int separator = seed.className.lastIndexOf('.');
+      if (separator > 0) {
+        candidates.add(seed.className.substring(0, separator + 1));
+      }
+    }
+    final ArrayList<String> sorted = new ArrayList<>(candidates);
+    sorted.sort(Comparator.comparingInt(String::length).thenComparing(Comparator.naturalOrder()));
+    final ArrayList<String> minimal = new ArrayList<>();
+    for (String candidate : sorted) {
+      if (!r0dump_matchesNamespace(candidate, minimal)) {
+        minimal.add(candidate);
+      }
+    }
+    return List.copyOf(minimal);
+  }
+
+  static boolean r0dump_matchesNamespace(String className, List<String> prefixes) {
+    if (className == null || prefixes == null) {
+      return false;
+    }
+    for (String prefix : prefixes) {
+      if (prefix != null && !prefix.isEmpty() && className.startsWith(prefix)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private static void r0dump_forceNames(
+      ClassLoader loader, String[] classNames, r0dump_ForceState state) {
+    if (loader == null || classNames == null) {
+      return;
+    }
+    for (String className : classNames) {
+      if (!state.r0dump_hasBudget()) {
+        return;
+      }
+      if (className == null
+          || className.isEmpty()
+          || !r0dump_matchesNamespace(className, state.namespacePrefixes)
+          || !state.r0dump_markName(loader, className)) {
+        continue;
+      }
+      try {
+        final Class<?> klass = Class.forName(className, false, loader);
+        if (state.seenClasses.put(klass, Boolean.TRUE) == null) {
+          r0dump_forceExecutables(klass, className, state);
+        }
+      } catch (ClassNotFoundException | SecurityException | LinkageError ignored) {
+      }
+    }
+  }
+
+  private static void r0dump_forceExecutables(
+      Class<?> klass, String className, r0dump_ForceState state) {
+    final ArrayList<Executable> executables = new ArrayList<>();
+    try {
+      executables.addAll(Arrays.asList(klass.getDeclaredConstructors()));
+      executables.addAll(Arrays.asList(klass.getDeclaredMethods()));
+    } catch (SecurityException | LinkageError e) {
+      return;
+    }
+    executables.sort(Comparator.comparing(r0dump_ClassLoaderWalk::r0dump_executableSortKey));
+    for (Executable executable : executables) {
+      if (!state.r0dump_hasBudget()) {
+        return;
+      }
+      state.executableCount++;
+      final int modifiers = executable.getModifiers();
+      if (Modifier.isAbstract(modifiers) || Modifier.isNative(modifiers)) {
+        continue;
+      }
+      state.attemptCount++;
+      try {
+        r0dump_Runtime.r0dump_ForceInvoke(executable, null, className);
+      } catch (RuntimeException | LinkageError ignored) {
+      }
+    }
+  }
+
+  private static String r0dump_executableSortKey(Executable executable) {
+    final String name = executable instanceof Constructor ? "<init>" : executable.getName();
+    return name + r0dump_descriptor(executable);
   }
 
   private static Executable r0dump_findForceExecutable(Class<?> klass, r0dump_FusionConfig config) {
