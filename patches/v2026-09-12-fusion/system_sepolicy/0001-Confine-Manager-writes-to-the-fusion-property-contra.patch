From 537612235a1427c35be29bd3cc8e2b3ccf84bc95 Mon Sep 17 00:00:00 2001
From: Ivory <contact@ivory.cafe>
Date: Sun, 30 Aug 2026 23:22:39 +0800
Subject: [PATCH 1/4] Confine Manager writes to the fusion property contract

Constraint: Only the platform-signed privileged Manager may mutate persist.sys.r0dump.fusion.*.
Rejected: Reusing system_app or broad system_prop write access | would expand the trusted writer set.
Confidence: high
Scope-risk: narrow
Directive: Preserve the dedicated r0dump_manager_app domain and typed property prefix.
Tested: SELinux production targets, sepolicy_tests, source contracts, and enforcing-device deployment.
Change-Id: Ie27855faa354dfc6a5ba4902b7b43bb23ee9ecd1
---
 private/property_contexts     |  1 +
 private/r0dump_manager_app.te | 14 ++++++++++++++
 private/seapp_contexts        |  1 +
 public/property.te            |  1 +
 4 files changed, 17 insertions(+)
 create mode 100644 private/r0dump_manager_app.te

diff --git a/private/property_contexts b/private/property_contexts
index b325c2f..a36a591 100644
--- a/private/property_contexts
+++ b/private/property_contexts
@@ -77,6 +77,7 @@ persist.pm.mock-upgrade u:object_r:mock_ota_prop:s0
 persist.profcollectd.enabled    u:object_r:profcollectd_enabled_prop:s0     exact   bool
 persist.profcollectd.node_id    u:object_r:profcollectd_node_id_prop:s0     exact   string
 persist.sys.            u:object_r:system_prop:s0
+persist.sys.r0dump.fusion. u:object_r:r0dump_fusion_prop:s0 prefix string
 persist.sys.safemode    u:object_r:safemode_prop:s0
 persist.sys.tap_gesture u:object_r:gesture_prop:s0
 persist.sys.theme       u:object_r:theme_prop:s0
diff --git a/private/r0dump_manager_app.te b/private/r0dump_manager_app.te
new file mode 100644
index 0000000..836acb4
--- /dev/null
+++ b/private/r0dump_manager_app.te
@@ -0,0 +1,14 @@
+type r0dump_manager_app, domain;
+typeattribute r0dump_manager_app coredomain;
+
+app_domain(r0dump_manager_app)
+
+# Match the service discovery surface available to platform-signed privileged
+# apps.  The dedicated domain remains isolated from writer/session services.
+allow r0dump_manager_app app_api_service:service_manager find;
+allow r0dump_manager_app system_api_service:service_manager find;
+
+# Manager is the sole writer; configured targets and system_server only read.
+set_prop(r0dump_manager_app, r0dump_fusion_prop)
+get_prop(appdomain, r0dump_fusion_prop)
+get_prop(system_server, r0dump_fusion_prop)
diff --git a/private/seapp_contexts b/private/seapp_contexts
index a6e829d..33a99ab 100644
--- a/private/seapp_contexts
+++ b/private/seapp_contexts
@@ -167,6 +167,7 @@ isSystemServer=true domain=system_server_startup
 neverallow user=_sdksandbox domain=((?!sdk_sandbox).)*
 
 user=_app seinfo=platform name=com.android.traceur domain=traceur_app type=app_data_file levelFrom=all
+user=_app seinfo=platform isPrivApp=true name=com.android.r0dumpmanager domain=r0dump_manager_app type=privapp_data_file levelFrom=all
 user=system seinfo=platform domain=system_app type=system_app_data_file
 user=system seinfo=platform isPrivApp=true name=com.android.DeviceAsWebcam domain=device_as_webcam type=system_app_data_file levelFrom=all
 user=bluetooth seinfo=bluetooth domain=bluetooth type=bluetooth_data_file
diff --git a/public/property.te b/public/property.te
index 0bf2bd7..30b616d 100644
--- a/public/property.te
+++ b/public/property.te
@@ -90,6 +90,7 @@ system_restricted_prop(power_debug_prop)
 system_restricted_prop(profcollectd_etr_prop)
 system_restricted_prop(property_service_version_prop)
 system_restricted_prop(provisioned_prop)
+system_restricted_prop(r0dump_fusion_prop)
 system_restricted_prop(restorecon_prop)
 system_restricted_prop(retaildemo_prop)
 system_restricted_prop(servicemanager_prop)
-- 
