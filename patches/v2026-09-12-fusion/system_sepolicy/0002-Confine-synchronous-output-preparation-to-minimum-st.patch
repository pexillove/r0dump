diff --git a/private/r0dump_file_helper.te b/private/r0dump_file_helper.te
new file mode 100644
index 0000000..a5126ec
--- /dev/null
+++ b/private/r0dump_file_helper.te
@@ -0,0 +1,42 @@
+type r0dump_file_helper, domain, coredomain;
+init_daemon_domain(r0dump_file_helper)
+
+get_prop(r0dump_file_helper, r0dump_fusion_prop)
+
+allow r0dump_file_helper self:capability { chown fowner fsetid setuid };
+allow r0dump_file_helper self:unix_stream_socket { accept listen read write getattr getopt setopt };
+
+# Traverse the per-user mount namespace before opening the FUSE-backed root.
+allow r0dump_file_helper mnt_user_file:dir search;
+
+# The emulated-storage FUSE daemon performs checks against the backing
+# media_rw data label while the helper walks and prepares app external files.
+allow r0dump_file_helper media_rw_data_file:dir create_dir_perms;
+
+# The helper performs only fd-relative directory preparation below app external files.
+allow r0dump_file_helper fuse:dir {
+  add_name
+  create
+  getattr
+  open
+  read
+  remove_name
+  rmdir
+  search
+  setattr
+  write
+};
+
+allow system_server r0dump_file_helper_socket:sock_file write;
+allow system_server r0dump_file_helper:unix_stream_socket connectto;
+allow system_server r0dump_file_helper:fd use;
+# SELinux maps receipt of an O_PATH FD to the ioctl permission when no
+# FMODE_READ/FMODE_WRITE bit exists. This permits only FD receipt; the platform
+# neverallow still prevents system_server from opening, reading, or writing
+# external-storage directories.
+allow system_server fuse:dir ioctl;
+
+# The helper owns the directory file description even after system_server
+# duplicates it into a ParcelFileDescriptor. Only AMS can obtain and forward
+# this descriptor; its Binder entry validates the calling app UID/PID first.
+allow appdomain r0dump_file_helper:fd use;
