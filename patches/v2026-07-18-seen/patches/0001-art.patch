+static jobjectArray DexFile_getRegisteredClassLoaders(JNIEnv* env, jclass) {
+  ScopedObjectAccess soa(env);
+  Thread* const self = soa.Self();
+  ClassLinker* const class_linker = Runtime::Current()->GetClassLinker();
+  VariableSizedHandleScope class_loaders(self);
+  class_linker->GetClassLoaders(self, &class_loaders);
+
+  StackHandleScope<1u> hs(self);
+  Handle<mirror::ObjectArray<mirror::ClassLoader>> result = hs.NewHandle(
+      mirror::ObjectArray<mirror::ClassLoader>::Alloc(
+          self,
+          GetClassRoot<mirror::ObjectArray<mirror::ClassLoader>>(class_linker),
+          class_loaders.Size()));
+  if (result == nullptr) {
+    DCHECK(self->IsExceptionPending());
+    return nullptr;
+  }
+
+  for (uint32_t i = 0; i < class_loaders.Size(); ++i) {
+    result->Set(i, class_loaders.GetHandle<mirror::ClassLoader>(i).Get());
+  }
+  return soa.AddLocalReference<jobjectArray>(result.Get());
+}
