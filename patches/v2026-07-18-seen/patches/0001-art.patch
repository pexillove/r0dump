+  ScopedObjectAccess soa(env);
+  StackHandleScope<1u> hs(soa.Self());
+  Handle<mirror::ClassLoader> loader = hs.NewHandle(soa.Decode<mirror::ClassLoader>(classLoader));
+  if (loader == nullptr) {
+    return nullptr;
+  }
+
+  std::set<std::string> class_names;
+  R0DumpLoadedClassNameVisitor visitor(loader, &class_names);
+  Runtime::Current()->GetClassLinker()->VisitClasses(&visitor);
+  return soa.AddLocalReference<jobjectArray>(
+      CreateStringArray(soa.Self(), class_names));
+}
