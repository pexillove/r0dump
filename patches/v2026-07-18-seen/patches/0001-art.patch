+static std::string R0DumpDexHeaderJsonExtra(const DexFile* dex_file) {
+  if (dex_file == nullptr || dex_file->Begin() == nullptr) {
+    return ",\"dex_header_valid\":false";
+  }
+  const std::string payload_key = android::base::StringPrintf(
+      "dex_header_payload_%s_%zu_%zu",
+      R0DumpDexLocationHash(dex_file).c_str(),
+      R0DumpDexEffectiveSize(dex_file),
+      dex_file->DataSize());
+  const bool include_payload = R0DumpReserveDexFileName(payload_key);
+
+  static constexpr size_t kR0DumpMaxDexHeaderPrefixSnapshot = 8u * 1024u * 1024u;
+  std::vector<uint8_t> snapshot(kR0DumpMaxDexHeaderPrefixSnapshot);
+  size_t snapshot_size = 0u;
+  R0DumpGetDexHeaderSnapshotFn get_snapshot = R0DumpResolveDexHeaderSnapshotFn();
+  if (get_snapshot != nullptr &&
+      get_snapshot(dex_file->Begin(),
+                   dex_file->DataBegin(),
+                   dex_file->DataSize(),
+                   snapshot.data(),
+                   snapshot.size(),
+                   &snapshot_size) &&
+      snapshot_size >= sizeof(DexFile::Header)) {
+    return R0DumpDexHeaderJsonFromBytes(snapshot.data(), snapshot_size, include_payload);
+  }
+
+  if (dex_file->Size() < sizeof(DexFile::Header) ||
+      !R0DumpIsReadableMemoryRange(dex_file->Begin(), sizeof(DexFile::Header))) {
+    return ",\"dex_header_valid\":false";
+  }
+  return R0DumpDexHeaderJsonFromBytes(dex_file->Begin(), dex_file->Size(), include_payload);
+}
