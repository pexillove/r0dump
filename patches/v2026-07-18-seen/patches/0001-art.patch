+    }
+  } else {
+    R0DumpLog(ANDROID_LOG_DEBUG,
+              "raw dexdata skipped reason=no_data_range strategy=%s artDex=%p fallbackDex=%p "
+              "item=%p method=%s",
+              R0DumpStrategyName(strategy),
+              art_dex_file,
+              fallback_dex_file,
+              item,
+              artmethod != nullptr ? artmethod->PrettyMethod(false).c_str() : "null");
+  }
+  const uint32_t method_idx = artmethod->GetDexMethodIndex();
+  const std::string method_name = artmethod->PrettyMethod(/*with_signature=*/false);
+  const std::string location_hash = R0DumpDexLocationHash(raw_dex_file);
+  const uintptr_t item_addr = reinterpret_cast<uintptr_t>(item);
+  const std::string method_key = android::base::StringPrintf("raw:%s:%zu:%u:%zu:%p:%zu:%s",
+                                                             location_hash.c_str(),
+                                                             data_size,
+                                                             method_idx,
+                                                             code_item_offset,
+                                                             item,
+                                                             code_item_len,
+                                                             R0DumpStrategyName(strategy));
+  bool duplicate_method = false;
+  {
+    std::lock_guard<std::mutex> lock(gR0DumpStateMutex);
+    if (!gR0DumpDumpedMethodKeys.insert(method_key).second) {
+      gR0DumpDuplicateMethodsSkipped++;
+      duplicate_method = true;
+    }
+  }
+  if (duplicate_method) {
+    R0DumpNoteMethodSkip("duplicate_raw_method", artmethod, strategy);
