+  const std::string force_backfill_extra = (strategy == kR0DumpStrategyForceBackfillBefore ||
+                                            strategy == kR0DumpStrategyForceBackfillAfter)
+                                               ? android::base::StringPrintf(
+                                                     ",\"force_backfill_before_hash\":\"%s\","
+                                                     "\"force_backfill_after_hash\":\"%s\","
+                                                     "\"force_backfill_changed\":%s",
+                                                     gR0DumpForceBackfillBeforeHash.c_str(),
+                                                     gR0DumpForceBackfillAfterHash.c_str(),
+                                                     gR0DumpForceBackfillChanged ? "true" : "false")
+                                               : "";
+  const std::string record = android::base::StringPrintf(
+      "{\"version\":2,\"raw_code_item\":true,\"strategy\":\"%s\","
+      "\"pid\":%d,\"tid\":%ld,\"process\":\"%s\","
+      "\"dex_size\":%zu,\"dex_checksum\":\"0x00000000\","
+      "\"dex_location_hash\":\"%s\",\"method_idx\":%u,"
+      "\"code_item_offset\":%zu,\"code_item_len\":%zu,"
+      "\"code_item_addr\":\"0x%zx\",\"code_item_end\":\"%p\","
+      "\"data_begin\":\"%p\",\"data_size\":%zu,"
+      "\"code_item_map\":\"%s\",\"art_begin\":\"%p\",\"art_size\":%zu,"
+      "\"art_data_begin\":\"%p\",\"art_data_size\":%zu,"
+      "\"art_map\":\"%s\",\"fallback_begin\":\"%p\",\"fallback_size\":%zu,"
+      "\"fallback_data_begin\":\"%p\",\"fallback_data_size\":%zu,"
+      "\"fallback_map\":\"%s\",\"method_name\":\"%s\","
+      "\"code_item_b64\":\"%s\"%s%s}\n",
+      R0DumpStrategyName(strategy),
+      getpid(),
+      static_cast<long>(syscall(__NR_gettid)),
+      R0DumpJsonEscape(R0DumpReadCmdline()).c_str(),
+      data_size,
+      location_hash.c_str(),
+      method_idx,
+      code_item_offset,
+      code_item_len,
+      item_addr,
+      end,
+      data_begin,
+      data_size,
+      R0DumpJsonEscape(item_map).c_str(),
+      art_dex_file != nullptr ? art_dex_file->Begin() : nullptr,
+      art_dex_file != nullptr ? art_dex_file->Size() : 0u,
+      art_dex_file != nullptr ? art_dex_file->DataBegin() : nullptr,
+      art_dex_file != nullptr ? art_dex_file->DataSize() : 0u,
+      R0DumpJsonEscape(art_map).c_str(),
+      fallback_dex_file != nullptr ? fallback_dex_file->Begin() : nullptr,
+      fallback_dex_file != nullptr ? fallback_dex_file->Size() : 0u,
+      fallback_dex_file != nullptr ? fallback_dex_file->DataBegin() : nullptr,
