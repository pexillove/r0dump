+static bool R0DumpCookieToDexFiles(
+    JNIEnv* env, jobject cookie, std::vector<const DexFile*>* dex_files) {
+  if (cookie == nullptr || dex_files == nullptr) {
+    return false;
+  }
+  const OatFile* oat_file = nullptr;
+  if (!ConvertJavaArrayToDexFiles(env, cookie, *dex_files, oat_file)) {
+    if (env->ExceptionCheck() == JNI_TRUE) {
+      env->ExceptionClear();
+    }
+    return false;
+  }
+  return !dex_files->empty();
+}
