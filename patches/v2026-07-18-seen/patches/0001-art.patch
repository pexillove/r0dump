+static bool R0DumpEnqueueAsyncDexDump(R0DumpAsyncDexDumpTask task) {
+  static constexpr size_t kR0DumpMaxAsyncDexQueue = 512u;
+  if (task.dex_file == nullptr || task.dex_size == 0u ||
+      (!task.write_raw_dex && !task.write_dexdata && !task.write_dexfixed)) {
+    return false;
+  }
+  {
+    std::lock_guard<std::mutex> lock(gR0DumpAsyncMutex);
+    if (!gR0DumpAsyncWorkerStarted) {
+      gR0DumpAsyncWorkerStarted = true;
+      std::thread(R0DumpAsyncDexDumpWorker).detach();
+    }
+    if (gR0DumpAsyncDexQueue.size() >= kR0DumpMaxAsyncDexQueue) {
+      gR0DumpAsyncDexTasksDropped.fetch_add(1u, std::memory_order_relaxed);
+      R0DumpLog(ANDROID_LOG_WARN,
+                "async dex dump queue full drop strategy=%s begin=%p size=%zu pending=%zu",
+                R0DumpStrategyName(task.strategy),
+                task.dex_file->Begin(),
+                task.dex_size,
+                gR0DumpAsyncDexQueue.size());
+      return false;
+    }
+    gR0DumpAsyncDexQueue.push_back(std::move(task));
+    gR0DumpAsyncDexTasksQueued.fetch_add(1u, std::memory_order_relaxed);
+  }
+  gR0DumpAsyncCv.notify_one();
+  return true;
+}
