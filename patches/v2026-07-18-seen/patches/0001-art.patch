+static std::string R0DumpDexHeaderJsonFromBytes(const uint8_t* header_bytes,
+                                                size_t header_capacity,
+                                                bool include_payload) {
+  if (header_bytes == nullptr || header_capacity < sizeof(DexFile::Header) ||
+      !StandardDexFile::IsMagicValid(header_bytes)) {
+    return ",\"dex_header_valid\":false";
+  }
+
+  DexFile::Header header = {};
+  memcpy(&header, header_bytes, sizeof(header));
+  const size_t header_size =
+      header.header_size_ >= sizeof(DexFile::Header) && header.header_size_ <= header_capacity
+          ? header.header_size_
+          : sizeof(DexFile::Header);
+  size_t prefix_size = header_size;
+  if (header.data_off_ >= header_size && header.data_off_ <= header_capacity) {
+    prefix_size = header.data_off_;
+  }
+  std::string payload;
+  if (include_payload) {
+    payload = R0DumpBase64Encode(header_bytes, prefix_size);
+  }
+  const std::string payload_json = include_payload
+      ? android::base::StringPrintf(",\"dex_header_b64\":\"%s\"", payload.c_str())
+      : "";
+  return android::base::StringPrintf(
+      ",\"dex_header_valid\":true,"
+      "\"dex_header_size\":%zu,"
+      "\"dex_header_prefix_size\":%zu,"
+      "\"dex_header_file_size\":%u,"
+      "\"dex_header_map_off\":%u,"
+      "\"dex_header_string_ids_size\":%u,"
+      "\"dex_header_string_ids_off\":%u,"
+      "\"dex_header_type_ids_size\":%u,"
+      "\"dex_header_type_ids_off\":%u,"
+      "\"dex_header_proto_ids_size\":%u,"
+      "\"dex_header_proto_ids_off\":%u,"
+      "\"dex_header_field_ids_size\":%u,"
+      "\"dex_header_field_ids_off\":%u,"
+      "\"dex_header_method_ids_size\":%u,"
+      "\"dex_header_method_ids_off\":%u,"
+      "\"dex_header_class_defs_size\":%u,"
+      "\"dex_header_class_defs_off\":%u,"
+      "\"dex_header_data_size\":%u,"
+      "\"dex_header_data_off\":%u%s",
+      header_size,
+      prefix_size,
+      header.file_size_,
+      header.map_off_,
+      header.string_ids_size_,
+      header.string_ids_off_,
+      header.type_ids_size_,
+      header.type_ids_off_,
+      header.proto_ids_size_,
+      header.proto_ids_off_,
+      header.field_ids_size_,
+      header.field_ids_off_,
+      header.method_ids_size_,
+      header.method_ids_off_,
+      header.class_defs_size_,
+      header.class_defs_off_,
+      header.data_size_,
+      header.data_off_,
+      payload_json.c_str());
 }
 
