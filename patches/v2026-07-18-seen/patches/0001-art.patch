+          task.checksum,
+          task.process_component.c_str(),
+          task.dex_file_name.c_str());
+    } else if (!out_dir.empty()) {
+      const std::string dex_path = out_dir + "/" + task.dex_file_name;
+      int write_errno = 0;
+      if (R0DumpWriteFileIfAbsent(dex_path, dex_file->Begin(), task.dex_size, &write_errno)) {
+        raw_written = true;
+        {
+          std::lock_guard<std::mutex> lock(gR0DumpStateMutex);
+          gR0DumpDexFilesWritten++;
+          R0DumpRememberDex(dex_file);
+        }
+        R0DumpLog(ANDROID_LOG_INFO,
+                  "async dex dumped strategy=%s size=%zu checksum=0x%08x path=%s",
+                  R0DumpStrategyName(task.strategy),
+                  task.dex_size,
+                  task.checksum,
+                  dex_path.c_str());
+      } else {
+        R0DumpLog(ANDROID_LOG_WARN,
+                  "async dex write failed strategy=%s size=%zu errno=%d(%s) file=%s",
+                  R0DumpStrategyName(task.strategy),
+                  task.dex_size,
+                  write_errno,
+                  strerror(write_errno),
+                  task.dex_file_name.c_str());
+      }
+    }
+  }
+
+  if (task.write_dexdata && !out_dir.empty()) {
+    uint64_t dexdata_request = 0;
+    {
+      std::lock_guard<std::mutex> lock(gR0DumpStateMutex);
+      dexdata_request = ++gR0DumpDexDataDumpRequests;
+    }
+    const bool dexdata_ok =
+        R0DumpDumpDexDataMirrorNow(out_dir, dex_file, task.strategy, task.dexdata_name_reserved);
+    if (!dexdata_ok || dexdata_request <= 5u || (dexdata_request % 1000u) == 0u) {
+      R0DumpLog(ANDROID_LOG_INFO,
+                "async raw dexdata mirror result ok=%d request=%llu strategy=%s begin=%p size=%zu "
+                "dataBegin=%p dataSize=%zu",
+                dexdata_ok ? 1 : 0,
+                static_cast<unsigned long long>(dexdata_request),
+                R0DumpStrategyName(task.strategy),
+                dex_file->Begin(),
+                R0DumpDexEffectiveSize(dex_file),
+                dex_file->DataBegin(),
+                dex_file->DataSize());
+    }
+  }
+
+  if (task.write_dexfixed && !out_dir.empty()) {
+    R0DumpWriteDexFixedImage(out_dir, dex_file, task.dex_size, task.strategy);
+  }
+
+  if (!out_dir.empty() && (raw_written || task.write_dexdata || task.write_dexfixed)) {
+    R0DumpWriteStatus(out_dir, "dumping");
+  }
+}
+
+[[noreturn]] static void R0DumpAsyncDexDumpWorker() {
+  for (;;) {
+    R0DumpAsyncDexDumpTask task;
+    {
+      std::unique_lock<std::mutex> lock(gR0DumpAsyncMutex);
+      gR0DumpAsyncCv.wait(lock, []() { return !gR0DumpAsyncDexQueue.empty(); });
+      task = std::move(gR0DumpAsyncDexQueue.front());
+      gR0DumpAsyncDexQueue.pop_front();
+    }
+    gR0DumpAsyncDexTasksStarted.fetch_add(1u, std::memory_order_relaxed);
+    R0DumpExecuteAsyncDexDumpTask(task);
+    gR0DumpAsyncDexTasksCompleted.fetch_add(1u, std::memory_order_relaxed);
+  }
+}
+
+static void R0DumpMaybeMirrorRawDexData(const DexFile* dex_file, uint32_t strategy) {
+  if (!gR0DumpRawDexDataMirrorEnabled || dex_file == nullptr) {
+    return;
+  }
+  const std::string out_dir = R0DumpOutputDir();
+  if (out_dir.empty()) {
+    R0DumpLog(ANDROID_LOG_DEBUG,
+              "raw dexdata mirror skipped reason=empty_output strategy=%s",
+              R0DumpStrategyName(strategy));
+    return;
+  }
+  uint64_t dexdata_request = 0;
+  {
+    std::lock_guard<std::mutex> lock(gR0DumpStateMutex);
+    dexdata_request = ++gR0DumpDexDataDumpRequests;
+  }
+  const bool dexdata_ok =
+      R0DumpDumpDexDataMirrorNow(out_dir, dex_file, strategy, /*file_name_reserved=*/false);
+  if (!dexdata_ok || dexdata_request <= 5u || (dexdata_request % 1000u) == 0u) {
+    R0DumpLog(ANDROID_LOG_INFO,
+              "raw dexdata mirror result ok=%d request=%llu strategy=%s begin=%p size=%zu "
+              "dataBegin=%p dataSize=%zu",
+              dexdata_ok ? 1 : 0,
+              static_cast<unsigned long long>(dexdata_request),
+              R0DumpStrategyName(strategy),
+              dex_file->Begin(),
+              R0DumpDexEffectiveSize(dex_file),
+              dex_file->DataBegin(),
+              dex_file->DataSize());
+  }
+}
+
+static void R0DumpRememberDex(const DexFile* dex_file) {
+  if (dex_file == nullptr) {
+    return;
+  }
+  const std::string dex_key = R0DumpDexKey(dex_file);
+  R0DumpDexStats& stats = gR0DumpByDex[dex_key];
+  stats.dex_size = R0DumpDexEffectiveSize(dex_file);
+  stats.checksum = R0DumpDexChecksum(dex_file);
+  stats.location_hash = R0DumpDexLocationHash(dex_file);
+}
+
+static void R0DumpDumpDexFile(const DexFile* dex_file, uint32_t strategy) {
+  const bool force_backfill_dump = R0DumpIsForceBackfillDumpStrategy(strategy);
+  if ((!gR0DumpRuntimeEnabled && !force_backfill_dump) ||
+      (!force_backfill_dump && R0DumpShouldStopForLimit())) {
+    return;
+  }
+  const size_t dex_size = R0DumpDexEffectiveSize(dex_file);
+  if (dex_file == nullptr || dex_file->Begin() == nullptr || dex_size == 0u) {
+    return;
+  }
+  if (!R0DumpIsReadableMemoryRange(dex_file->Begin(), dex_size)) {
+    const std::string location_hash = R0DumpDexLocationHash(dex_file);
+    const std::string dex_file_name = android::base::StringPrintf("dex_%s_%zu_0x%08x_%s%s.dex",
+                                                                  location_hash.c_str(),
+                                                                  dex_size,
+                                                                  R0DumpDexChecksum(dex_file),
+                                                                  R0DumpStrategyName(strategy),
+                                                                  gR0DumpRunFileSuffix.c_str());
+    // Keep the name reserved so a single unreadable/inconsistent in-memory dex
+    // does not get retried and logged for every method in that dex.
+    const bool first_unreadable_report = R0DumpReserveDexFileName(dex_file_name);
+    if (first_unreadable_report) {
+      R0DumpLog(ANDROID_LOG_WARN,
+                "dex write skipped unreadable range strategy=%s begin=%p size=%zu file=%s",
+                R0DumpStrategyName(strategy),
+                dex_file->Begin(),
+                dex_size,
+                dex_file_name.c_str());
+    } else {
+      R0DumpLog(ANDROID_LOG_DEBUG,
+                "dex unreadable duplicate skipped strategy=%s begin=%p size=%zu file=%s",
+                R0DumpStrategyName(strategy),
+                dex_file->Begin(),
+                dex_size,
+                dex_file_name.c_str());
+      return;
+    }
+    if (gR0DumpAsyncExportEnabled) {
+      R0DumpAsyncDexDumpTask task;
+      task.dex_file = dex_file;
+      task.dex_size = dex_size;
+      task.strategy = strategy;
+      task.out_dir = R0DumpOutputDir();
+      task.dex_file_name = dex_file_name;
+      task.checksum = R0DumpDexChecksum(dex_file);
+      task.write_raw_dex = false;
+      task.write_dexdata = gR0DumpRawDexDataMirrorEnabled;
+      task.write_dexfixed = true;
+      if (!R0DumpEnqueueAsyncDexDump(std::move(task))) {
+        R0DumpLog(ANDROID_LOG_WARN,
+                  "async unreadable dex dump enqueue failed strategy=%s begin=%p size=%zu",
+                  R0DumpStrategyName(strategy),
+                  dex_file->Begin(),
+                  dex_size);
+      }
+      R0DumpWriteStatus(R0DumpOutputDir(), "dumping");
+      return;
+    }
+    R0DumpMaybeMirrorRawDexData(dex_file, strategy);
+    R0DumpWriteDexFixedImage(R0DumpOutputDir(), dex_file, dex_size, strategy);
+    return;
+  }
+  const std::string process_component = R0DumpSanitizePathComponent(R0DumpReadCmdline());
+  const uint32_t checksum = R0DumpDexChecksum(dex_file);
+  const std::string location_hash = R0DumpDexLocationHash(dex_file);
+  const std::string dex_file_name = android::base::StringPrintf("dex_%s_%zu_0x%08x_%s%s.dex",
+                                                                location_hash.c_str(),
+                                                                dex_size,
+                                                                checksum,
+                                                                R0DumpStrategyName(strategy),
+                                                                gR0DumpRunFileSuffix.c_str());
+  if (!R0DumpReserveDexFileName(dex_file_name)) {
+    R0DumpLog(ANDROID_LOG_DEBUG,
+              "dex duplicate skipped strategy=%s file=%s",
+              R0DumpStrategyName(strategy),
+              dex_file_name.c_str());
+    return;
+  }
+  if (gR0DumpAsyncExportEnabled) {
+    std::string out_dir =
+        R0DumpShouldUseMediaStoreDownloads() ? R0DumpExternalAppOutputDir() : R0DumpOutputDir();
+    if (out_dir.empty()) {
+      out_dir = R0DumpOutputDir();
+    }
+    R0DumpAsyncDexDumpTask task;
+    task.dex_file = dex_file;
+    task.dex_size = dex_size;
+    task.strategy = strategy;
+    task.out_dir = out_dir;
+    task.process_component = process_component;
+    task.dex_file_name = dex_file_name;
+    task.checksum = checksum;
+    task.use_media_store = R0DumpShouldUseMediaStoreDownloads();
+    task.write_raw_dex = true;
+    task.write_dexdata = gR0DumpRawDexDataMirrorEnabled;
+    task.write_dexfixed = true;
+    if (!R0DumpEnqueueAsyncDexDump(std::move(task))) {
+      R0DumpLog(ANDROID_LOG_WARN,
+                "async dex dump enqueue failed strategy=%s file=%s",
+                R0DumpStrategyName(strategy),
+                dex_file_name.c_str());
+    }
+    R0DumpWriteStatus(out_dir, "dumping");
+    return;
+  }
+  if (R0DumpShouldUseMediaStoreDownloads() &&
+      R0DumpWriteDexViaMediaStore(process_component, dex_file_name, dex_file->Begin(), dex_size)) {
+    {
+      std::lock_guard<std::mutex> lock(gR0DumpStateMutex);
+      gR0DumpDexFilesWritten++;
+      R0DumpRememberDex(dex_file);
+    }
+    R0DumpMaybeMirrorRawDexData(dex_file, strategy);
+    R0DumpWriteDexFixedImage(R0DumpOutputDir(), dex_file, dex_size, strategy);
+    R0DumpLog(
+        ANDROID_LOG_INFO,
+        "dex dumped via MediaStore strategy=%s size=%zu checksum=0x%08x path=Download/R0DUMP/%s/%s",
+        R0DumpStrategyName(strategy),
+        dex_size,
+        checksum,
+        process_component.c_str(),
+        dex_file_name.c_str());
+    R0DumpWriteStatus(R0DumpOutputDir(), "dumping");
+    return;
+  }
+  if (R0DumpShouldUseMediaStoreDownloads()) {
+    R0DumpLog(ANDROID_LOG_WARN,
+              "MediaStore dex write failed, falling back to external app path file=%s",
+              dex_file_name.c_str());
+  }
+  std::string out_dir =
+      R0DumpShouldUseMediaStoreDownloads() ? R0DumpExternalAppOutputDir() : R0DumpOutputDir();
+  if (out_dir.empty()) {
+    out_dir = R0DumpOutputDir();
+  }
+  if (out_dir.empty()) {
+    R0DumpForgetDexFileName(dex_file_name);
+    return;
+  }
+  const std::string dex_path = out_dir + "/" + dex_file_name;
+  int write_errno = 0;
+  if (R0DumpWriteFileIfAbsent(dex_path, dex_file->Begin(), dex_size, &write_errno)) {
+    {
+      std::lock_guard<std::mutex> lock(gR0DumpStateMutex);
+      gR0DumpDexFilesWritten++;
+      R0DumpRememberDex(dex_file);
+    }
+    R0DumpMaybeMirrorRawDexData(dex_file, strategy);
+    R0DumpWriteDexFixedImage(out_dir, dex_file, dex_size, strategy);
+    R0DumpLog(ANDROID_LOG_INFO,
+              "dex dumped strategy=%s size=%zu checksum=0x%08x path=%s",
+              R0DumpStrategyName(strategy),
+              dex_size,
+              checksum,
+              dex_path.c_str());
+  } else if (write_errno == EEXIST) {
+    R0DumpLog(ANDROID_LOG_DEBUG,
+              "dex already exists skip write strategy=%s path=%s",
+              R0DumpStrategyName(strategy),
+              dex_path.c_str());
+  } else {
+    R0DumpForgetDexFileName(dex_file_name);
+  }
+  R0DumpWriteStatus(out_dir, "dumping");
+}
