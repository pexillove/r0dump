+    ssize_t rc = TEMP_FAILURE_RETRY(pwrite(fd, cursor, remaining, cursor_offset));
+    if (rc < 0) {
+      return false;
+    }
+    if (rc == 0) {
+      errno = EIO;
+      return false;
+    }
+    cursor += rc;
+    remaining -= static_cast<size_t>(rc);
+    cursor_offset += rc;
+  }
+  return true;
+}
+
+static bool R0DumpDataRangeForCodeItem(const DexFile* dex_file,
+                                       const uint8_t* item,
+                                       const uint8_t** data_begin_out,
+                                       size_t* data_size_out,
+                                       size_t* item_offset_out) {
+  if (data_begin_out != nullptr) {
+    *data_begin_out = nullptr;
+  }
+  if (data_size_out != nullptr) {
+    *data_size_out = 0u;
+  }
+  if (item_offset_out != nullptr) {
+    *item_offset_out = 0u;
+  }
+  if (dex_file == nullptr || dex_file->DataBegin() == nullptr || item == nullptr) {
+    return false;
+  }
+  const uint8_t* data_begin = dex_file->DataBegin();
+  const size_t data_size = dex_file->DataSize();
+  const uintptr_t data_start = reinterpret_cast<uintptr_t>(data_begin);
+  if (data_size == 0u || data_size > std::numeric_limits<uintptr_t>::max() - data_start) {
+    return false;
+  }
+  const uintptr_t data_end = data_start + data_size;
+  const uintptr_t item_addr = reinterpret_cast<uintptr_t>(item);
+  if (item_addr < data_start || item_addr >= data_end) {
+    return false;
+  }
+  if (data_begin_out != nullptr) {
+    *data_begin_out = data_begin;
+  }
+  if (data_size_out != nullptr) {
+    *data_size_out = data_size;
+  }
+  if (item_offset_out != nullptr) {
+    *item_offset_out = static_cast<size_t>(item_addr - data_start);
+  }
+  return true;
+}
