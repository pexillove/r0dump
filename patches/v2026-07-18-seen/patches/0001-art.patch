+            std::lock_guard<std::mutex> lock(gR0DumpStateMutex);
+            gR0DumpDexDataDumpFailures++;
+          }
+        }
+      } else {
+        {
+          std::lock_guard<std::mutex> lock(gR0DumpStateMutex);
+          dexdata_request = ++gR0DumpDexDataDumpRequests;
+        }
+        dexdata_ok = R0DumpDumpDexDataSparse(out_dir, raw_dex_file, strategy);
+        if (!dexdata_ok) {
+          std::lock_guard<std::mutex> lock(gR0DumpStateMutex);
+          gR0DumpDexDataDumpFailures++;
+        }
+        if (!dexdata_ok || dexdata_request <= 5u || (dexdata_request % 1000u) == 0u) {
+          R0DumpLog(ANDROID_LOG_INFO,
+                    "raw dexdata dump result ok=%d request=%llu strategy=%s dataBegin=%p "
+                    "dataSize=%zu codeItemOffset=%zu method=%s",
+                    dexdata_ok ? 1 : 0,
+                    static_cast<unsigned long long>(dexdata_request),
+                    R0DumpStrategyName(strategy),
+                    data_begin,
+                    data_size,
+                    code_item_offset,
+                    artmethod != nullptr ? artmethod->PrettyMethod(false).c_str() : "null");
+        }
+      }
+    }
+    const size_t raw_dex_size = R0DumpDexEffectiveSize(raw_dex_file);
+    const bool raw_full_dex_valid =
+        raw_dex_file->Begin() != nullptr && raw_dex_size >= sizeof(DexFile::Header) &&
+        R0DumpIsReadableMemoryRange(raw_dex_file->Begin(), raw_dex_size) &&
+        StandardDexFile::IsMagicValid(raw_dex_file->Begin());
