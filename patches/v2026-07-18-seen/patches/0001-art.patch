+struct R0DumpReconReadableRange {
+  uintptr_t start = 0u;
+  uintptr_t end = 0u;
+};
+
+static bool R0DumpReconCollectReadableRanges(const R0DumpDexReconState& state,
+                                             std::vector<R0DumpReconReadableRange>* ranges) {
+  if (ranges == nullptr || state.data_begin == nullptr || state.data_size == 0u) {
+    return false;
+  }
+  ranges->clear();
+  const uintptr_t data_start = reinterpret_cast<uintptr_t>(state.data_begin);
+  if (state.data_size > std::numeric_limits<uintptr_t>::max() - data_start) {
+    return false;
+  }
+  const uintptr_t data_end = data_start + state.data_size;
+  FILE* maps = fopen("/proc/self/maps", "re");
+  if (maps == nullptr) {
+    return false;
+  }
+  char line[512];
+  while (fgets(line, sizeof(line), maps) != nullptr) {
+    unsigned long long map_start_raw = 0;
+    unsigned long long map_end_raw = 0;
+    char perms[5] = {};
+    if (sscanf(line, "%llx-%llx %4s", &map_start_raw, &map_end_raw, perms) != 3 ||
+        perms[0] != 'r') {
+      continue;
+    }
+    const uintptr_t map_start = static_cast<uintptr_t>(map_start_raw);
+    const uintptr_t map_end = static_cast<uintptr_t>(map_end_raw);
+    if (map_end <= data_start || map_start >= data_end || map_end <= map_start) {
+      continue;
+    }
+    R0DumpReconReadableRange range;
+    range.start = std::max(map_start, data_start);
+    range.end = std::min(map_end, data_end);
+    ranges->push_back(range);
+  }
+  fclose(maps);
+  return !ranges->empty();
+}
+
+static size_t R0DumpReconReadableBytesFromRanges(
+    const std::vector<R0DumpReconReadableRange>& ranges, const uint8_t* ptr, size_t max_size) {
+  if (ptr == nullptr || max_size == 0u) {
+    return 0u;
+  }
+  const uintptr_t target = reinterpret_cast<uintptr_t>(ptr);
+  for (const R0DumpReconReadableRange& range : ranges) {
+    if (target >= range.start && target < range.end) {
+      return std::min(max_size, static_cast<size_t>(range.end - target));
+    }
+  }
+  return 0u;
+}
+
+static bool R0DumpReadUleb128Fast(const uint8_t** cursor, const uint8_t* end, uint32_t* out) {
+  if (cursor == nullptr || *cursor == nullptr || out == nullptr || *cursor >= end) {
+    return false;
+  }
+  const uint8_t* ptr = *cursor;
+  uint32_t value = 0u;
+  uint32_t shift = 0u;
+  for (uint32_t i = 0u; i < 5u; ++i) {
+    if (ptr >= end) {
+      return false;
+    }
+    const uint8_t byte = *ptr++;
+    value |= static_cast<uint32_t>(byte & 0x7fu) << shift;
+    if ((byte & 0x80u) == 0u) {
+      *cursor = ptr;
+      *out = value;
+      return true;
+    }
+    shift += 7u;
+  }
+  return false;
+}
+
+static void R0DumpReconAppendAlign4(std::vector<uint8_t>* image) {
+  if (image == nullptr) {
+    return;
+  }
+  while ((image->size() & 3u) != 0u) {
+    image->push_back(0u);
+  }
+}
+
+static bool R0DumpReconAppendUleb128(uint32_t value, std::vector<uint8_t>* out) {
+  if (out == nullptr) {
+    return false;
+  }
+  do {
+    uint8_t byte = static_cast<uint8_t>(value & 0x7fu);
+    value >>= 7;
+    if (value != 0u) {
+      byte |= 0x80u;
+    }
+    out->push_back(byte);
+  } while (value != 0u);
+  return true;
+}
+
+static bool R0DumpReconPatchU32(std::vector<uint8_t>* blob, size_t offset, uint32_t value) {
+  if (blob == nullptr || offset > blob->size() || sizeof(value) > blob->size() - offset) {
+    return false;
+  }
+  memcpy(blob->data() + offset, &value, sizeof(value));
+  return true;
+}
+
+static bool R0DumpReconReadU32(const std::vector<uint8_t>& blob, size_t offset, uint32_t* value) {
+  if (value == nullptr || offset > blob.size() || sizeof(*value) > blob.size() - offset) {
+    return false;
+  }
+  memcpy(value, blob.data() + offset, sizeof(*value));
+  return true;
+}
+
+static bool R0DumpReconCopyArrayBytes(const void* ptr,
+                                      uint64_t bytes64,
+                                      const char* label,
+                                      std::vector<uint8_t>* out,
+                                      R0DumpDexReconPlan* plan) {
+  if (out == nullptr || plan == nullptr || ptr == nullptr ||
+      bytes64 > std::numeric_limits<size_t>::max()) {
+    if (plan != nullptr) {
+      plan->reason =
+          android::base::StringPrintf("%s_copy_bad_args", label != nullptr ? label : "section");
+    }
+    return false;
+  }
+  const size_t bytes = static_cast<size_t>(bytes64);
+  if (bytes != 0u && !R0DumpIsReadableMemoryRange(ptr, bytes)) {
+    plan->reason = android::base::StringPrintf(
+        "%s_copy_unreadable_%zu", label != nullptr ? label : "section", bytes);
+    return false;
+  }
+  const uint8_t* begin = reinterpret_cast<const uint8_t*>(ptr);
+  out->assign(begin, begin + bytes);
+  return true;
+}
+
+static bool R0DumpReconCopyDataItem(const R0DumpDexReconState& state,
+                                    uint32_t old_off,
+                                    size_t size,
+                                    const char* label,
+                                    std::vector<uint8_t>* out,
+                                    R0DumpDexReconPlan* plan) {
+  if (out == nullptr || plan == nullptr || state.data_begin == nullptr ||
+      old_off >= state.data_size || size > state.data_size - old_off) {
+    if (plan != nullptr) {
+      plan->reason = android::base::StringPrintf(
+          "%s_oob_off_%u_size_%zu", label != nullptr ? label : "data", old_off, size);
+    }
+    return false;
+  }
+  const uint8_t* ptr = state.data_begin + old_off;
+  if (size != 0u && !R0DumpIsReadableMemoryRange(ptr, size)) {
+    plan->reason = android::base::StringPrintf(
+        "%s_unreadable_off_%u_size_%zu", label != nullptr ? label : "data", old_off, size);
+    return false;
+  }
+  out->assign(ptr, ptr + size);
+  return true;
+}
+
+static bool R0DumpReconReadStringDataItem(const R0DumpDexReconState& state,
+                                          uint32_t old_off,
+                                          const std::vector<R0DumpReconReadableRange>& ranges,
+                                          std::vector<uint8_t>* item,
+                                          R0DumpDexReconPlan* plan) {
+  if (item == nullptr || plan == nullptr || state.data_begin == nullptr ||
+      old_off >= state.data_size) {
+    if (plan != nullptr) {
+      plan->reason = android::base::StringPrintf("string_data_oob_%u", old_off);
+    }
+    return false;
+  }
+  const uint8_t* begin = state.data_begin + old_off;
+  static constexpr size_t kMaxReconStringDataBytes = 2u * 1024u * 1024u;
+  const size_t readable_bytes = R0DumpReconReadableBytesFromRanges(
+      ranges, begin, std::min(kMaxReconStringDataBytes, state.data_size - old_off));
+  if (readable_bytes == 0u) {
+    plan->reason = android::base::StringPrintf("string_data_unreadable_%u", old_off);
+    return false;
+  }
+  const uint8_t* cursor = begin;
+  const uint8_t* end = begin + readable_bytes;
+  uint32_t utf16_size = 0u;
+  if (!R0DumpReadUleb128Fast(&cursor, end, &utf16_size)) {
+    plan->reason = android::base::StringPrintf("string_data_bad_uleb_%u", old_off);
+    return false;
+  }
+  const uint8_t* scan = cursor;
+  while (scan < end) {
+    if (*scan == 0u) {
+      ++scan;
+      item->assign(begin, scan);
+      return true;
+    }
+    ++scan;
+  }
+  plan->reason = android::base::StringPrintf("string_data_unterminated_%u", old_off);
+  return false;
+}
+
+static bool R0DumpReconAppendTypeList(uint32_t old_off,
+                                      const R0DumpDexReconState& state,
+                                      std::vector<uint8_t>* image,
+                                      std::map<uint32_t, uint32_t>* offset_map,
+                                      uint32_t* item_count,
+                                      R0DumpDexReconPlan* plan) {
+  if (old_off == 0u) {
+    return true;
+  }
+  if (image == nullptr || offset_map == nullptr || item_count == nullptr || plan == nullptr) {
+    return false;
+  }
+  if (offset_map->find(old_off) != offset_map->end()) {
+    return true;
+  }
+  if (state.data_begin == nullptr || old_off > state.data_size ||
+      state.data_size - old_off < sizeof(uint32_t)) {
+    plan->reason = android::base::StringPrintf("type_list_oob_%u", old_off);
+    return false;
+  }
+  const uint8_t* ptr = state.data_begin + old_off;
+  if (!R0DumpIsReadableMemoryRange(ptr, sizeof(uint32_t))) {
+    plan->reason = android::base::StringPrintf("type_list_header_unreadable_%u", old_off);
+    return false;
+  }
+  uint32_t count = 0u;
+  memcpy(&count, ptr, sizeof(count));
+  static constexpr uint32_t kMaxReconTypeListItems = 8192u;
+  const size_t bytes = dex::TypeList::GetListSize(count);
+  if (count > kMaxReconTypeListItems || bytes > state.data_size - old_off) {
+    plan->reason = android::base::StringPrintf("type_list_bad_size_%u_count_%u", old_off, count);
+    return false;
+  }
+  std::vector<uint8_t> item;
+  if (!R0DumpReconCopyDataItem(state, old_off, bytes, "type_list", &item, plan)) {
+    return false;
+  }
+  R0DumpReconAppendAlign4(image);
+  const uint32_t new_off = static_cast<uint32_t>(image->size());
+  (*offset_map)[old_off] = new_off;
+  image->insert(image->end(), item.begin(), item.end());
+  ++(*item_count);
+  return true;
+}
+
+static bool R0DumpReconParseClassData(uint32_t old_off,
+                                      const R0DumpDexReconState& state,
+                                      R0DumpReconClassDataItem* out,
+                                      R0DumpDexReconPlan* plan) {
+  if (out == nullptr || plan == nullptr || state.data_begin == nullptr ||
+      old_off >= state.data_size) {
+    if (plan != nullptr) {
+      plan->reason = android::base::StringPrintf("class_data_oob_%u", old_off);
+    }
+    return false;
+  }
+  const uint8_t* ptr = state.data_begin + old_off;
+  const uint8_t* end = state.data_begin + state.data_size;
+  out->old_off = old_off;
+  if (!R0DumpReadUleb128Bounded(&ptr, end, &out->static_fields) ||
+      !R0DumpReadUleb128Bounded(&ptr, end, &out->instance_fields) ||
+      !R0DumpReadUleb128Bounded(&ptr, end, &out->direct_methods) ||
+      !R0DumpReadUleb128Bounded(&ptr, end, &out->virtual_methods)) {
+    plan->reason = android::base::StringPrintf("class_data_bad_header_%u", old_off);
+    return false;
+  }
+  static constexpr uint32_t kMaxReconClassMembers = 20000u;
+  const uint32_t total_fields = out->static_fields + out->instance_fields;
+  const uint32_t total_methods = out->direct_methods + out->virtual_methods;
+  if (out->static_fields > kMaxReconClassMembers || out->instance_fields > kMaxReconClassMembers ||
+      out->direct_methods > kMaxReconClassMembers || out->virtual_methods > kMaxReconClassMembers ||
+      total_fields > kMaxReconClassMembers || total_methods > kMaxReconClassMembers) {
+    plan->reason = android::base::StringPrintf("class_data_too_many_members_%u", old_off);
+    return false;
+  }
+  out->fields.clear();
+  out->methods.clear();
+  out->fields.reserve(total_fields);
+  out->methods.reserve(total_methods);
+  for (uint32_t i = 0u; i < total_fields; ++i) {
+    R0DumpReconFieldItem field;
+    if (!R0DumpReadUleb128Bounded(&ptr, end, &field.index_delta) ||
+        !R0DumpReadUleb128Bounded(&ptr, end, &field.access_flags)) {
+      plan->reason = android::base::StringPrintf("class_data_bad_field_%u_%u", old_off, i);
+      return false;
+    }
+    out->fields.push_back(field);
+  }
+  for (uint32_t i = 0u; i < total_methods; ++i) {
+    R0DumpReconMethodItem method;
+    if (!R0DumpReadUleb128Bounded(&ptr, end, &method.index_delta) ||
+        !R0DumpReadUleb128Bounded(&ptr, end, &method.access_flags) ||
+        !R0DumpReadUleb128Bounded(&ptr, end, &method.code_off)) {
+      plan->reason = android::base::StringPrintf("class_data_bad_method_%u_%u", old_off, i);
+      return false;
+    }
+    out->methods.push_back(method);
+  }
+  return true;
+}
+
+static bool R0DumpReconAppendClassData(const R0DumpReconClassDataItem& class_data,
+                                       const std::map<uint32_t, uint32_t>& code_offsets,
+                                       std::vector<uint8_t>* image) {
+  if (image == nullptr) {
+    return false;
+  }
+  if (!R0DumpReconAppendUleb128(class_data.static_fields, image) ||
+      !R0DumpReconAppendUleb128(class_data.instance_fields, image) ||
+      !R0DumpReconAppendUleb128(class_data.direct_methods, image) ||
+      !R0DumpReconAppendUleb128(class_data.virtual_methods, image)) {
+    return false;
+  }
+  for (const R0DumpReconFieldItem& field : class_data.fields) {
+    if (!R0DumpReconAppendUleb128(field.index_delta, image) ||
+        !R0DumpReconAppendUleb128(field.access_flags, image)) {
+      return false;
+    }
+  }
+  for (const R0DumpReconMethodItem& method : class_data.methods) {
+    uint32_t new_code_off = 0u;
+    if (method.code_off != 0u) {
+      auto it = code_offsets.find(method.code_off);
+      if (it != code_offsets.end()) {
+        new_code_off = it->second;
+      }
+    }
+    if (!R0DumpReconAppendUleb128(method.index_delta, image) ||
+        !R0DumpReconAppendUleb128(method.access_flags, image) ||
+        !R0DumpReconAppendUleb128(new_code_off, image)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+static bool R0DumpReconAppendCodeItem(const DexFile* dex_file,
+                                      uint32_t old_off,
+                                      const R0DumpDexReconState& state,
+                                      std::vector<uint8_t>* image,
+                                      std::map<uint32_t, uint32_t>* offset_map,
+                                      uint32_t* item_count,
+                                      R0DumpDexReconPlan* plan) {
+  if (old_off == 0u) {
+    return true;
+  }
+  if (dex_file == nullptr || image == nullptr || offset_map == nullptr || item_count == nullptr ||
+      plan == nullptr) {
+    return false;
+  }
+  if (offset_map->find(old_off) != offset_map->end()) {
+    return true;
+  }
+  if (state.data_begin == nullptr || old_off >= state.data_size ||
+      state.data_size - old_off < sizeof(uint16_t) * 4u + sizeof(uint32_t) * 2u) {
+    plan->reason = android::base::StringPrintf("code_item_oob_%u", old_off);
+    return false;
+  }
+  const uint8_t* ptr = state.data_begin + old_off;
+  if (!R0DumpIsReadableMemoryRange(ptr, sizeof(uint16_t) * 4u + sizeof(uint32_t) * 2u)) {
+    plan->reason = android::base::StringPrintf("code_item_header_unreadable_%u", old_off);
+    return false;
+  }
+  const dex::CodeItem* code_item = reinterpret_cast<const dex::CodeItem*>(ptr);
+  const uint32_t code_size = dex_file->GetCodeItemSize(*code_item);
+  static constexpr uint32_t kMaxReconCodeItemBytes = 16u * 1024u * 1024u;
+  if (code_size == 0u || code_size > kMaxReconCodeItemBytes ||
+      code_size > state.data_size - old_off) {
+    plan->reason = android::base::StringPrintf("code_item_bad_size_%u_%u", old_off, code_size);
+    return false;
+  }
+  std::vector<uint8_t> item;
+  if (!R0DumpReconCopyDataItem(state, old_off, code_size, "code_item", &item, plan)) {
+    return false;
+  }
+  static constexpr size_t kStandardCodeItemDebugInfoOffOffset = sizeof(uint16_t) * 4u;
+  if (item.size() >= kStandardCodeItemDebugInfoOffOffset + sizeof(uint32_t)) {
+    const uint32_t zero = 0u;
+    memcpy(item.data() + kStandardCodeItemDebugInfoOffOffset, &zero, sizeof(zero));
+  }
+  R0DumpReconAppendAlign4(image);
+  const uint32_t new_off = static_cast<uint32_t>(image->size());
+  (*offset_map)[old_off] = new_off;
+  image->insert(image->end(), item.begin(), item.end());
+  ++(*item_count);
+  return true;
+}
+
+static void R0DumpReconAddMapEntry(std::vector<R0DumpDexReconMapEntry>* entries,
+                                   uint16_t type,
+                                   uint32_t size,
+                                   uint32_t offset) {
+  if (entries == nullptr || size == 0u || (offset == 0u && type != DexFile::kDexTypeHeaderItem)) {
+    return;
+  }
+  R0DumpDexReconMapEntry entry;
+  entry.type = type;
+  entry.size = size;
+  entry.offset = offset;
+  entries->push_back(entry);
+}
+
+static bool R0DumpReconWriteMapList(std::vector<uint8_t>* image,
+                                    uint32_t map_off,
+                                    const std::vector<R0DumpDexReconMapEntry>& entries) {
+  if (image == nullptr || map_off > image->size() || sizeof(uint32_t) > image->size() - map_off) {
+    return false;
+  }
+  const uint64_t bytes64 =
+      sizeof(uint32_t) + static_cast<uint64_t>(entries.size()) * sizeof(dex::MapItem);
+  if (bytes64 > image->size() - map_off) {
+    return false;
+  }
+  uint8_t* cursor = image->data() + map_off;
+  const uint32_t item_count = static_cast<uint32_t>(entries.size());
+  memcpy(cursor, &item_count, sizeof(item_count));
+  cursor += sizeof(item_count);
+  for (const R0DumpDexReconMapEntry& entry : entries) {
+    dex::MapItem item = {};
+    item.type_ = entry.type;
+    item.size_ = entry.size;
+    item.offset_ = entry.offset;
+    memcpy(cursor, &item, sizeof(item));
+    cursor += sizeof(item);
+  }
+  return true;
+}
+
+static bool R0DumpReconLooksLikeClassDescriptor(std::string_view descriptor) {
+  if (descriptor.size() < 3u || descriptor.front() != 'L' || descriptor.back() != ';') {
+    return false;
+  }
+  for (char ch : descriptor) {
+    if (ch == '\0' || ch == '[') {
+      return false;
+    }
+  }
+  return true;
+}
+
+static bool R0DumpReconTypeIndexHasClassDescriptor(
+    const DexFile* dex_file,
+    const R0DumpDexReconState& state,
+    const std::vector<R0DumpReconReadableRange>& readable_ranges,
+    dex::TypeIndex type_idx,
+    const char* label,
+    uint32_t item_idx,
+    R0DumpDexReconPlan* plan) {
+  const char* safe_label = label != nullptr ? label : "type_idx";
+  if (dex_file == nullptr || plan == nullptr || !type_idx.IsValid() ||
+      type_idx.index_ >= dex_file->NumTypeIds()) {
+    plan->reason = android::base::StringPrintf(
+        "%s_%u_invalid_type_idx_%u", safe_label, item_idx, type_idx.index_);
+    R0DumpLog(ANDROID_LOG_WARN,
+              "dexrecon invalid class descriptor source=%s item=%u type_idx=%u",
+              safe_label,
+              item_idx,
+              type_idx.index_);
+    return false;
+  }
+  const dex::TypeId& type_id = dex_file->GetTypeId(type_idx);
+  if (!R0DumpIsReadableMemoryRange(&type_id, sizeof(type_id)) ||
+      type_id.descriptor_idx_.index_ >= dex_file->NumStringIds()) {
+    plan->reason = android::base::StringPrintf(
+        "%s_%u_bad_descriptor_string_idx_%u",
+        safe_label,
+        item_idx,
+        type_id.descriptor_idx_.index_);
+    R0DumpLog(ANDROID_LOG_WARN,
+              "dexrecon invalid class descriptor source=%s item=%u bad string_idx=%u",
+              safe_label,
+              item_idx,
+              type_id.descriptor_idx_.index_);
+    return false;
+  }
+  const dex::StringId& string_id = dex_file->GetStringId(type_id.descriptor_idx_);
+  if (!R0DumpIsReadableMemoryRange(&string_id, sizeof(string_id))) {
+    plan->reason = android::base::StringPrintf(
+        "%s_%u_unreadable_descriptor_string_id_%u",
+        safe_label,
+        item_idx,
+        type_id.descriptor_idx_.index_);
+    R0DumpLog(ANDROID_LOG_WARN,
+              "dexrecon invalid class descriptor source=%s item=%u unreadable string_id=%u",
+              safe_label,
+              item_idx,
+              type_id.descriptor_idx_.index_);
+    return false;
+  }
+  if (state.data_begin == nullptr || string_id.string_data_off_ >= state.data_size) {
+    plan->reason = android::base::StringPrintf(
+        "%s_%u_descriptor_oob_%u", safe_label, item_idx, string_id.string_data_off_);
+    R0DumpLog(ANDROID_LOG_WARN,
+              "dexrecon invalid class descriptor source=%s item=%u oob data off=%u",
+              safe_label,
+              item_idx,
+              string_id.string_data_off_);
+    return false;
+  }
+  const uint8_t* begin = state.data_begin + string_id.string_data_off_;
+  static constexpr size_t kMaxReconDescriptorBytes = 4096u;
+  const size_t readable_bytes = R0DumpReconReadableBytesFromRanges(
+      readable_ranges, begin, std::min(kMaxReconDescriptorBytes,
+                                       static_cast<size_t>(state.data_size -
+                                                           string_id.string_data_off_)));
+  if (readable_bytes == 0u) {
+    plan->reason = android::base::StringPrintf(
+        "%s_%u_descriptor_unreadable_%u", safe_label, item_idx, string_id.string_data_off_);
+    R0DumpLog(ANDROID_LOG_WARN,
+              "dexrecon invalid class descriptor source=%s item=%u unreadable data off=%u",
+              safe_label,
+              item_idx,
+              string_id.string_data_off_);
+    return false;
+  }
+  const uint8_t* cursor = begin;
+  const uint8_t* end = begin + readable_bytes;
+  uint32_t utf16_size = 0u;
+  if (!R0DumpReadUleb128Fast(&cursor, end, &utf16_size) || cursor >= end) {
+    plan->reason =
+        android::base::StringPrintf("%s_%u_bad_descriptor_uleb", safe_label, item_idx);
+    R0DumpLog(ANDROID_LOG_WARN,
+              "dexrecon invalid class descriptor source=%s item=%u bad uleb off=%u",
+              safe_label,
+              item_idx,
+              string_id.string_data_off_);
+    return false;
+  }
+  const uint8_t* descriptor_end = cursor;
+  while (descriptor_end < end && *descriptor_end != 0u) {
+    ++descriptor_end;
+  }
+  if (descriptor_end >= end) {
+    plan->reason =
+        android::base::StringPrintf("%s_%u_descriptor_unterminated", safe_label, item_idx);
+    R0DumpLog(ANDROID_LOG_WARN,
+              "dexrecon invalid class descriptor source=%s item=%u unterminated off=%u",
+              safe_label,
+              item_idx,
+              string_id.string_data_off_);
+    return false;
+  }
+  const std::string_view descriptor(
+      reinterpret_cast<const char*>(cursor),
+      static_cast<size_t>(descriptor_end - cursor));
+  if (!R0DumpReconLooksLikeClassDescriptor(descriptor)) {
+    plan->reason = android::base::StringPrintf(
+        "%s_%u_invalid_descriptor", safe_label, item_idx);
+    R0DumpLog(ANDROID_LOG_WARN,
+              "dexrecon invalid class descriptor source=%s item=%u type_idx=%u descriptor=%.*s",
+              safe_label,
+              item_idx,
+              type_idx.index_,
+              static_cast<int>(std::min<size_t>(descriptor.size(), 120u)),
+              descriptor.data());
+    return false;
+  }
+  return true;
+}
+
+static bool R0DumpReconClassDefHasValidDescriptor(
+    const DexFile* dex_file,
+    const R0DumpDexReconState& state,
+    const std::vector<R0DumpReconReadableRange>& readable_ranges,
+    const dex::ClassDef& class_def,
+    uint32_t class_def_idx,
+    R0DumpDexReconPlan* plan) {
+  const std::string previous_reason = plan->reason;
+  if (!R0DumpReconTypeIndexHasClassDescriptor(dex_file,
+                                              state,
+                                              readable_ranges,
+                                              class_def.class_idx_,
+                                              "class_def",
+                                              class_def_idx,
+                                              plan)) {
+    plan->reason = previous_reason;
+    return false;
+  }
+  return true;
+}
+
+static bool R0DumpBuildDexReconImage(const DexFile* dex_file,
+                                     const R0DumpDexReconState& state,
+                                     R0DumpDexReconPlan* plan,
+                                     std::vector<uint8_t>* image) {
+  if (!R0DumpBuildDexReconPlan(dex_file, state, plan) || image == nullptr || plan == nullptr ||
+      plan->file_size == 0u) {
+    return false;
+  }
