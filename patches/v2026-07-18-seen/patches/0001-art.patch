+static void R0DumpDumpDexFile(ArtMethod* artmethod, uint32_t strategy)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  if (artmethod == nullptr || artmethod->IsRuntimeMethod()) {
+    return;
+  }
+  R0DumpDumpDexFile(R0DumpResolveDexFile(artmethod, nullptr), strategy);
+}
