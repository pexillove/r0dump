+        first_data_off = item.offset_;
+      }
+      last_offset = item.offset_;
+    }
+    if (ok && has_header && has_map && first_data_off != 0u) {
+      *map_off_out = off;
+      *data_off_out = first_data_off;
+      return true;
+    }
+  }
+  return false;
+}
+
+static bool R0DumpDexFixedNeedsWrite(const DexFile* dex_file,
+                                     const DexFile::Header& fixed_header,
+                                     size_t dex_size,
+                                     uint32_t strategy) {
+  if (strategy == kR0DumpStrategyDefineClass) {
+    return true;
+  }
+  if (dex_file == nullptr || dex_file->Begin() == nullptr || dex_size < sizeof(DexFile::Header) ||
+      !R0DumpIsReadableMemoryRange(dex_file->Begin(), sizeof(DexFile::Header)) ||
+      !StandardDexFile::IsMagicValid(dex_file->Begin())) {
+    return true;
+  }
+  DexFile::Header current = {};
+  memcpy(&current, dex_file->Begin(), sizeof(current));
+  return current.file_size_ != dex_size || current.header_size_ < sizeof(DexFile::Header) ||
+         current.endian_tag_ != DexFile::kDexEndianConstant ||
+         current.string_ids_size_ != fixed_header.string_ids_size_ ||
+         current.string_ids_off_ != fixed_header.string_ids_off_ ||
+         current.type_ids_size_ != fixed_header.type_ids_size_ ||
+         current.type_ids_off_ != fixed_header.type_ids_off_ ||
+         current.proto_ids_size_ != fixed_header.proto_ids_size_ ||
+         current.proto_ids_off_ != fixed_header.proto_ids_off_ ||
+         current.field_ids_size_ != fixed_header.field_ids_size_ ||
+         current.field_ids_off_ != fixed_header.field_ids_off_ ||
+         current.method_ids_size_ != fixed_header.method_ids_size_ ||
+         current.method_ids_off_ != fixed_header.method_ids_off_ ||
+         current.class_defs_size_ != fixed_header.class_defs_size_ ||
+         current.class_defs_off_ != fixed_header.class_defs_off_ || current.map_off_ == 0u;
+}
+
+static bool R0DumpBuildDexFixedImageFromArtDexFile(const DexFile* dex_file,
+                                                   size_t dex_size,
+                                                   uint32_t strategy,
+                                                   std::vector<uint8_t>* image,
+                                                   std::string* reason) {
+  if (reason != nullptr) {
+    reason->clear();
+  }
+  if (image == nullptr) {
+    return false;
+  }
+  image->clear();
+  if (dex_file == nullptr || dex_file->Begin() == nullptr || dex_size < sizeof(DexFile::Header)) {
+    if (reason != nullptr) {
+      *reason = "missing_or_too_small";
+    }
+    return false;
+  }
+
+  const uint32_t string_ids_size = static_cast<uint32_t>(dex_file->NumStringIds());
+  const uint32_t type_ids_size = static_cast<uint32_t>(dex_file->NumTypeIds());
+  const uint32_t proto_ids_size = static_cast<uint32_t>(dex_file->NumProtoIds());
+  const uint32_t field_ids_size = static_cast<uint32_t>(dex_file->NumFieldIds());
+  const uint32_t method_ids_size = static_cast<uint32_t>(dex_file->NumMethodIds());
+  const uint32_t class_defs_size = static_cast<uint32_t>(dex_file->NumClassDefs());
+
+  uint32_t string_ids_off = 0u;
+  uint32_t type_ids_off = 0u;
+  uint32_t proto_ids_off = 0u;
+  uint32_t field_ids_off = 0u;
+  uint32_t method_ids_off = 0u;
+  uint32_t class_defs_off = 0u;
+  if (!R0DumpPointerOffsetInDex(dex_file,
+                                string_ids_size != 0u ? &dex_file->GetStringId(dex::StringIndex(0u))
+                                                       : nullptr,
+                                string_ids_size,
+                                sizeof(dex::StringId),
+                                dex_size,
+                                "string_ids",
+                                &string_ids_off) ||
+      !R0DumpPointerOffsetInDex(dex_file,
+                                type_ids_size != 0u ? &dex_file->GetTypeId(dex::TypeIndex(0u))
+                                                     : nullptr,
+                                type_ids_size,
+                                sizeof(dex::TypeId),
+                                dex_size,
+                                "type_ids",
+                                &type_ids_off) ||
+      !R0DumpPointerOffsetInDex(dex_file,
+                                proto_ids_size != 0u ? &dex_file->GetProtoId(dex::ProtoIndex(0u))
+                                                      : nullptr,
+                                proto_ids_size,
+                                sizeof(dex::ProtoId),
+                                dex_size,
+                                "proto_ids",
+                                &proto_ids_off) ||
+      !R0DumpPointerOffsetInDex(dex_file,
+                                field_ids_size != 0u ? &dex_file->GetFieldId(0u) : nullptr,
+                                field_ids_size,
+                                sizeof(dex::FieldId),
+                                dex_size,
+                                "field_ids",
+                                &field_ids_off) ||
+      !R0DumpPointerOffsetInDex(dex_file,
+                                method_ids_size != 0u ? &dex_file->GetMethodId(0u) : nullptr,
+                                method_ids_size,
+                                sizeof(dex::MethodId),
+                                dex_size,
+                                "method_ids",
+                                &method_ids_off) ||
+      !R0DumpPointerOffsetInDex(dex_file,
+                                class_defs_size != 0u ? &dex_file->GetClassDef(0u) : nullptr,
+                                class_defs_size,
+                                sizeof(dex::ClassDef),
+                                dex_size,
+                                "class_defs",
+                                &class_defs_off)) {
+    if (reason != nullptr) {
+      *reason = "section_offset_failed";
+    }
+    return false;
+  }
+
+  uint32_t static_end = sizeof(DexFile::Header);
+  auto bump_static_end = [&](uint32_t offset, uint32_t count, size_t item_size) -> bool {
+    if (count == 0u) {
+      return true;
+    }
+    const uint64_t bytes = static_cast<uint64_t>(count) * item_size;
+    const uint64_t end = static_cast<uint64_t>(offset) + bytes;
+    if (bytes > std::numeric_limits<uint32_t>::max() || end > dex_size ||
+        end > std::numeric_limits<uint32_t>::max()) {
+      return false;
+    }
+    static_end = std::max(static_end, static_cast<uint32_t>(end));
+    return true;
+  };
+  if (!bump_static_end(string_ids_off, string_ids_size, sizeof(dex::StringId)) ||
+      !bump_static_end(type_ids_off, type_ids_size, sizeof(dex::TypeId)) ||
+      !bump_static_end(proto_ids_off, proto_ids_size, sizeof(dex::ProtoId)) ||
+      !bump_static_end(field_ids_off, field_ids_size, sizeof(dex::FieldId)) ||
+      !bump_static_end(method_ids_off, method_ids_size, sizeof(dex::MethodId)) ||
+      !bump_static_end(class_defs_off, class_defs_size, sizeof(dex::ClassDef))) {
+    if (reason != nullptr) {
+      *reason = "static_section_oob";
+    }
+    return false;
+  }
+
+  uint64_t sparse_copied_bytes = 0u;
+  if (!R0DumpDexFixedCopySparseImage(dex_file->Begin(), dex_size, image, &sparse_copied_bytes)) {
+    if (reason != nullptr) {
+      *reason = "sparse_copy_failed";
+    }
+    image->clear();
+    return false;
+  }
+
+  uint32_t existing_map_off = 0u;
+  uint32_t existing_data_off = 0u;
+  const bool has_existing_map = R0DumpDexFixedFindMapList(image->data(),
+                                                          image->size(),
+                                                          string_ids_size,
+                                                          string_ids_off,
+                                                          type_ids_size,
+                                                          type_ids_off,
+                                                          proto_ids_size,
+                                                          proto_ids_off,
+                                                          field_ids_size,
+                                                          field_ids_off,
+                                                          method_ids_size,
+                                                          method_ids_off,
+                                                          class_defs_size,
+                                                          class_defs_off,
+                                                          &existing_map_off,
+                                                          &existing_data_off);
+
+  DexFile::Header header = {};
+  if (R0DumpIsReadableMemoryRange(dex_file->Begin(), header.magic_.size()) &&
+      StandardDexFile::IsMagicValid(dex_file->Begin())) {
+    memcpy(header.magic_.data(), dex_file->Begin(), header.magic_.size());
+  } else {
+    static constexpr uint8_t kDex039Magic[8] = {'d', 'e', 'x', '\n', '0', '3', '9', '\0'};
+    memcpy(header.magic_.data(), kDex039Magic, sizeof(kDex039Magic));
+  }
+  header.header_size_ = sizeof(DexFile::Header);
+  header.endian_tag_ = DexFile::kDexEndianConstant;
+  header.string_ids_size_ = string_ids_size;
+  header.string_ids_off_ = string_ids_off;
+  header.type_ids_size_ = type_ids_size;
+  header.type_ids_off_ = type_ids_off;
+  header.proto_ids_size_ = proto_ids_size;
+  header.proto_ids_off_ = proto_ids_off;
+  header.field_ids_size_ = field_ids_size;
+  header.field_ids_off_ = field_ids_off;
+  header.method_ids_size_ = method_ids_size;
+  header.method_ids_off_ = method_ids_off;
+  header.class_defs_size_ = class_defs_size;
+  header.class_defs_off_ = class_defs_off;
+  header.data_off_ = R0DumpDexFixedAlign4(static_end);
+
+  if (!R0DumpDexFixedNeedsWrite(dex_file, header, dex_size, strategy)) {
+    if (reason != nullptr) {
+      *reason = "raw_header_already_consistent";
+    }
+    image->clear();
+    return false;
+  }
+
+  if (has_existing_map) {
+    header.file_size_ = static_cast<uint32_t>(image->size());
+    header.map_off_ = existing_map_off;
+    header.data_off_ = existing_data_off;
+    header.data_size_ = header.file_size_ > header.data_off_ ?
+        header.file_size_ - header.data_off_ : 0u;
+    memcpy(image->data(), &header, sizeof(header));
+    R0DumpFinalizeDexImage(image);
+    R0DumpLog(ANDROID_LOG_DEBUG,
+              "dexfixed reused original map strategy=%s size=%zu mapOff=%u dataOff=%u "
+              "staticEnd=%u copied=%llu",
+              R0DumpStrategyName(strategy),
+              dex_size,
+              existing_map_off,
+              existing_data_off,
+              static_end,
+              static_cast<unsigned long long>(sparse_copied_bytes));
+    return true;
+  }
+
+  struct FixedMapItem {
+    uint16_t type;
+    uint32_t size;
+    uint32_t offset;
+  };
+  std::vector<FixedMapItem> map_items;
+  auto add_map_item = [&](uint16_t type, uint32_t size, uint32_t offset) {
+    if (size != 0u) {
+      map_items.push_back({type, size, offset});
+    }
+  };
+  add_map_item(DexFile::kDexTypeHeaderItem, 1u, 0u);
+  add_map_item(DexFile::kDexTypeStringIdItem, string_ids_size, string_ids_off);
+  add_map_item(DexFile::kDexTypeTypeIdItem, type_ids_size, type_ids_off);
+  add_map_item(DexFile::kDexTypeProtoIdItem, proto_ids_size, proto_ids_off);
+  add_map_item(DexFile::kDexTypeFieldIdItem, field_ids_size, field_ids_off);
+  add_map_item(DexFile::kDexTypeMethodIdItem, method_ids_size, method_ids_off);
+  add_map_item(DexFile::kDexTypeClassDefItem, class_defs_size, class_defs_off);
+  std::sort(map_items.begin(), map_items.end(), [](const FixedMapItem& left,
+                                                   const FixedMapItem& right) {
+    return left.offset < right.offset;
+  });
+
+  const uint32_t map_off = R0DumpDexFixedAlign4(static_cast<uint32_t>(image->size()));
+  image->resize(map_off, 0u);
+  R0DumpAppendU32(image, static_cast<uint32_t>(map_items.size() + 1u));
+  for (const FixedMapItem& item : map_items) {
+    R0DumpAppendU16(image, item.type);
+    R0DumpAppendU16(image, 0u);
+    R0DumpAppendU32(image, item.size);
+    R0DumpAppendU32(image, item.offset);
+  }
+  R0DumpAppendU16(image, DexFile::kDexTypeMapList);
+  R0DumpAppendU16(image, 0u);
+  R0DumpAppendU32(image, 1u);
+  R0DumpAppendU32(image, map_off);
+
+  header.file_size_ = static_cast<uint32_t>(image->size());
+  header.map_off_ = map_off;
+  header.data_size_ =
+      header.file_size_ > header.data_off_ ? header.file_size_ - header.data_off_ : 0u;
+  memcpy(image->data(), &header, sizeof(header));
+  R0DumpFinalizeDexImage(image);
+  R0DumpLog(ANDROID_LOG_DEBUG,
+            "dexfixed synthesized map strategy=%s rawSize=%zu fixedSize=%zu mapOff=%u "
+            "dataOff=%u copied=%llu",
+            R0DumpStrategyName(strategy),
+            dex_size,
+            image->size(),
+            map_off,
+            header.data_off_,
+            static_cast<unsigned long long>(sparse_copied_bytes));
+  return true;
+}
+
+static bool R0DumpWriteDexFixedImage(const std::string& out_dir,
+                                     const DexFile* dex_file,
+                                     size_t dex_size,
+                                     uint32_t strategy) {
+  std::vector<uint8_t> image;
+  std::string reason;
+  if (!R0DumpBuildDexFixedImageFromArtDexFile(dex_file, dex_size, strategy, &image, &reason)) {
+    if (!reason.empty() && reason != "raw_header_already_consistent") {
+      R0DumpLog(ANDROID_LOG_DEBUG,
+                "dexfixed skipped strategy=%s reason=%s begin=%p size=%zu",
+                R0DumpStrategyName(strategy),
+                reason.c_str(),
+                dex_file != nullptr ? dex_file->Begin() : nullptr,
+                dex_size);
+    }
+    return false;
+  }
+
+  const std::string content_hash = R0DumpHashHex(
+      R0DumpFnv1a64(image.data(), std::min(image.size(), static_cast<size_t>(1024u * 1024u))));
+  const uint32_t checksum = reinterpret_cast<const DexFile::Header*>(image.data())->checksum_;
+  const std::string file_name = android::base::StringPrintf("dexfixed_%s_%zu_0x%08x_%s%s.dex",
+                                                            content_hash.c_str(),
+                                                            dex_size,
+                                                            checksum,
+                                                            R0DumpStrategyName(strategy),
+                                                            gR0DumpRunFileSuffix.c_str());
+  if (!R0DumpReserveDexFileName(file_name)) {
+    return true;
+  }
+
+  const std::string process_component = R0DumpSanitizePathComponent(R0DumpReadCmdline());
+  if (R0DumpShouldUseMediaStoreDownloads() &&
+      R0DumpWriteDexViaMediaStore(process_component, file_name, image.data(), image.size())) {
+    {
+      std::lock_guard<std::mutex> lock(gR0DumpStateMutex);
+      gR0DumpDexFilesWritten++;
+      gR0DumpByStrategy[R0DumpStrategyName(strategy)]++;
+    }
+    R0DumpLog(ANDROID_LOG_INFO,
+              "dexfixed dumped via MediaStore strategy=%s rawSize=%zu fixedSize=%zu checksum=0x%08x "
+              "path=Download/R0DUMP/%s/%s",
+              R0DumpStrategyName(strategy),
+              dex_size,
+              image.size(),
+              checksum,
+              process_component.c_str(),
+              file_name.c_str());
+    R0DumpWriteStatus(R0DumpOutputDir(), "dumping");
+    return true;
+  }
+
+  std::string fixed_out_dir = out_dir;
+  if (fixed_out_dir.empty()) {
+    fixed_out_dir = R0DumpOutputDir();
+  }
+  if (fixed_out_dir.empty()) {
+    R0DumpForgetDexFileName(file_name);
+    return false;
+  }
+  const std::string path = fixed_out_dir + "/" + file_name;
+  int write_errno = 0;
+  if (R0DumpWriteFileIfAbsent(path, image.data(), image.size(), &write_errno)) {
+    {
+      std::lock_guard<std::mutex> lock(gR0DumpStateMutex);
+      gR0DumpDexFilesWritten++;
+      gR0DumpByStrategy[R0DumpStrategyName(strategy)]++;
+    }
+    R0DumpLog(ANDROID_LOG_INFO,
+              "dexfixed dumped strategy=%s rawSize=%zu fixedSize=%zu checksum=0x%08x path=%s",
+              R0DumpStrategyName(strategy),
+              dex_size,
+              image.size(),
+              checksum,
+              path.c_str());
+    R0DumpWriteStatus(fixed_out_dir, "dumping");
+    return true;
+  }
+  R0DumpForgetDexFileName(file_name);
+  R0DumpLog(ANDROID_LOG_WARN,
+            "dexfixed write failed strategy=%s size=%zu errno=%d(%s) path=%s",
+            R0DumpStrategyName(strategy),
+            image.size(),
+            write_errno,
+            strerror(write_errno),
+            path.c_str());
+  return false;
+}
+
+static std::string R0DumpByStrategyJson(const std::map<std::string, uint64_t>& by_strategy) {
+  std::string out = "{";
+  bool first = true;
+  for (const auto& entry : by_strategy) {
+    if (!first) {
+      out += ",";
+    }
+    first = false;
+    out += android::base::StringPrintf(
+        "\"%s\":%llu", entry.first.c_str(), static_cast<unsigned long long>(entry.second));
+  }
+  out += "}";
+  return out;
+}
+
+static std::string R0DumpByDexJson(const std::map<std::string, R0DumpDexStats>& by_dex) {
+  std::string out = "[";
+  bool first = true;
+  for (const auto& entry : by_dex) {
+    const R0DumpDexStats& stats = entry.second;
+    if (!first) {
+      out += ",";
+    }
+    first = false;
+    out += android::base::StringPrintf(
+        "{\"dex_size\":%zu,\"dex_checksum\":\"0x%08x\","
+        "\"location_hash\":\"%s\",\"methods\":%llu,\"duplicates\":%llu,"
+        "\"compact_skipped\":%llu}",
+        stats.dex_size,
+        stats.checksum,
+        stats.location_hash.c_str(),
+        static_cast<unsigned long long>(stats.methods),
+        static_cast<unsigned long long>(stats.duplicates),
+        static_cast<unsigned long long>(stats.compact_skipped));
+  }
+  out += "]";
+  return out;
+}
+
+static void R0DumpWriteStatus(const std::string& out_dir, const char* phase, bool force) {
+  if (out_dir.empty()) {
+    return;
+  }
+  uint64_t dex_files = 0;
+  uint64_t dexdata_files = 0;
+  uint64_t dexdata_requests = 0;
+  uint64_t dexdata_failures = 0;
+  uint64_t async_queued = 0;
+  uint64_t async_started = 0;
+  uint64_t async_completed = 0;
+  uint64_t async_dropped = 0;
+  size_t async_pending = 0u;
+  uint64_t methods = 0;
+  uint64_t duplicates = 0;
+  uint64_t compact_skipped = 0;
+  uint64_t invalid_skipped = 0;
+  std::map<std::string, uint64_t> method_skip_reasons;
+  uint64_t backfill_attempts = 0;
+  uint64_t backfill_success = 0;
+  uint64_t backfill_failed = 0;
+  uint64_t backfill_skipped_by_guard = 0;
+  uint64_t backfill_invoked_unchanged = 0;
+  uint64_t backfill_invoke_exceptions = 0;
+  uint64_t classloader_candidates = 0;
+  uint64_t classloaders_walked = 0;
+  uint64_t classloader_dex_elements = 0;
+  uint64_t classloader_unique_cookies = 0;
+  uint64_t loaded_class_table_classes = 0;
+  uint64_t manifest_component_classes = 0;
+  uint64_t manifest_seed_dumped = 0;
+  std::string class_loaders_json = "[]";
+  std::map<std::string, uint64_t> by_strategy;
+  std::map<std::string, R0DumpDexStats> by_dex;
+  const time_t now = time(nullptr);
+  {
+    std::lock_guard<std::mutex> lock(gR0DumpStateMutex);
+    if (!force && now == gR0DumpLastStatusWriteAt &&
+        gR0DumpMethodRecordsWritten < gR0DumpLastStatusMethodCount + 100u) {
+      return;
+    }
+    gR0DumpLastStatusWriteAt = now;
+    gR0DumpLastStatusMethodCount = gR0DumpMethodRecordsWritten;
+    dex_files = gR0DumpDexFilesWritten;
+    dexdata_files = gR0DumpDexDataFilesWritten;
+    dexdata_requests = gR0DumpDexDataDumpRequests;
+    dexdata_failures = gR0DumpDexDataDumpFailures;
+    methods = gR0DumpMethodRecordsWritten;
+    duplicates = gR0DumpDuplicateMethodsSkipped;
+    compact_skipped = gR0DumpCompactDexMethodsSkipped;
+    invalid_skipped = gR0DumpInvalidMethodsSkipped;
+    method_skip_reasons = gR0DumpMethodSkipReasons;
+    backfill_attempts = gR0DumpForceBackfillAttempts;
+    backfill_success = gR0DumpForceBackfillSuccess;
+    backfill_failed = gR0DumpForceBackfillFailed;
+    backfill_skipped_by_guard = gR0DumpForceBackfillSkippedByGuard;
+    backfill_invoked_unchanged = gR0DumpForceBackfillInvokedUnchanged;
+    backfill_invoke_exceptions = gR0DumpForceBackfillInvokeExceptions;
+    classloader_candidates = gR0DumpClassLoaderCandidates;
+    classloaders_walked = gR0DumpClassLoadersWalked;
+    classloader_dex_elements = gR0DumpClassLoaderDexElements;
+    classloader_unique_cookies = gR0DumpClassLoaderUniqueCookies;
+    loaded_class_table_classes = gR0DumpLoadedClassTableClasses;
+    manifest_component_classes = gR0DumpManifestComponentClasses;
+    manifest_seed_dumped = gR0DumpManifestSeedDumped;
+    class_loaders_json = gR0DumpClassLoadersJson;
+    by_strategy = gR0DumpByStrategy;
+    by_dex = gR0DumpByDex;
+  }
+  async_queued = gR0DumpAsyncDexTasksQueued.load(std::memory_order_relaxed);
+  async_started = gR0DumpAsyncDexTasksStarted.load(std::memory_order_relaxed);
+  async_completed = gR0DumpAsyncDexTasksCompleted.load(std::memory_order_relaxed);
+  async_dropped = gR0DumpAsyncDexTasksDropped.load(std::memory_order_relaxed);
+  {
+    std::lock_guard<std::mutex> lock(gR0DumpAsyncMutex);
+    async_pending = gR0DumpAsyncDexQueue.size();
+  }
+  const std::string process_name = R0DumpReadCmdline();
+  const std::string status = android::base::StringPrintf(
+      "{\n"
+      "  \"version\": 2,\n"
+      "  \"phase\": \"%s\",\n"
+      "  \"process\": \"%s\",\n"
+      "  \"package\": \"%s\",\n"
+      "  \"pid\": %d,\n"
+      "  \"output_dir\": \"%s\",\n"
+      "  \"started_at\": %lld,\n"
+      "  \"updated_at\": %lld,\n"
+      "  \"strategy_mask\": %u,\n"
+      "  \"strategies\": %s,\n"
+      "  \"dex_files_written\": %llu,\n"
+      "  \"dexdata_files_written\": %llu,\n"
+      "  \"dexdata_dump_requests\": %llu,\n"
+      "  \"dexdata_dump_failures\": %llu,\n"
+      "  \"async_dex_tasks_queued\": %llu,\n"
+      "  \"async_dex_tasks_started\": %llu,\n"
+      "  \"async_dex_tasks_completed\": %llu,\n"
+      "  \"async_dex_tasks_dropped\": %llu,\n"
+      "  \"async_dex_tasks_pending\": %zu,\n"
