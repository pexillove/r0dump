+static bool R0DumpWriteRawCodeItemRecord(const std::string& out_dir,
+                                         ArtMethod* artmethod,
+                                         const DexFile* art_dex_file,
+                                         const DexFile* fallback_dex_file,
+                                         uint32_t strategy) REQUIRES_SHARED(Locks::mutator_lock_) {
+  if (out_dir.empty()) {
