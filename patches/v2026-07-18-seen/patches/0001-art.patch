+static std::string R0DumpDexDataSparseFileName(const DexFile* dex_file,
+                                              size_t data_size,
+                                              uint32_t strategy) {
+  if (dex_file == nullptr || data_size == 0u) {
+    return "";
+  }
+  const std::string location_hash = R0DumpDexLocationHash(dex_file);
+  return android::base::StringPrintf("dexdata_%s_%zu_0x00000000_%s%s.bin",
+                                     location_hash.c_str(),
+                                     data_size,
+                                     R0DumpStrategyName(strategy),
+                                     gR0DumpRunFileSuffix.c_str());
+}
