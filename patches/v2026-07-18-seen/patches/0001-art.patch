+static bool R0DumpDumpDexDataSparse(const std::string& out_dir,
+                                    const DexFile* dex_file,
+                                    uint32_t strategy,
+                                    bool file_name_reserved) {
+  static constexpr size_t kR0DumpMaxSparseDexDataSize = 512u * 1024u * 1024u;
+  const void* probe_data_begin = dex_file != nullptr ? dex_file->DataBegin() : nullptr;
+  if (out_dir.empty() || dex_file == nullptr || probe_data_begin == nullptr) {
+    R0DumpLog(
+        ANDROID_LOG_DEBUG,
+        "dexdata sparse skipped reason=missing_input strategy=%s outEmpty=%d dex=%p dataBegin=%p",
+        R0DumpStrategyName(strategy),
+        out_dir.empty() ? 1 : 0,
+        dex_file,
+        probe_data_begin);
+    return false;
+  }
+  const uint8_t* data_begin = dex_file->DataBegin();
+  const size_t data_size = dex_file->DataSize();
+  const uintptr_t data_start = reinterpret_cast<uintptr_t>(data_begin);
+  if (data_size == 0u || data_size > kR0DumpMaxSparseDexDataSize ||
+      data_size > std::numeric_limits<uintptr_t>::max() - data_start) {
+    R0DumpLog(
+        ANDROID_LOG_WARN,
+        "dexdata sparse skipped reason=invalid_range strategy=%s dataBegin=%p dataSize=%zu max=%zu",
+        R0DumpStrategyName(strategy),
+        data_begin,
+        data_size,
+        kR0DumpMaxSparseDexDataSize);
+    return false;
+  }
+  const uintptr_t data_end = data_start + data_size;
+  const std::string file_name = R0DumpDexDataSparseFileName(dex_file, data_size, strategy);
+  if (!file_name_reserved && !R0DumpReserveDexFileName(file_name)) {
+    return true;
+  }
+  const std::string path = out_dir + "/" + file_name;
+  // The process-local file-name reservation above prevents duplicate writes in
+  // one run.  Rewrite the filesystem path here so stale FUSE/MediaStore names
+  // from a previous deleted export do not suppress the actual dexdata artifact.
+  unlink(path.c_str());
+  int fd = open(path.c_str(), O_CREAT | O_TRUNC | O_WRONLY | O_CLOEXEC, 0660);
+  if (fd < 0) {
+    R0DumpLog(ANDROID_LOG_WARN,
+              "dexdata sparse open failed path=%s errno=%d(%s)",
+              path.c_str(),
+              errno,
+              strerror(errno));
+    R0DumpForgetDexFileName(file_name);
+    return false;
+  }
+
+  if (data_size != 0u) {
+    const char zero = '\0';
+    if (!R0DumpWriteAllAt(fd, &zero, 1u, static_cast<off_t>(data_size - 1u))) {
+      R0DumpLog(
+          ANDROID_LOG_WARN, "dexdata sparse size set failed path=%s errno=%d", path.c_str(), errno);
+      close(fd);
+      unlink(path.c_str());
+      R0DumpForgetDexFileName(file_name);
+      return false;
+    }
+  }
+
+  FILE* maps = fopen("/proc/self/maps", "re");
+  if (maps == nullptr) {
+    close(fd);
+    R0DumpLog(
+        ANDROID_LOG_WARN, "dexdata sparse maps open failed path=%s errno=%d", path.c_str(), errno);
+    unlink(path.c_str());
+    R0DumpForgetDexFileName(file_name);
+    return false;
+  }
+  uint64_t segments = 0u;
+  uint64_t bytes_written = 0u;
+  char line[512];
+  while (fgets(line, sizeof(line), maps) != nullptr) {
+    unsigned long long map_start_raw = 0;
+    unsigned long long map_end_raw = 0;
+    char perms[5] = {};
+    if (sscanf(line, "%llx-%llx %4s", &map_start_raw, &map_end_raw, perms) != 3) {
+      continue;
+    }
+    if (perms[0] != 'r') {
+      continue;
+    }
+    const uintptr_t map_start = static_cast<uintptr_t>(map_start_raw);
+    const uintptr_t map_end = static_cast<uintptr_t>(map_end_raw);
+    if (map_end <= data_start || map_start >= data_end) {
+      continue;
+    }
+    const uintptr_t copy_start = std::max(map_start, data_start);
+    const uintptr_t copy_end = std::min(map_end, data_end);
+    if (copy_end <= copy_start) {
+      continue;
+    }
+    const size_t copy_len = static_cast<size_t>(copy_end - copy_start);
+    const off_t copy_off = static_cast<off_t>(copy_start - data_start);
+    if (!R0DumpWriteAllAt(fd, reinterpret_cast<const void*>(copy_start), copy_len, copy_off)) {
+      R0DumpLog(ANDROID_LOG_WARN,
+                "dexdata sparse segment write failed path=%s offset=%lld len=%zu errno=%d",
+                path.c_str(),
+                static_cast<long long>(copy_off),
+                copy_len,
+                errno);
+      fclose(maps);
+      close(fd);
+      unlink(path.c_str());
+      R0DumpForgetDexFileName(file_name);
+      return false;
+    }
+    segments++;
+    bytes_written += copy_len;
+  }
+  fclose(maps);
+  fsync(fd);
+  close(fd);
+  {
+    std::lock_guard<std::mutex> lock(gR0DumpStateMutex);
+    gR0DumpDexDataFilesWritten++;
+  }
+  R0DumpLog(ANDROID_LOG_INFO,
+            "dexdata sparse dumped strategy=%s dataBegin=%p dataSize=%zu segments=%llu bytes=%llu "
+            "path=%s",
+            R0DumpStrategyName(strategy),
+            data_begin,
+            data_size,
+            static_cast<unsigned long long>(segments),
+            static_cast<unsigned long long>(bytes_written),
+            path.c_str());
+  return true;
+}
