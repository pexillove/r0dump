+static const DexFile* R0DumpResolveDexFile(ArtMethod* artmethod, const DexFile* fallback_dex_file)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  if (artmethod == nullptr || artmethod->IsRuntimeMethod()) {
+    return nullptr;
+  }
+  // Java reflection based class-walk already knows the DexFile cookie that
+  // produced the class name being walked. Prefer that cookie over ArtMethod's
+  // own dex pointer because packed/rewritten classes on Android 16 can expose
+  // copied/obsolete ArtMethods whose GetDexFile() is empty even though the
+  // ClassLoader cookie still points at the decoded dex memory.
+  if (R0DumpIsDexFileUsable(fallback_dex_file)) {
+    return fallback_dex_file;
+  }
+  const DexFile* dex_file = artmethod->GetDexFile();
+  if (R0DumpIsDexFileUsable(dex_file)) {
+    return dex_file;
+  }
+  if (artmethod->IsCopied()) {
+    ArtMethod* canonical = artmethod->GetCanonicalMethod(kRuntimePointerSize);
+    if (canonical != nullptr && canonical != artmethod && !canonical->IsRuntimeMethod()) {
+      dex_file = canonical->GetDexFile();
+      if (R0DumpIsDexFileUsable(dex_file)) {
+        return dex_file;
+      }
+    }
+  }
+  ArtMethod* non_obsolete = artmethod->GetNonObsoleteMethod();
+  if (non_obsolete != nullptr && non_obsolete != artmethod && !non_obsolete->IsRuntimeMethod()) {
+    dex_file = non_obsolete->GetDexFile();
+    if (R0DumpIsDexFileUsable(dex_file)) {
+      return dex_file;
+    }
+  }
+  if (R0DumpIsDexFileUsable(fallback_dex_file)) {
+    return fallback_dex_file;
+  }
