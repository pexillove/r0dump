+static std::string R0DumpBase64Encode(const uint8_t* data, size_t size) {
+  static constexpr char kBase64[] =
+      "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+  std::string out;
+  out.reserve(((size + 2u) / 3u) * 4u);
+  for (size_t i = 0; i < size; i += 3u) {
+    const uint32_t b0 = data[i];
+    const uint32_t b1 = (i + 1u < size) ? data[i + 1u] : 0u;
+    const uint32_t b2 = (i + 2u < size) ? data[i + 2u] : 0u;
+    out.push_back(kBase64[(b0 >> 2) & 0x3f]);
+    out.push_back(kBase64[((b0 & 0x03) << 4) | ((b1 >> 4) & 0x0f)]);
+    out.push_back((i + 1u < size) ? kBase64[((b1 & 0x0f) << 2) | ((b2 >> 6) & 0x03)] : '=');
+    out.push_back((i + 2u < size) ? kBase64[b2 & 0x3f] : '=');
+  }
+  return out;
+}
