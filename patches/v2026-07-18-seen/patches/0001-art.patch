+  const std::string art_map =
+      R0DumpMapLineForAddress(art_dex_file != nullptr ? art_dex_file->Begin() : nullptr);
+  const std::string fallback_map =
+      R0DumpMapLineForAddress(fallback_dex_file != nullptr ? fallback_dex_file->Begin() : nullptr);
