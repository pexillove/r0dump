+extern "C" void dumpR0DumpDexFile(const DexFile* dex_file, const char*) {
+  if (!isR0DumpStrategyEnabled(kR0DumpStrategyDexLoad)) {
+    return;
+  }
+  R0DumpDumpDexFile(dex_file, kR0DumpStrategyDexLoad);
+}
