+static bool R0DumpDeleteTree(const std::string& path,
+                             uint64_t* deleted,
+                             uint64_t* failed,
+                             int depth) {
+  if (path.empty() || depth > 32) {
+    if (failed != nullptr) {
+      (*failed)++;
+    }
+    return false;
+  }
+  struct stat st = {};
+  if (lstat(path.c_str(), &st) != 0) {
+    if (errno == ENOENT) {
+      return true;
+    }
+    if (failed != nullptr) {
+      (*failed)++;
+    }
+    return false;
+  }
+  if (S_ISDIR(st.st_mode)) {
+    DIR* dir = opendir(path.c_str());
+    if (dir == nullptr) {
+      if (failed != nullptr) {
+        (*failed)++;
+      }
+      return false;
+    }
+    while (dirent* entry = readdir(dir)) {
+      if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0) {
+        continue;
+      }
+      R0DumpDeleteTree(path + "/" + entry->d_name, deleted, failed, depth + 1);
+    }
+    closedir(dir);
+    if (rmdir(path.c_str()) == 0) {
+      if (deleted != nullptr) {
+        (*deleted)++;
+      }
+      return true;
+    }
+    if (errno != ENOENT && failed != nullptr) {
+      (*failed)++;
+    }
+    return errno == ENOENT;
+  }
+  if (unlink(path.c_str()) == 0) {
+    if (deleted != nullptr) {
+      (*deleted)++;
+    }
+    return true;
+  }
+  if (errno != ENOENT && failed != nullptr) {
+    (*failed)++;
+  }
+  return errno == ENOENT;
+}
