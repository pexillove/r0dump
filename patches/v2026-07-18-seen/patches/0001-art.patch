+static void R0DumpClearOutputDirForNewRun(const std::string& out_dir) {
+  if (!R0DumpIsSafeOutputDirForCleanup(out_dir)) {
+    R0DumpLog(ANDROID_LOG_WARN, "output cleanup skipped unsafe path=%s", out_dir.c_str());
+    return;
+  }
+  DIR* dir = opendir(out_dir.c_str());
+  if (dir == nullptr) {
+    if (errno != ENOENT) {
+      R0DumpLog(ANDROID_LOG_WARN,
+                "output cleanup open failed path=%s errno=%d(%s)",
+                out_dir.c_str(),
+                errno,
+                strerror(errno));
+    }
+    return;
+  }
+  uint64_t deleted = 0u;
+  uint64_t failed = 0u;
+  while (dirent* entry = readdir(dir)) {
+    if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0) {
+      continue;
+    }
+    if (strcmp(entry->d_name, "r0dump_status.json") == 0 ||
+        strcmp(entry->d_name, "_r0dump_status.json") == 0) {
+      R0DumpLog(ANDROID_LOG_INFO,
+                "output cleanup preserving status file path=%s/%s",
+                out_dir.c_str(),
+                entry->d_name);
+      continue;
+    }
+    R0DumpDeleteTree(out_dir + "/" + entry->d_name, &deleted, &failed, 0);
+  }
+  closedir(dir);
+  R0DumpLog(ANDROID_LOG_INFO,
+            "output cleanup complete path=%s deleted=%llu failed=%llu",
+            out_dir.c_str(),
+            static_cast<unsigned long long>(deleted),
+            static_cast<unsigned long long>(failed));
+}
