+extern "C" void dumpR0DumpDexFileByStrategy(const DexFile* dex_file,
+                                            const char*,
+                                            uint32_t strategy) {
+  if (!isR0DumpStrategyEnabled(strategy)) {
+    return;
+  }
+  R0DumpDumpDexFile(dex_file, strategy);
+}
+
+extern "C" void dumpR0DumpRawBufferByStrategy(const uint8_t* data,
+                                              size_t size,
+                                              const char* suffix,
+                                              uint32_t strategy) {
+  if (!gR0DumpRuntimeEnabled || !isR0DumpStrategyEnabled(strategy) || R0DumpShouldStopForLimit()) {
+    return;
+  }
+  static constexpr size_t kR0DumpMaxRawBufferDexSize = 512u * 1024u * 1024u;
+  if (data == nullptr || size < sizeof(StandardDexFile::Header) ||
+      size > kR0DumpMaxRawBufferDexSize ||
+      !R0DumpIsReadableMemoryRange(data, std::min(size, sizeof(StandardDexFile::Header)))) {
+    return;
+  }
+  if (!StandardDexFile::IsMagicValid(data)) {
+    R0DumpLog(ANDROID_LOG_DEBUG,
+              "raw buffer skipped invalid magic strategy=%s suffix=%s size=%zu prefix=%s",
+              R0DumpStrategyName(strategy),
+              suffix != nullptr ? suffix : "",
+              size,
+              R0DumpHexPrefix(data, 16u).c_str());
+    return;
+  }
+
+  uint32_t checksum = 0u;
+  memcpy(&checksum, data + 8u, sizeof(checksum));
+  const size_t hash_size = std::min(size, static_cast<size_t>(1024u * 1024u));
+  const std::string content_hash = R0DumpHashHex(R0DumpFnv1a64(data, hash_size));
+  const std::string safe_suffix = R0DumpSanitizePathComponent(suffix != nullptr ? suffix : "raw");
+  const std::string file_name = android::base::StringPrintf("dexbuf_%s_%zu_0x%08x_%s_%s%s.dex",
+                                                            content_hash.c_str(),
+                                                            size,
+                                                            checksum,
+                                                            R0DumpStrategyName(strategy),
+                                                            safe_suffix.c_str(),
+                                                            gR0DumpRunFileSuffix.c_str());
+  if (!R0DumpReserveDexFileName(file_name)) {
+    R0DumpLog(ANDROID_LOG_DEBUG,
+              "raw buffer duplicate skipped strategy=%s file=%s",
+              R0DumpStrategyName(strategy),
+              file_name.c_str());
+    return;
+  }
+
+  const std::string process_component = R0DumpSanitizePathComponent(R0DumpReadCmdline());
+  if (R0DumpShouldUseMediaStoreDownloads() &&
+      R0DumpWriteDexViaMediaStore(process_component, file_name, data, size)) {
+    {
+      std::lock_guard<std::mutex> lock(gR0DumpStateMutex);
+      gR0DumpDexFilesWritten++;
+      gR0DumpByStrategy[R0DumpStrategyName(strategy)]++;
+    }
+    R0DumpLog(ANDROID_LOG_INFO,
+              "raw buffer dumped via MediaStore strategy=%s suffix=%s size=%zu checksum=0x%08x "
+              "path=Download/R0DUMP/%s/%s",
+              R0DumpStrategyName(strategy),
+              safe_suffix.c_str(),
+              size,
+              checksum,
+              process_component.c_str(),
+              file_name.c_str());
+    R0DumpWriteStatus(R0DumpOutputDir(), "dumping");
+    return;
+  }
+
+  std::string out_dir =
+      R0DumpShouldUseMediaStoreDownloads() ? R0DumpExternalAppOutputDir() : R0DumpOutputDir();
+  if (out_dir.empty()) {
+    out_dir = R0DumpOutputDir();
+  }
+  if (out_dir.empty()) {
+    R0DumpForgetDexFileName(file_name);
+    return;
+  }
+  const std::string path = out_dir + "/" + file_name;
+  int write_errno = 0;
+  if (R0DumpWriteFileIfAbsent(path, data, size, &write_errno)) {
+    {
+      std::lock_guard<std::mutex> lock(gR0DumpStateMutex);
+      gR0DumpDexFilesWritten++;
+      gR0DumpByStrategy[R0DumpStrategyName(strategy)]++;
+    }
+    R0DumpLog(ANDROID_LOG_INFO,
+              "raw buffer dumped strategy=%s suffix=%s size=%zu checksum=0x%08x path=%s",
+              R0DumpStrategyName(strategy),
+              safe_suffix.c_str(),
+              size,
+              checksum,
+              path.c_str());
+    R0DumpWriteStatus(out_dir, "dumping");
+  } else {
+    R0DumpForgetDexFileName(file_name);
+    R0DumpLog(ANDROID_LOG_WARN,
+              "raw buffer write failed strategy=%s suffix=%s size=%zu errno=%d(%s)",
+              R0DumpStrategyName(strategy),
+              safe_suffix.c_str(),
+              size,
+              write_errno,
+              strerror(write_errno));
+  }
+}
+
+static bool R0DumpAddressInRange(uintptr_t start, size_t size, uintptr_t address) {
+  return size != 0u && size <= std::numeric_limits<uintptr_t>::max() - start && address >= start &&
+         address < start + size;
+}
+
+static void R0DumpDumpNearbyDexCandidates(const std::string& out_dir,
+                                          const uint8_t* data_begin,
+                                          size_t data_size,
+                                          const uint8_t* code_item,
+                                          uint32_t strategy) {
+  if (out_dir.empty() || data_begin == nullptr || data_size == 0u || R0DumpShouldStopForLimit()) {
+    return;
+  }
+
+  // Some Android 16 protectors hand ART a DexFile whose Begin()/DataBegin()
+  // points at the decoded data section rather than at the real dex header.
+  // Do not alter DexFile layout.  Instead, once per observed data range, scan
+  // nearby readable memory for a normal dex header whose file_size covers the
+  // method's code item, then dump that original in-memory dex image.
+  const std::string probe_key =
+      android::base::StringPrintf("dexscan_probe_%p_%zu", data_begin, data_size);
+  if (!R0DumpReserveDexFileName(probe_key)) {
+    return;
+  }
+
+  static constexpr size_t kScanBeforeBytes = 64u * 1024u * 1024u;
+  static constexpr size_t kScanAfterBytes = 8u * 1024u * 1024u;
+  static constexpr size_t kMaxSegmentScanBytes = 96u * 1024u * 1024u;
+  const uintptr_t data_start = reinterpret_cast<uintptr_t>(data_begin);
+  const uintptr_t code_addr = reinterpret_cast<uintptr_t>(code_item);
+  const uintptr_t cover_addr = code_item != nullptr ? code_addr : data_start;
+  const uintptr_t window_start = data_start > kScanBeforeBytes ? data_start - kScanBeforeBytes : 0u;
+  uintptr_t window_end = data_start;
+  if (kScanAfterBytes > std::numeric_limits<uintptr_t>::max() - window_end) {
+    window_end = std::numeric_limits<uintptr_t>::max();
+  } else {
+    window_end += kScanAfterBytes;
+  }
+  if (code_addr > window_end) {
+    window_end = code_addr;
+  }
+  if (window_end != std::numeric_limits<uintptr_t>::max()) {
+    window_end++;
+  }
+
+  FILE* maps = fopen("/proc/self/maps", "re");
+  if (maps == nullptr) {
+    R0DumpLog(ANDROID_LOG_WARN,
+              "nearby dex scan maps open failed strategy=%s dataBegin=%p dataSize=%zu errno=%d(%s)",
+              R0DumpStrategyName(strategy),
+              data_begin,
+              data_size,
+              errno,
+              strerror(errno));
+    return;
+  }
+
+  uint64_t maps_scanned = 0u;
+  uint64_t bytes_scanned = 0u;
+  uint64_t candidates = 0u;
+  uint64_t dumped = 0u;
+  char line[512];
+  while (fgets(line, sizeof(line), maps) != nullptr) {
+    unsigned long long map_start_raw = 0;
+    unsigned long long map_end_raw = 0;
+    char perms[5] = {};
+    if (sscanf(line, "%llx-%llx %4s", &map_start_raw, &map_end_raw, perms) != 3) {
+      continue;
+    }
+    if (perms[0] != 'r') {
+      continue;
+    }
+    const uintptr_t map_start = static_cast<uintptr_t>(map_start_raw);
+    const uintptr_t map_end = static_cast<uintptr_t>(map_end_raw);
+    if (map_end <= window_start || map_start >= window_end || map_end <= map_start) {
+      continue;
+    }
+    const uintptr_t scan_start = std::max(map_start, window_start);
+    uintptr_t scan_end = std::min(map_end, window_end);
+    if (scan_end <= scan_start) {
+      continue;
+    }
+    if (scan_end - scan_start > kMaxSegmentScanBytes) {
+      scan_end = scan_start + kMaxSegmentScanBytes;
+    }
+    maps_scanned++;
+    bytes_scanned += static_cast<uint64_t>(scan_end - scan_start);
+
+    const uint8_t* scan = reinterpret_cast<const uint8_t*>(scan_start);
+    const uint8_t* end = reinterpret_cast<const uint8_t*>(scan_end);
+    for (const uint8_t* cursor = scan; cursor + sizeof(DexFile::Header) <= end; ++cursor) {
+      if (cursor[0] != 'd') {
+        continue;
+      }
+      if (!StandardDexFile::IsMagicValid(cursor)) {
+        continue;
+      }
+      const size_t file_size = R0DumpDexHeaderFileSizeFromBytes(cursor);
+      if (file_size == 0u) {
+        continue;
+      }
+      const uintptr_t candidate_start = reinterpret_cast<uintptr_t>(cursor);
+      if (!R0DumpAddressInRange(candidate_start, file_size, data_start) ||
+          !R0DumpAddressInRange(candidate_start, file_size, cover_addr)) {
+        continue;
+      }
+      candidates++;
+      if (!R0DumpIsReadableMemoryRange(cursor, file_size)) {
+        R0DumpLog(ANDROID_LOG_DEBUG,
+                  "nearby dex candidate skipped unreadable strategy=%s begin=%p size=%zu "
+                  "dataBegin=%p codeItem=%p",
+                  R0DumpStrategyName(strategy),
+                  cursor,
+                  file_size,
+                  data_begin,
+                  code_item);
+        continue;
+      }
+      dumpR0DumpRawBufferByStrategy(cursor, file_size, "nearby_dex", strategy);
+      dumped++;
+    }
+  }
+  fclose(maps);
+  R0DumpLog(ANDROID_LOG_INFO,
+            "nearby dex scan strategy=%s dataBegin=%p dataSize=%zu codeItem=%p maps=%llu "
+            "bytes=%llu candidates=%llu dumped=%llu",
+            R0DumpStrategyName(strategy),
+            data_begin,
+            data_size,
+            code_item,
+            static_cast<unsigned long long>(maps_scanned),
+            static_cast<unsigned long long>(bytes_scanned),
+            static_cast<unsigned long long>(candidates),
+            static_cast<unsigned long long>(dumped));
+}
+
+static uint32_t R0DumpAlign4(uint32_t value) { return (value + 3u) & ~3u; }
+
+static bool R0DumpCheckedAddU32(uint32_t lhs, uint64_t rhs, uint32_t* out) {
+  if (out == nullptr || rhs > std::numeric_limits<uint32_t>::max() ||
+      lhs > std::numeric_limits<uint32_t>::max() - static_cast<uint32_t>(rhs)) {
+    return false;
+  }
+  *out = lhs + static_cast<uint32_t>(rhs);
+  return true;
+}
+
+static bool R0DumpReadUleb128Bounded(const uint8_t** cursor, const uint8_t* end, uint32_t* out) {
+  if (cursor == nullptr || *cursor == nullptr || out == nullptr || *cursor >= end) {
+    return false;
+  }
+  const uint8_t* ptr = *cursor;
+  uint32_t value = 0u;
+  uint32_t shift = 0u;
+  for (uint32_t i = 0u; i < 5u; ++i) {
+    if (ptr >= end || !R0DumpIsReadableMemoryRange(ptr, 1u)) {
+      return false;
+    }
+    const uint8_t byte = *ptr++;
+    value |= static_cast<uint32_t>(byte & 0x7fu) << shift;
+    if ((byte & 0x80u) == 0u) {
+      *cursor = ptr;
+      *out = value;
+      return true;
+    }
+    shift += 7u;
+  }
+  return false;
+}
+
+struct R0DumpDexReconPlan {
+  uint32_t file_size = 0u;
+  uint32_t string_ids_size = 0u;
+  uint32_t type_ids_size = 0u;
+  uint32_t proto_ids_size = 0u;
+  uint32_t field_ids_size = 0u;
+  uint32_t method_ids_size = 0u;
+  uint32_t class_defs_size = 0u;
+  uint32_t string_ids_off = 0u;
+  uint32_t type_ids_off = 0u;
+  uint32_t proto_ids_off = 0u;
+  uint32_t field_ids_off = 0u;
+  uint32_t method_ids_off = 0u;
+  uint32_t class_defs_off = 0u;
+  uint32_t map_off = 0u;
+  uint32_t data_off = 0u;
+  uint64_t readable_data_bytes = 0u;
+  bool changed = false;
+  std::string reason;
+  std::vector<uint32_t> class_def_indices;
+};
+
+static bool R0DumpReconBumpCount(uint32_t index,
+                                 uint32_t* count,
+                                 uint32_t max_count,
+                                 const char* label,
+                                 R0DumpDexReconPlan* plan) {
+  if (count == nullptr || plan == nullptr || index == DexFile::kDexNoIndex32) {
+    return true;
+  }
+  if (index >= max_count) {
+    plan->reason = android::base::StringPrintf(
+        "%s_index_too_large_%u_max_%u", label != nullptr ? label : "item", index, max_count);
+    return false;
+  }
+  if (*count <= index) {
+    *count = index + 1u;
+    plan->changed = true;
+  }
+  return true;
+}
+
+static bool R0DumpReconBumpTypeIndex(dex::TypeIndex index, R0DumpDexReconPlan* plan) {
+  if (!index.IsValid()) {
+    return true;
+  }
+  return R0DumpReconBumpCount(
+      index.index_, &plan->type_ids_size, DexFile::kDexNoIndex16, "type", plan);
+}
+
+static bool R0DumpReconBumpProtoIndex(dex::ProtoIndex index, R0DumpDexReconPlan* plan) {
+  if (!index.IsValid()) {
+    return true;
+  }
+  return R0DumpReconBumpCount(
+      index.index_, &plan->proto_ids_size, DexFile::kDexNoIndex16, "proto", plan);
+}
+
+static bool R0DumpReconBumpStringIndex(dex::StringIndex index, R0DumpDexReconPlan* plan) {
+  static constexpr uint32_t kMaxReconStringIds = 2u * 1000u * 1000u;
+  if (!index.IsValid()) {
+    return true;
+  }
+  return R0DumpReconBumpCount(
+      index.index_, &plan->string_ids_size, kMaxReconStringIds, "string", plan);
+}
+
+static bool R0DumpReconScanTypeList(const DexFile* dex_file,
+                                    uint32_t type_list_off,
+                                    R0DumpDexReconPlan* plan) {
+  if (dex_file == nullptr || plan == nullptr || type_list_off == 0u) {
+    return true;
+  }
+  const uint8_t* data_begin = dex_file->DataBegin();
+  const size_t data_size = dex_file->DataSize();
+  if (data_begin == nullptr || type_list_off > data_size ||
+      data_size - type_list_off < sizeof(uint32_t)) {
+    return true;
+  }
+  const uint8_t* list_begin = data_begin + type_list_off;
+  if (!R0DumpIsReadableMemoryRange(list_begin, sizeof(uint32_t))) {
+    return true;
+  }
+  uint32_t count = 0u;
+  memcpy(&count, list_begin, sizeof(count));
+  static constexpr uint32_t kMaxReconTypeListItems = 8192u;
+  if (count > kMaxReconTypeListItems ||
+      data_size - type_list_off < dex::TypeList::GetListSize(count) ||
+      !R0DumpIsReadableMemoryRange(list_begin, dex::TypeList::GetListSize(count))) {
+    return true;
+  }
+  const dex::TypeList* type_list = reinterpret_cast<const dex::TypeList*>(list_begin);
+  for (uint32_t i = 0u; i < count; ++i) {
+    if (!R0DumpReconBumpTypeIndex(type_list->GetTypeItem(i).type_idx_, plan)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+static bool R0DumpReconScanClassData(const DexFile* dex_file,
+                                     const dex::ClassDef& class_def,
+                                     R0DumpDexReconPlan* plan) {
+  if (dex_file == nullptr || plan == nullptr || class_def.class_data_off_ == 0u) {
+    return true;
+  }
+  const uint8_t* data_begin = dex_file->DataBegin();
+  const size_t data_size = dex_file->DataSize();
+  if (data_begin == nullptr || class_def.class_data_off_ >= data_size) {
+    return true;
+  }
+  const uint8_t* ptr = data_begin + class_def.class_data_off_;
+  const uint8_t* end = data_begin + data_size;
+  uint32_t static_fields = 0u;
+  uint32_t instance_fields = 0u;
+  uint32_t direct_methods = 0u;
+  uint32_t virtual_methods = 0u;
+  if (!R0DumpReadUleb128Bounded(&ptr, end, &static_fields) ||
+      !R0DumpReadUleb128Bounded(&ptr, end, &instance_fields) ||
+      !R0DumpReadUleb128Bounded(&ptr, end, &direct_methods) ||
+      !R0DumpReadUleb128Bounded(&ptr, end, &virtual_methods)) {
+    return true;
+  }
+  static constexpr uint32_t kMaxReconClassMembers = 20000u;
+  if (static_fields > kMaxReconClassMembers || instance_fields > kMaxReconClassMembers ||
+      direct_methods > kMaxReconClassMembers || virtual_methods > kMaxReconClassMembers ||
+      static_fields + instance_fields > kMaxReconClassMembers ||
+      direct_methods + virtual_methods > kMaxReconClassMembers) {
+    return true;
+  }
+
+  uint32_t field_idx = 0u;
+  const uint32_t total_fields = static_fields + instance_fields;
+  for (uint32_t i = 0u; i < total_fields; ++i) {
+    uint32_t diff = 0u;
+    uint32_t access_flags = 0u;
+    if (!R0DumpReadUleb128Bounded(&ptr, end, &diff) ||
+        !R0DumpReadUleb128Bounded(&ptr, end, &access_flags)) {
+      return true;
+    }
+    (void)access_flags;
+    if (diff > std::numeric_limits<uint32_t>::max() - field_idx) {
+      return true;
+    }
+    field_idx += diff;
+    if (!R0DumpReconBumpCount(field_idx, &plan->field_ids_size, 1000u * 1000u, "field", plan)) {
+      return false;
+    }
+  }
+
+  uint32_t method_idx = 0u;
+  const uint32_t total_methods = direct_methods + virtual_methods;
+  for (uint32_t i = 0u; i < total_methods; ++i) {
+    uint32_t diff = 0u;
+    uint32_t access_flags = 0u;
+    uint32_t code_off = 0u;
+    if (!R0DumpReadUleb128Bounded(&ptr, end, &diff) ||
+        !R0DumpReadUleb128Bounded(&ptr, end, &access_flags) ||
+        !R0DumpReadUleb128Bounded(&ptr, end, &code_off)) {
+      return true;
+    }
+    (void)access_flags;
+    (void)code_off;
+    if (diff > std::numeric_limits<uint32_t>::max() - method_idx) {
+      return true;
+    }
+    method_idx += diff;
+    if (!R0DumpReconBumpCount(method_idx, &plan->method_ids_size, 1000u * 1000u, "method", plan)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+template <typename T>
+static const T* R0DumpReconReadableArrayStart(const T& first_item,
+                                              uint32_t count,
+                                              const char* label,
+                                              R0DumpDexReconPlan* plan) {
+  const T* ptr = &first_item;
+  const uint64_t bytes = static_cast<uint64_t>(count) * sizeof(T);
+  if (count != 0u && (bytes > std::numeric_limits<size_t>::max() ||
+                      !R0DumpIsReadableMemoryRange(ptr, static_cast<size_t>(bytes)))) {
+    if (plan != nullptr) {
+      plan->reason = android::base::StringPrintf(
+          "%s_array_unreadable_count_%u", label != nullptr ? label : "section", count);
+    }
+    return nullptr;
+  }
+  return ptr;
+}
+
+static bool R0DumpBuildDexReconPlan(const DexFile* dex_file,
+                                    const R0DumpDexReconState& state,
+                                    R0DumpDexReconPlan* plan) {
+  if (dex_file == nullptr || plan == nullptr || state.data_begin == nullptr ||
+      state.data_size < sizeof(DexFile::Header) || state.data_size > 512u * 1024u * 1024u ||
+      !state.has_method || !state.has_class_def) {
+    if (plan != nullptr) {
+      plan->reason = "missing_seed";
+    }
+    return false;
+  }
+
+  plan->file_size = static_cast<uint32_t>(state.data_size);
+  plan->method_ids_size = state.max_method_idx + 1u;
+  plan->class_def_indices.assign(state.class_def_indices.begin(), state.class_def_indices.end());
+  plan->class_defs_size = static_cast<uint32_t>(plan->class_def_indices.size());
+  if (plan->class_defs_size == 0u) {
+    plan->reason = "missing_class_def_seed";
+    return false;
+  }
+
+  for (uint32_t iteration = 0u; iteration < 8u; ++iteration) {
+    plan->changed = false;
+
+    if (plan->method_ids_size != 0u) {
+      const dex::MethodId* methods = R0DumpReconReadableArrayStart(
+          dex_file->GetMethodId(0u), plan->method_ids_size, "method_ids", plan);
+      if (methods == nullptr) {
+        return false;
+      }
+      for (uint32_t i = 0u; i < plan->method_ids_size; ++i) {
+        if (!R0DumpReconBumpTypeIndex(methods[i].class_idx_, plan) ||
+            !R0DumpReconBumpProtoIndex(methods[i].proto_idx_, plan) ||
+            !R0DumpReconBumpStringIndex(methods[i].name_idx_, plan)) {
+          return false;
+        }
+      }
+    }
+
+    for (uint32_t class_def_idx : plan->class_def_indices) {
+      const dex::ClassDef& class_def = dex_file->GetClassDef(class_def_idx);
+      if (!R0DumpIsReadableMemoryRange(&class_def, sizeof(class_def))) {
+        plan->reason = android::base::StringPrintf("class_def_unreadable_idx_%u", class_def_idx);
+        return false;
+      }
+      if (!R0DumpReconBumpTypeIndex(class_def.class_idx_, plan) ||
+          !R0DumpReconBumpTypeIndex(class_def.superclass_idx_, plan) ||
+          !R0DumpReconBumpStringIndex(class_def.source_file_idx_, plan) ||
+          !R0DumpReconScanTypeList(dex_file, class_def.interfaces_off_, plan) ||
+          !R0DumpReconScanClassData(dex_file, class_def, plan)) {
+        return false;
+      }
+    }
+
+    if (plan->field_ids_size != 0u) {
+      const dex::FieldId* fields = R0DumpReconReadableArrayStart(
+          dex_file->GetFieldId(0u), plan->field_ids_size, "field_ids", plan);
+      if (fields == nullptr) {
+        return false;
+      }
+      for (uint32_t i = 0u; i < plan->field_ids_size; ++i) {
+        if (!R0DumpReconBumpTypeIndex(fields[i].class_idx_, plan) ||
+            !R0DumpReconBumpTypeIndex(fields[i].type_idx_, plan) ||
+            !R0DumpReconBumpStringIndex(fields[i].name_idx_, plan)) {
+          return false;
+        }
+      }
+    }
+
+    if (plan->proto_ids_size != 0u) {
+      const dex::ProtoId* protos = R0DumpReconReadableArrayStart(
+          dex_file->GetProtoId(dex::ProtoIndex(0u)), plan->proto_ids_size, "proto_ids", plan);
+      if (protos == nullptr) {
+        return false;
+      }
+      for (uint32_t i = 0u; i < plan->proto_ids_size; ++i) {
+        if (!R0DumpReconBumpStringIndex(protos[i].shorty_idx_, plan) ||
+            !R0DumpReconBumpTypeIndex(protos[i].return_type_idx_, plan) ||
+            !R0DumpReconScanTypeList(dex_file, protos[i].parameters_off_, plan)) {
+          return false;
+        }
+      }
+    }
+
+    if (plan->type_ids_size != 0u) {
+      const dex::TypeId* types = R0DumpReconReadableArrayStart(
+          dex_file->GetTypeId(dex::TypeIndex(0u)), plan->type_ids_size, "type_ids", plan);
+      if (types == nullptr) {
+        return false;
+      }
+      for (uint32_t i = 0u; i < plan->type_ids_size; ++i) {
+        if (!R0DumpReconBumpStringIndex(types[i].descriptor_idx_, plan)) {
+          return false;
+        }
+      }
+    }
+
+    if (!plan->changed) {
+      break;
+    }
+  }
+
+  uint32_t offset = sizeof(DexFile::Header);
+  plan->string_ids_off = offset;
+  if (!R0DumpCheckedAddU32(
+          offset, static_cast<uint64_t>(plan->string_ids_size) * sizeof(dex::StringId), &offset)) {
+    plan->reason = "string_section_overflow";
+    return false;
+  }
+  offset = R0DumpAlign4(offset);
+  plan->type_ids_off = offset;
+  if (!R0DumpCheckedAddU32(
+          offset, static_cast<uint64_t>(plan->type_ids_size) * sizeof(dex::TypeId), &offset)) {
+    plan->reason = "type_section_overflow";
+    return false;
+  }
+  offset = R0DumpAlign4(offset);
+  plan->proto_ids_off = offset;
+  if (!R0DumpCheckedAddU32(
+          offset, static_cast<uint64_t>(plan->proto_ids_size) * sizeof(dex::ProtoId), &offset)) {
+    plan->reason = "proto_section_overflow";
+    return false;
+  }
+  offset = R0DumpAlign4(offset);
+  plan->field_ids_off = offset;
+  if (!R0DumpCheckedAddU32(
+          offset, static_cast<uint64_t>(plan->field_ids_size) * sizeof(dex::FieldId), &offset)) {
+    plan->reason = "field_section_overflow";
+    return false;
+  }
+  offset = R0DumpAlign4(offset);
+  plan->method_ids_off = offset;
+  if (!R0DumpCheckedAddU32(
+          offset, static_cast<uint64_t>(plan->method_ids_size) * sizeof(dex::MethodId), &offset)) {
+    plan->reason = "method_section_overflow";
+    return false;
+  }
+  offset = R0DumpAlign4(offset);
+  plan->class_defs_off = offset;
+  if (!R0DumpCheckedAddU32(
+          offset, static_cast<uint64_t>(plan->class_defs_size) * sizeof(dex::ClassDef), &offset)) {
+    plan->reason = "class_def_section_overflow";
+    return false;
+  }
+  offset = R0DumpAlign4(offset);
+  static constexpr uint32_t kReconMapItems = 8u;
+  const uint32_t map_size = sizeof(uint32_t) + kReconMapItems * sizeof(dex::MapItem);
+  plan->map_off = offset;
+  if (!R0DumpCheckedAddU32(offset, map_size, &offset)) {
+    plan->reason = "map_section_overflow";
+    return false;
+  }
+  plan->data_off = R0DumpAlign4(offset);
+  if (plan->data_off >= plan->file_size) {
+    plan->reason = android::base::StringPrintf(
+        "sections_exceed_file_size_sections_%u_file_%u", plan->data_off, plan->file_size);
+    return false;
+  }
+  return true;
+}
+
+[[maybe_unused]] static uint64_t R0DumpCopyReadableDataRangeToImage(std::vector<uint8_t>* image,
+                                                                    const uint8_t* data_begin,
+                                                                    size_t data_size) {
+  if (image == nullptr || image->empty() || data_begin == nullptr || data_size == 0u) {
+    return 0u;
+  }
+  const uintptr_t data_start = reinterpret_cast<uintptr_t>(data_begin);
+  if (data_size > std::numeric_limits<uintptr_t>::max() - data_start) {
+    return 0u;
+  }
+  const uintptr_t data_end = data_start + data_size;
+  FILE* maps = fopen("/proc/self/maps", "re");
+  if (maps == nullptr) {
+    return 0u;
+  }
+  uint64_t bytes_copied = 0u;
+  char line[512];
+  while (fgets(line, sizeof(line), maps) != nullptr) {
+    unsigned long long map_start_raw = 0;
+    unsigned long long map_end_raw = 0;
+    char perms[5] = {};
+    if (sscanf(line, "%llx-%llx %4s", &map_start_raw, &map_end_raw, perms) != 3 ||
+        perms[0] != 'r') {
+      continue;
+    }
+    const uintptr_t map_start = static_cast<uintptr_t>(map_start_raw);
+    const uintptr_t map_end = static_cast<uintptr_t>(map_end_raw);
+    if (map_end <= data_start || map_start >= data_end || map_end <= map_start) {
+      continue;
+    }
+    const uintptr_t copy_start = std::max(map_start, data_start);
+    const uintptr_t copy_end = std::min(map_end, data_end);
+    if (copy_end <= copy_start) {
+      continue;
+    }
+    const size_t copy_len = static_cast<size_t>(copy_end - copy_start);
+    const size_t copy_off = static_cast<size_t>(copy_start - data_start);
+    if (copy_off < image->size() && copy_len <= image->size() - copy_off) {
+      memcpy(image->data() + copy_off, reinterpret_cast<const void*>(copy_start), copy_len);
+      bytes_copied += copy_len;
+    }
+  }
+  fclose(maps);
+  return bytes_copied;
+}
+
+template <typename T>
+[[maybe_unused]] static bool R0DumpReconOverlayArray(std::vector<uint8_t>* image,
+                                                     uint32_t offset,
+                                                     const T& first_item,
+                                                     uint32_t count,
+                                                     const char* label) {
+  if (count == 0u) {
+    return true;
+  }
+  const T* ptr = &first_item;
+  const uint64_t bytes64 = static_cast<uint64_t>(count) * sizeof(T);
+  if (image == nullptr || bytes64 > std::numeric_limits<size_t>::max() || offset > image->size() ||
+      static_cast<size_t>(bytes64) > image->size() - offset ||
+      !R0DumpIsReadableMemoryRange(ptr, static_cast<size_t>(bytes64))) {
+    R0DumpLog(ANDROID_LOG_WARN,
+              "dexrecon section overlay failed section=%s offset=%u count=%u bytes=%llu",
+              label != nullptr ? label : "unknown",
+              offset,
+              count,
+              static_cast<unsigned long long>(bytes64));
+    return false;
+  }
+  memcpy(image->data() + offset, ptr, static_cast<size_t>(bytes64));
+  return true;
+}
