+class R0DumpLoadedClassNameVisitor final : public ClassVisitor {
+ public:
+  R0DumpLoadedClassNameVisitor(Handle<mirror::ClassLoader> class_loader,
+                               std::set<std::string>* class_names)
+      : class_loader_(class_loader), class_names_(class_names) {}
+
+  bool operator()(ObjPtr<mirror::Class> klass) override REQUIRES_SHARED(Locks::mutator_lock_) {
+    if (klass == nullptr || klass->GetClassLoader() != class_loader_.Get()) {
+      return true;
+    }
+    if (klass->IsArrayClass() || klass->IsPrimitive()) {
+      return true;
+    }
+    std::string temp;
+    const char* descriptor = klass->GetDescriptor(&temp);
+    if (descriptor != nullptr && descriptor[0] == 'L') {
+      class_names_->insert(DescriptorToDot(descriptor));
+    }
+    return true;
+  }
+
+ private:
+  Handle<mirror::ClassLoader> class_loader_;
+  std::set<std::string>* const class_names_;
+};
