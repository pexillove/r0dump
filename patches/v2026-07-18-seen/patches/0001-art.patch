+static const DexFile* R0DumpSelectDexFileFromCookieForMethod(
+    const std::vector<const DexFile*>& dex_files, ArtMethod* artmethod,
+    const std::string& descriptor_hint)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  if (dex_files.empty()) {
+    return nullptr;
+  }
+  if (dex_files.size() == 1u) {
+    return dex_files.front();
+  }
+  std::string descriptor_storage = descriptor_hint;
+  if (!descriptor_storage.empty()) {
+    const size_t hash = ComputeModifiedUtf8Hash(descriptor_storage);
+    for (const DexFile* dex_file : dex_files) {
+      if (dex_file == nullptr) {
+        continue;
+      }
+      const dex::ClassDef* dex_class_def =
+          OatDexFile::FindClassDef(*dex_file, descriptor_storage, hash);
+      if (dex_class_def != nullptr) {
+        return dex_file;
+      }
+    }
+  }
+  if (artmethod == nullptr || artmethod->IsRuntimeMethod()) {
+    return dex_files.front();
+  }
+  ObjPtr<mirror::Class> declaring_class =
+      artmethod->GetDeclaringClass<kWithoutReadBarrier>();
+  if (declaring_class == nullptr ||
+      declaring_class->IsProxyClass() ||
+      declaring_class->IsArrayClass() ||
+      declaring_class->IsPrimitive()) {
+    return dex_files.front();
+  }
+  descriptor_storage.clear();
+  const char* descriptor = declaring_class->GetDescriptor(&descriptor_storage);
+  if (descriptor == nullptr || descriptor[0] == '\0') {
+    return dex_files.front();
+  }
+  const std::string descriptor_string(descriptor);
+  const size_t hash = ComputeModifiedUtf8Hash(descriptor_string);
+  for (const DexFile* dex_file : dex_files) {
+    if (dex_file == nullptr) {
+      continue;
+    }
+    const dex::ClassDef* dex_class_def =
+        OatDexFile::FindClassDef(*dex_file, descriptor_string, hash);
+    if (dex_class_def != nullptr) {
+      return dex_file;
+    }
+  }
+  return dex_files.front();
+}
