+static bool R0DumpIsSafeOutputDirForCleanup(const std::string& out_dir) {
+  if (out_dir.empty() || out_dir == "/" || out_dir.size() < 8u) {
+    return false;
+  }
+  // Only clean the per-target artifact directory that R0DUMP owns.  Never
+  // recurse arbitrary custom roots; the process component is appended by
+  // R0DumpOutputDir(), so a valid target contains one of these owned markers.
+  if (out_dir.find("/R0DUMP/") != std::string::npos ||
+      out_dir.find("/r0dump/") != std::string::npos) {
+    return true;
+  }
+  const std::string process_component = R0DumpSanitizePathComponent(R0DumpReadCmdline());
+  if (process_component.empty() || process_component.find('/') != std::string::npos ||
+      process_component == "." || process_component == "..") {
+    return false;
+  }
+  const std::string default_download = "/sdcard/Download/" + process_component;
+  const std::string emulated_download = "/storage/emulated/0/Download/" + process_component;
+  if (out_dir == default_download || out_dir == emulated_download) {
+    return true;
+  }
+  if (!gR0DumpConfiguredOutputRoot.empty() &&
+      (gR0DumpConfiguredOutputRoot == "/sdcard/Download" ||
+       gR0DumpConfiguredOutputRoot == "/storage/emulated/0/Download") &&
+      out_dir == gR0DumpConfiguredOutputRoot + "/" + process_component) {
+    return true;
+  }
+  return false;
+}
