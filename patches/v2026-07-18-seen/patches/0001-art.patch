+                  static_cast<unsigned long long>(gR0DumpMaxRecords),
+                  static_cast<unsigned long long>(gR0DumpMaxSeconds));
+      }
+    }
+  }
+  R0DumpWriteStatus(out_dir, gR0DumpRuntimeEnabled ? "dumping" : "stopped_by_limit");
+  return true;
+}
